#!/usr/bin/env sh
. "$(dirname "$0")/_/husky.sh"
changed=$(git diff --name-only HEAD @{push} 2>/dev/null || git diff --name-only --cached)
# Registry dogfood gate: app-side imports of package territory must resolve
# from the npm registry (two-module-instance context splits, #1019).
if echo "$changed" | grep -qE '^(app|providers|lib|components|i18n)/|^package(-lock)?\.json$|^packages/|check-package-registry-resolution'; then
  npm run check:package-registry-resolution
fi
# Dogfood ratchet: raw HTML / Tailwind debt can only decrease
# (docs/design-system/dogfooding-plan.md Phase 0).
if echo "$changed" | grep -qE '^app/|^nextjs-app/shared/(patterns|components)/|dogfood-ratchet'; then
  npm run check:dogfood-ratchet
fi
# pSEO quality gate: enforce the word/link floor on all leaf pages and the
# strict word+uniqueness bar on any page promoted to indexed. Only run when
# pSEO content/copy/routes/script change (the finding: gate previously ran no
# thresholds AND was wired into nothing).
if echo "$changed" | grep -qE '^content/pseo/|^app/pseo/|check-pseo-quality|^scripts/pseo/'; then
  npm run pseo:check-quality
fi
if echo "$changed" | grep -qE '\.(astro|css|[cm]?js|jsx|html|svelte|ts|tsx|vue)$|^\.stylelintrc|^\.rhythmguard|^package(-lock)?\.json$|stylelint|rhythmguard'; then
  npm run lint:css
  npm run audit:rhythm:check
fi
echo "$changed" | grep -qE 'nextjs-app/shared/(components|patterns|foundations)|scripts/design-system' || exit 0
# Contract gate: keep the local gate a superset of the farm's validate job for
# contract-touching changes (2026-07-03 incident: ten red farm runs because
# check:contract-props only existed in CI). build:tokens regenerates the dist
# artifacts (relationship graph + agent blocks) the two checks compare against.
npm run build:tokens
npm run check:token-packages
# Published-tokens freshness: warns on registry drift, fails only when the
# drift is older than 7 days (forgotten republish). Offline-safe skip.
npm run check:published-tokens-freshness -- --max-age-days 7
npm run check:contract-props
npm run check:consumers
# Sidebar lifecycle dot is drawn only from a meta lifecycle tag; keep it in
# sync with each component's contract status (see check-story-lifecycle-tags).
npm run check:story-lifecycle-tags
npm run check:astryx-roadmap
# figma-links is a ratchet over contract `figma` fields + figma-component-index.json.
# Only run it when a figma-governing file actually changed, so a stale baseline
# (debt improved elsewhere but not yet tightened) can't block an unrelated
# story/CSS/test push. See project_ci_actually_fixable memory (2026-07-13).
if echo "$changed" | grep -qE '\.contract\.json$|figma-component-index\.json|figma-links\.baseline\.json|check-figma-links'; then
  npm run check:figma-links
fi
npm run validate:components
npm run typecheck
npm run lint
