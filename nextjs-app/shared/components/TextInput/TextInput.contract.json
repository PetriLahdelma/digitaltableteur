{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "TextInput",
    "tier": "atom",
    "group": "form",
    "status": "beta",
    "description": "Labeled text input with validation, helper text, and size tokens.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=374-10",
    "radixPrimitive": null,
    "element": "input",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "forwarded": true,
            "forwardedTo": "CSS module size classes"
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Tab"
        ],
        "ariaRequirements": [
            "label association",
            "aria-describedby for error/helper"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior verified in Storybook; argTypes and required stories aligned with validate:components.",
        "forcedColorsVerified": true
    },
    "tokens": {
        "colors": [
            "--color-disabled-bg-light",
            "--color-error",
            "--color-error-bg",
            "--color-error-text",
            "--color-primary",
            "--color-white",
            "--focus-ring-color"
        ],
        "spacing": [],
        "typography": [
            "--font-text"
        ]
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "defaultValue",
        "disabled",
        "error",
        "helperText",
        "id",
        "isDisabled",
        "label",
        "onChange",
        "onValueChange",
        "placeholder",
        "ref",
        "size",
        "style",
        "type",
        "value"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "label": {
            "optional": false,
            "type": "string"
        },
        "type": {
            "optional": false,
            "type": "union",
            "values": [
                "number",
                "search",
                "text",
                "tel",
                "email",
                "password"
            ]
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ]
        },
        "onValueChange": {
            "optional": true,
            "type": "(value: string | number) => void"
        },
        "defaultValue": {
            "optional": true,
            "type": "string | number"
        },
        "value": {
            "optional": true,
            "type": "string | number"
        },
        "error": {
            "optional": true,
            "type": "string"
        },
        "helperText": {
            "optional": true,
            "type": "string"
        },
        "disabled": {
            "optional": true,
            "type": "boolean"
        },
        "onChange": {
            "optional": true,
            "type": "(value: string | number) => void"
        }
    },
    "forbiddenUse": [
        "ship a form that relies on the email validator as the only",
        "pass a `value` plus a `defaultValue`. The component treats",
        "use TextInput for multi-line text. Use **TextArea**, which"
    ],
    "composesWith": [
        "Button",
        "Text",
        "TextArea",
        "CheckboxGroup",
        "Checkbox"
    ],
    "displayName": "TextInput",
    "keywords": [
        "text input",
        "input",
        "field",
        "email",
        "phone",
        "validation"
    ],
    "dense": "labelled single-line field: text/number/email/password/search/tel, built-in email + phone validation, own error/helperText, sm/md/lg; onValueChange(value)",
    "usage": {
        "description": "TextInput is the standard single-line field: label, control, helper and error text in one component. The email and tel types add built-in validation (typo suggestions for common email domains, libphonenumber formatting for phone numbers); error overrides the helper line and wires aria-invalid.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Always pass a real label; placeholders vanish on focus and are not accessible names."
            },
            {
                "guidance": true,
                "description": "Read values through onValueChange; it hands you the typed value directly (onChange is deprecated)."
            },
            {
                "guidance": true,
                "description": "Pick the semantic type; email and tel get validation and the right mobile keyboard for free."
            },
            {
                "guidance": true,
                "description": "Use helperText for format hints before errors happen (We never share this address)."
            },
            {
                "guidance": false,
                "description": "Do not build multi-line entry with TextInput; use TextArea."
            },
            {
                "guidance": false,
                "description": "Do not layer your own live email/tel validation on top of the built-in one; two messages can disagree. Server-side truth belongs in error after submit."
            }
        ]
    },
    "playground": {
        "defaults": {
            "label": "Email address",
            "type": "email",
            "helperText": "We never share this address."
        }
    }
}
