{
  "$schema": "../../../scripts/design-system/contract.schema.json",
  "name": "Inputs",
  "tier": "atom",
  "group": "form",
  "status": "beta",
  "description": "Labeled text input with validation, helper text, and size tokens.",
  "figma": "https://www.figma.com/design/d8nFs8A5KcjbFr6KkwZV4H5K/Digitaltableteur-Design-System?node-id=dt-inputs",
  "radixPrimitive": null,
  "element": "input",
  "variants": {
    "size": {
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "default": "md",
      "forwarded": true,
      "forwardedTo": "CSS module size classes"
    }
  },
  "slots": [],
  "asChild": false,
  "subParts": [],
  "requiredStories": [
    "Default",
    "Playground",
    "Example",
    "ForcedColors"
  ],
  "a11y": {
    "keyboard": [
      "Tab"
    ],
    "ariaRequirements": [
      "label association",
      "aria-describedby for error/helper"
    ],
    "reducedMotion": true,
    "reviewed": true,
    "reviewedNote": "2026-05-26 — production behavior verified in Storybook; argTypes and required stories aligned with validate:components.",
    "forcedColorsVerified": true
  },
  "tokens": {
    "colors": [],
    "spacing": []
  },
  "lightDarkVerified": true,
  "argTypesProxyExempt": [
    "as",
    "asChild",
    "children",
    "className",
    "defaultValue",
    "disabled",
    "error",
    "helperText",
    "id",
    "isDisabled",
    "label",
    "onChange",
    "onValueChange",
    "placeholder",
    "ref",
    "size",
    "style",
    "type",
    "value"
  ],
  "consumers": []
}
