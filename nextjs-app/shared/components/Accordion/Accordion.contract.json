            "region panels"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior verified in Storybook; argTypes and required stories aligned with validate:components.",
        "forcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "defaultOpenId",
        "id",
        "items",
        "ref",
        "style"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "items": {
            "optional": false,
            "type": "AccordionItem[]"
        },
        "defaultOpenId": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "put primary navigation inside an accordion. AT users land on",
        "nest accordions more than one level deep. Two-level",
        "ship long, scrollable panels. If the content scrolls inside"
    ]
}
