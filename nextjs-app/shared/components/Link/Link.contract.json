{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Link",
    "tier": "atom",
    "group": "navigation",
    "status": "stable",
    "description": "Accessible inline link with sm/md/lg sizes, a focus ring, URL sanitisation, and an optional external-link icon.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=371-30",
    "radixPrimitive": null,
    "element": "a",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "propSourced": true
        },
        "underline": {
            "values": [
                "always",
                "hover",
                "none"
            ],
            "default": "always",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Enter"
        ],
        "ariaRequirements": [
            "visible focus",
            "descriptive link text"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-06-18 — platinum pass: sm/md/lg sizes, tokenized focus ring + colour transition, forced-colors verified.",
        "forcedColorsVerified": true,
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "href",
        "id",
        "ref",
        "rel",
        "style",
        "target"
    ],
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/dev/tailwind-test/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/layout.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/lib/siteStructure.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Pseo/PseoIndexPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Pseo/PseoLeafPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Pseo/PseoPillarPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/SitemapPage/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/SitemapPage/SitemapPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/CVDownloadSection/CVDownloadSection.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/CVDownloadSection/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/Footer/Footer.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/index.ts",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg"
            ]
        },
        "underline": {
            "optional": true,
            "type": "union",
            "values": [
                "always",
                "hover",
                "none"
            ]
        }
    },
    "forbiddenUse": [
        "use Link for actions. Buttons are for actions; anchors are for",
        "override the underline via inline styles; the token-driven treatment"
    ],
    "prefersOver": [
        "Button with href for body-copy links"
    ],
    "composesWith": [
        "Button",
        "Text",
        "Badge",
        "Title",
        "Grid",
        "ArticleCard"
    ]
}
