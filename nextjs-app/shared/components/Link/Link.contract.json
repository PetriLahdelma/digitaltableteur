{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Link",
    "tier": "atom",
    "group": "navigation",
    "status": "stable",
    "description": "Accessible inline link with sm/md/lg sizes, a focus ring, URL sanitisation, and an optional external-link icon.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=371-30",
    "radixPrimitive": null,
    "element": "a",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "propSourced": true
        },
        "underline": {
            "values": [
                "always",
                "hover",
                "none"
            ],
            "default": "always",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Enter"
        ],
        "ariaRequirements": [
            "visible focus",
            "descriptive link text"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-06-18 — platinum pass: sm/md/lg sizes, tokenized focus ring + colour transition, forced-colors verified.",
        "forcedColorsVerified": true,
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "href",
        "id",
        "ref",
        "rel",
        "style",
        "target"
    ],
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/dev/tailwind-test/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/layout.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/lib/siteStructure.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Pseo/PseoIndexPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Pseo/PseoLeafPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Pseo/PseoPillarPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/SitemapPage/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/SitemapPage/SitemapPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/CVDownloadSection/CVDownloadSection.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/CVDownloadSection/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/Footer/Footer.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/index.ts",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg"
            ]
        },
        "underline": {
            "optional": true,
            "type": "union",
            "values": [
                "always",
                "hover",
                "none"
            ]
        }
    },
    "forbiddenUse": [
        "use Link for actions. Buttons are for actions; anchors are for",
        "override the underline via inline styles; the token-driven treatment"
    ],
    "prefersOver": [
        "Button with href for body-copy links"
    ],
    "composesWith": [
        "Button",
        "Badge",
        "Text",
        "Title",
        "Checkbox",
        "TextInput"
    ],
    "keywords": [
        "link",
        "anchor",
        "navigation",
        "external",
        "mailto",
        "underline",
        "href"
    ],
    "dense": "inline anchor; href sanitised (http/https/mailto/tel/relative only), external auto-detect with icon and rel handling, underline always/hover/none, sm/md/lg",
    "usage": {
        "description": "Link is the inline navigation anchor. It sanitises the href (http, https, mailto, tel and relative paths only; javascript: and data: URLs are rewritten to #), auto-detects off-site destinations and appends an external-link icon, and adds rel=noopener noreferrer when target=_blank. Underline modes cover always, hover and none; sizes are sm, md and lg.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Use Link for navigation in body copy, lists, breadcrumbs and footers; the wavy underline treatment is token-driven."
            },
            {
                "guidance": true,
                "description": "Let the component detect external destinations; the icon and rel handling are automatic."
            },
            {
                "guidance": true,
                "description": "Use underline=hover in dense link collections such as footer columns."
            },
            {
                "guidance": false,
                "description": "Do not build button-shaped CTAs from Link; use Button, with href when the destination is a page."
            },
            {
                "guidance": false,
                "description": "Do not compose raw anchors for dynamic hrefs to bypass the sanitiser; a pasted URL must never become an XSS surface."
            },
            {
                "guidance": false,
                "description": "Do not use underline=none for links in running text; an undecorated inline link loses its affordance."
            }
        ]
    },
    "playground": {
        "defaults": {
            "children": "See the work",
            "href": "/work"
        }
    }
}
