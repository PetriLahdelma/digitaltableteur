{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Switch",
    "tier": "atom",
    "group": "form",
    "status": "beta",
    "description": "Toggle control with label placement, loading, and helper text.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=373-14",
    "radixPrimitive": null,
    "element": "button",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "propSourced": true
        }
    },
    "slots": [
        "label"
    ],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Space",
            "Enter"
        ],
        "ariaRequirements": [
            "role=switch",
            "aria-checked reflects state"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior, keyboard, and forced-colors verified in Storybook.",
        "forcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "helperText",
        "id",
        "isChecked",
        "isDisabled",
        "isLoading",
        "label",
        "labelPlacement",
        "onCheckedChange",
        "ref",
        "size",
        "style"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "isChecked": {
            "optional": true,
            "type": "boolean"
        },
        "isDisabled": {
            "optional": true,
            "type": "boolean"
        },
        "isLoading": {
            "optional": true,
            "type": "boolean"
        },
        "defaultChecked": {
            "optional": true,
            "type": "boolean"
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ]
        },
        "onCheckedChange": {
            "optional": true,
            "type": "(checked: boolean) => void"
        },
        "label": {
            "optional": true,
            "type": "React.ReactNode"
        },
        "labelPlacement": {
            "optional": true,
            "type": "union",
            "values": [
                "left",
                "right",
                "top"
            ]
        },
        "helperText": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "use Switch inside a form whose values are submitted in a batch.",
        "rely on colour alone to convey state — the position of the"
    ]
}
