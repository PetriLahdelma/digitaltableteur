{
    "$schema": "../../../scripts/design-system/contract.schema.json",
    "name": "Spacer",
    "tier": "atom",
    "group": "structure",
    "status": "alpha",
    "description": "Empty layout element that injects a fixed gap on a single axis. Used inside flex/grid containers where adding a token-sized gap as a sibling reads cleaner than the gap utility.",
    "figma": null,
    "radixPrimitive": null,
    "element": "div",
    "variants": {
        "size": {
            "values": [
                "xs",
                "sm",
                "md",
                "lg",
                "xl",
                "2xl"
            ],
            "default": "md"
        },
        "axis": {
            "values": [
                "block",
                "inline"
            ],
            "default": "block"
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "Renders as a non-interactive `<div>`; assistive tech ignores it."
        ],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [],
        "spacing": [
            "--space-layout-4",
            "--space-layout-8",
            "--space-layout-12",
            "--space-layout-16",
            "--space-layout-24",
            "--space-layout-32"
        ]
    },
    "lightDarkVerified": false,
    "consumers": []
}
