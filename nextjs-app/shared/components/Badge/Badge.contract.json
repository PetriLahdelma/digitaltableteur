{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Badge",
    "tier": "atom",
    "group": "display",
    "status": "stable",
    "description": "Compact status label with an orthogonal variant (visual weight) and tone (semantic colour), a size, and an optional icon.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=400-1249",
    "radixPrimitive": null,
    "element": "span",
    "variants": {
        "variant": {
            "values": [
                "primary",
                "secondary"
            ],
            "default": "primary",
            "propSourced": true
        },
        "tone": {
            "values": [
                "neutral",
                "error",
                "warning",
                "success",
                "info"
            ],
            "default": "neutral",
            "propSourced": true
        },
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "propSourced": true
        }
    },
    "slots": [
        "icon"
    ],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "meaningful text or aria-label when icon-only",
            "do not rely on colour alone — pair tone with the icon"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-06-18 — platinum pass: variant/tone API, sm/md/lg sizes, contrast and forced-colors verified.",
        "forcedColorsVerified": true,
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [
            "--color-black",
            "--color-white"
        ],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "icon",
        "id",
        "onRemove",
        "ref",
        "removable",
        "role",
        "size",
        "square",
        "style",
        "title",
        "tone",
        "variant"
    ],
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/CookieConsent/CookieConsent.tsx",
            "since": "2026-06-18"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/Card/Card.tsx",
            "since": "2026-06-18"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Pseo/PseoClusterBadges.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Work/Illustrations/IllustrationsPage.tsx",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "children": {
            "optional": false,
            "type": "React.ReactNode"
        },
        "variant": {
            "optional": true,
            "type": "union",
            "values": [
                "primary",
                "secondary"
            ]
        },
        "tone": {
            "optional": true,
            "type": "union",
            "values": [
                "info",
                "success",
                "warning",
                "error",
                "neutral"
            ]
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg"
            ]
        },
        "className": {
            "optional": true,
            "type": "string"
        },
        "removable": {
            "optional": true,
            "type": "boolean"
        },
        "onRemove": {
            "optional": true,
            "type": "() => void"
        },
        "icon": {
            "optional": true,
            "type": "React.ReactNode"
        },
        "square": {
            "optional": true,
            "type": "boolean"
        },
        "title": {
            "optional": true,
            "type": "string"
        },
        "role": {
            "optional": true,
            "type": "\"status\""
        }
    },
    "forbiddenUse": [
        "rely on colour alone to convey tone — pair it with the icon or include",
        "nest a Button inside a Badge beyond the built-in removable affordance."
    ],
    "composesWith": [
        "Title",
        "Link",
        "Button",
        "FlexBox",
        "Text",
        "Grid"
    ]
}
