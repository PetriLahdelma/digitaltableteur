{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "TransformingActionInput",
    "tier": "molecule",
    "group": "form",
    "status": "beta",
    "description": "Marketing entry-point input that morphs between surface modes, from a prompt bar into a chat handoff; pairs with ChatWidget.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=1446-2411",
    "radixPrimitive": null,
    "element": "div",
    "variants": {},
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "ariaRequirements": [],
        "reviewedNote": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled."
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "initialMode": {
            "optional": true,
            "type": "union",
            "values": [
                "button",
                "input"
            ],
            "description": "Initial surface mode before transformation"
        },
        "value": {
            "optional": true,
            "type": "string",
            "description": "Optional controlled value"
        },
        "defaultValue": {
            "optional": true,
            "type": "string",
            "description": "Default value when uncontrolled"
        },
        "disabled": {
            "optional": true,
            "type": "boolean",
            "description": "Disabled state for both button and input"
        },
        "actionLabelKey": {
            "optional": true,
            "type": "string",
            "description": "Translation key for the trigger label"
        },
        "inputLabelKey": {
            "optional": true,
            "type": "string",
            "description": "Translation key for the input label"
        },
        "helperTextKey": {
            "optional": true,
            "type": "string",
            "description": "Translation key for helper text below the input"
        },
        "placeholderKey": {
            "optional": true,
            "type": "string",
            "description": "Translation key for the placeholder"
        },
        "onChange": {
            "optional": true,
            "type": "(value: string) => void",
            "description": "Triggered when value changes"
        },
        "onSubmit": {
            "optional": true,
            "type": "(value: string) => void",
            "description": "Triggered on submit in input mode"
        },
        "stayInInputMode": {
            "optional": true,
            "type": "boolean",
            "description": "When true, retains the input after submit instead of returning to button mode"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Optional className passthrough"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ],
    "displayName": "TransformingActionInput",
    "keywords": [
        "input",
        "transform",
        "cta",
        "chat entry"
    ],
    "dense": "CTA input that transforms between surface modes (e.g. prompt bar to chat); marketing entry point for Donny",
    "usage": {
        "description": "Marketing entry-point input that morphs between surface modes (prompt bar into chat handoff). Pairs with ChatWidget."
    }
}
