    "schemaVersion": 2,
    "props": {
        "items": {
            "optional": false,
            "type": "React.ReactNode[]"
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "ol",
                "ul"
            ]
        },
        "className": {
            "optional": true,
            "type": "string"
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "s",
                "xl",
                "xs",
                "xxs",
                "m",
                "l",
                "xxl"
            ]
        },
        "lineHeight": {
            "optional": true,
            "type": "union",
            "values": [
                "normal",
                "tight",
                "snug",
                "relaxed",
                "loose"
            ]
        },
        "style": {
            "optional": true,
            "type": "React.CSSProperties"
        },
        "listStyleType": {
            "optional": true,
            "type": "union",
            "values": [
                "none",
                "decimal",
                "circle",
                "square",
                "disc",
                "decimal-leading-zero",
                "lower-alpha",
                "upper-alpha",
                "lower-roman",
                "upper-roman",
                "dash"
            ]
        },
        "spacing": {
            "optional": true,
            "type": "union",
            "values": [
                "normal",
                "relaxed",
                "compact"
            ]
        },
        "role": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "Pass pre-wrapped `<li>` elements in items — items are the contents; List renders the li.",
        "Use it for a single item or for layout — Stack is layout, List is list semantics."
    ],
    "composesWith": [
        "Text",
        "Stack"
    ],
    "displayName": "List",
    "keywords": [
        "list",
        "bullet",
        "ordered",
        "unordered",
        "description list",
        "items"
    ],
    "dense": "Typographic list: as ul|ol, items ReactNode[], size on the text ladder, listStyleType incl. none, spacing compact|normal|relaxed; component owns rhythm — no per-item margins",
    "usage": {
        "description": "List renders `items` as a typographic list on the text ladder: `as` picks ul/ol semantics, `size` matches the surrounding Text voice, `listStyleType` styles or removes markers, `spacing` sets the rhythm between items. It owns inter-item spacing — no margins on items. For custom marker treatments (like ProcessBlock's em dashes) pass `listStyleType=\"none\"` and style via className.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Pick as by meaning: ol when order matters, ul otherwise."
            },
            {
                "guidance": true,
                "description": "Match size to the surrounding Text so lists read as part of the prose voice."
            },
            {
                "guidance": true,
                "description": "Use spacing (compact|normal|relaxed) for rhythm instead of margins on items."
            },
            {
                "guidance": true,
                "description": "Use listStyleType none plus a class for custom markers; keep the semantic list element."
            },
            {
                "guidance": false,
                "description": "Do not pass pre-wrapped li elements in items — items are the contents; List renders the li."
            },
            {
                "guidance": false,
                "description": "Do not use a list for a single item or for layout; Stack is layout, List is semantics."
            }
        ],
        "anatomy": [
            {
                "name": "List element",
                "required": true,
                "description": "ul or ol chosen by as; carries size typography and spacing rhythm."
            },
            {
                "name": "Item",
                "required": true,
                "description": "Rendered `<li>` per entry in items; List owns the wrapper, callers pass the contents only."
            },
            {
                "name": "Marker",
                "required": false,
                "description": "listStyleType-driven bullet/number; none removes it for custom marker treatments."
            }
        ]
    },
    "playground": {
        "defaults": {
            "items": [
                "Design tokens",
                "Components",
                "Patterns"
            ],
            "as": "ul",
            "size": "s"
        }
    }
}
