        "defaultActiveTabKey",
        "description",
        "descriptionProps",
        "design",
        "extra",
        "footer",
        "headStyle",
        "hoverable",
        "icon",
        "iconProps",
        "id",
        "interactive",
        "level",
        "link",
        "linkLabel",
        "loading",
        "onClick",
        "onTabChange",
        "position",
        "ref",
        "size",
        "state",
        "statusMessage",
        "statusMessageProps",
        "style",
        "subTitle",
        "subTitleProps",
        "tabs",
        "terminals",
        "title",
        "titleProps",
        "variant"
