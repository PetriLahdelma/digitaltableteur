{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Avatar",
    "tier": "atom",
    "group": "display",
    "status": "stable",
    "description": "Profile image, initials, link, or menu trigger.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=369-8",
    "radixPrimitive": null,
    "element": "button",
    "variants": {
        "variant": {
            "values": [
                "image",
                "initials"
            ],
            "default": "image",
            "propSourced": true
        },
        "size": {
            "values": [
                "2rem",
                "2.5rem",
                "3rem",
                "4rem",
                "5rem",
                "6rem",
                "7rem",
                "8rem"
            ],
            "default": "2.5rem",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "menu trigger needs accessible name",
            "image alt from name"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior, keyboard, and forced-colors verified in Storybook. 2026-07-05 (beta→stable) — re-verified independently: axe-clean, light + dark eyeballed, AT snapshots refreshed and compare-clean in all four modes, Controls 100% operable + 0 inert; removed the dead avatarVariants cva stub and fixed the invalid \"md\" playground size default. 2026-07-05 (menu on shared Menu) — the account menu now consumes the Menu primitive (Radix dropdown-menu) instead of hand-rolled markup: public API (menuItems/menuLabel) unchanged, obsolete placementRefreshKey removed (Radix owns collision). Re-verified: open-menu axe-clean + keyboard select via test-storybook play, aligned ~40px rows eyeballed open in light/dark/forced-colors, Controls 100% + 0 inert, AT snapshots refreshed compare-clean.",
        "forcedColorsVerified": true,
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/BlogArticleMdxBody.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleContent.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleMain.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Blog/AuthorPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Blog/BlogArticlePage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Blog/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/ArticlePageTemplate/ArticlePageTemplate.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/ArticlePageTemplate/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/index.ts",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "name": {
            "optional": true,
            "type": "string"
        },
        "imageUrl": {
            "optional": true,
            "type": "string | { default: string } | StaticImageData"
        },
        "clickable": {
            "optional": true,
            "type": "boolean"
        },
        "destinationUrl": {
            "optional": true,
            "type": "string"
        },
        "size": {
            "optional": true,
            "type": "AvatarSize"
        },
        "srcSet": {
            "optional": true,
            "type": "string"
        },
        "sizes": {
            "optional": true,
            "type": "string"
        },
        "loading": {
            "optional": true,
            "type": "union",
            "values": [
                "lazy",
                "eager"
            ]
        },
        "decoding": {
            "optional": true,
            "type": "union",
            "values": [
                "auto",
                "sync",
                "async"
            ]
        },
        "menuItems": {
            "optional": true,
            "type": "AvatarMenuItem[]"
        },
        "menuLabel": {
            "optional": true,
            "type": "string"
        },
        "variant": {
            "optional": true,
            "type": "union",
            "values": [
                "image",
                "initials"
            ]
        }
    },
    "forbiddenUse": [
        "render two interactive children inside Avatar (link plus menu);",
        "nest an Avatar inside a Button. Pick one — Avatar already owns"
    ],
    "composesWith": [
        "Card",
        "PersonCard",
        "Badge",
        "Menu"
    ],
    "displayName": "Avatar",
    "keywords": [
        "avatar",
        "profile",
        "initials",
        "user image",
        "menu",
        "identity"
    ],
    "dense": "Identity mark: image (srcSet/lazy) or initials from name; sm..xl sizes; optional link (clickable + destinationUrl) or dropdown menu (menuItems + menuLabel); variant forces image|initials",
    "usage": {
        "description": "Avatar renders a person or entity mark: the image when `imageUrl` resolves, otherwise initials derived from `name`. It scales through the size tokens and can act as a link (`clickable` + `destinationUrl`) or as a menu trigger (`menuItems` + `menuLabel`) with an in-place dropdown. Always pass `name` — it feeds both the initials fallback and the accessible naming.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Always provide name, even with an image — it is the initials fallback and the accessible name."
            },
            {
                "guidance": true,
                "description": "Provide srcSet/sizes for photographic avatars so dense grids do not ship desktop images to mobile."
            },
            {
                "guidance": true,
                "description": "Use menuLabel to say what the menu does (\"Account menu\"), not who the person is."
            },
            {
                "guidance": true,
                "description": "Keep loading lazy (default-friendly) in long lists; eager only above the fold."
            },
            {
                "guidance": false,
                "description": "Do not wrap Avatar in another link/button when clickable or menuItems already make it interactive — nested controls break AT."
            },
            {
                "guidance": false,
                "description": "Do not use variant=\"initials\" to hide a broken image pipeline; fix the source, the fallback is for genuinely imageless users."
            }
        ]
    },
    "playground": {
        "defaults": {
            "name": "Petri Lahdelma",
            "size": "2.5rem"
        }
    }
}
