            "path": "app/intake/admin/intakes/[inviteId]/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/intake/admin/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Blog/BlogArticlePage.tsx",
            "since": "2026-06-04"
        }
    ]
}
