{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "schemaVersion": 2,
    "name": "TableCell",
    "tier": "atom",
    "group": "data-display",
    "status": "stable",
    "description": "A table data cell (<td>) for the Table family. align controls text alignment; numeric right-aligns with tabular figures so columns line up on the decimal.",
    "usage": {
        "description": "TableCell is the body cell of the Table family: plain tabular data with an optional numeric mode that aligns figures on the decimal. Header semantics belong to TableHeaderCell; TableCell never announces scope."
    },
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=1715-2814",
    "radixPrimitive": null,
    "element": "td",
    "variants": {
        "align": {
            "values": [
                "start",
                "center",
                "end"
            ],
            "default": "start",
            "propSourced": true
        },
        "numeric": {
            "values": [
                "true",
                "false"
            ],
            "default": "false",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "native <td> semantics; no ARIA of its own",
            "pairs with TableHeaderCell scope=col/row so cells inherit column and row context"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-07-27 — native td; alignment and numeric tabular figures verified; axe asserted inside a table in the unit test. 2026-08-04 — Phase 1 pass: light/dark/forced-colors verified in a real browser; axe clean across all stories x 3 modes; AT-tree and real-browser forced-colors evidence captured; keyboard sort cycle and selection driven by play stories at the Table composition level. 2026-10-15: promoted to stable. Production consumers per audit:consumers; evidence recaptured in light, dark and forced-colors (real Chromium forced-colors pass) against 1b3b7d94a, every record passing with axe clean.",
        "forcedColorsVerified": true,
        "realBrowserForcedColorsVerified": true,
        "accessibilityTreeVerified": true
    },
    "tokens": {
        "colors": [
            "--color-border-light"
        ],
        "spacing": [
            "--space-internal-8",
            "--space-internal-12",
            "--space-internal-16",
            "--space-layout-24"
        ]
    },
    "lightDarkVerified": true,
    "dense": "table td; align start/center/end, numeric = tabular figures right-aligned",
    "keywords": [
        "table",
        "cell",
        "td",
        "numeric"
    ],
    "props": {
        "align": {
            "optional": true,
            "type": "union",
            "values": [
                "center",
                "end",
                "start"
            ],
            "description": "Cell content alignment."
        },
        "numeric": {
            "optional": true,
            "type": "boolean",
            "description": "Right-align and tabular-figure numeric values."
        },
        "label": {
            "optional": true,
            "type": "string",
            "description": "Column name shown before the value when the parent Table stacks rows (stackOnNarrow). Hidden from assistive technology, which reads the column header instead."
        }
    },
    "forbiddenUse": [
        "render it outside a table row",
        "use it for a header — use TableHeaderCell so column/row context is announced"
    ],
    "composesWith": [
        "Table",
        "TableRow",
        "TableHeaderCell"
    ],
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/BlogArticleMdxBody.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleContent.tsx",
            "since": "2026-06-04"
        },
        {
