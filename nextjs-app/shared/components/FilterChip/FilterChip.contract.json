            "--space-internal-6",
            "--space-internal-8",
            "--space-internal-12",
            "--space-internal-16",
            "--space-internal-24"
        ]
    },
    "lightDarkVerified": true,
    "schemaVersion": 2,
    "displayName": "FilterChip",
