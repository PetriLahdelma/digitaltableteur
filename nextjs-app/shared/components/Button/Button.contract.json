{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Button",
    "tier": "molecule",
    "group": "interaction",
    "status": "stable",
    "description": "Primary action control with an orthogonal variant (visual weight) and tone (semantic color) model, loading state, and polymorphic button/link rendering.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=406-1569",
    "radixPrimitive": null,
    "element": "button",
    "variants": {
        "variant": {
            "values": [
                "primary",
                "secondary",
                "tertiary"
            ],
            "default": "primary",
            "propSourced": true
        },
        "tone": {
            "values": [
                "neutral",
                "error",
                "warning",
                "success",
                "info"
            ],
            "default": "neutral",
            "propSourced": true
        },
        "surface": {
            "values": [
                "default",
                "onDark",
                "onBrand"
            ],
            "default": "default",
            "propSourced": true
        },
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "propSourced": true
        }
    },
    "slots": [
        "icon",
        "endIcon"
    ],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Enter",
            "Space"
        ],
        "ariaRequirements": [
            "accessible name",
            "aria-busy when loading",
            "disabled state",
            "aria-disabled (not disabled) in link mode; anchors have no disabled attribute",
            "focus-visible ring via --focus-ring-color; Highlight outline under forced colors"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-06-18 — platinum pass: variant/tone API, scale(0.97) press feedback, tokenized motion, forced-colors + reduced-motion handled. AT snapshots refreshed.",
        "forcedColorsVerified": true,
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true,
        "axeTestExempt": "Interaction atom; axe asserted on Default/Primary and per-variant a11y tests."
    },
    "tokens": {
        "colors": [
            "--color-primary",
            "--color-white",
            "--color-error",
            "--color-warning-contrast",
            "--color-success",
            "--color-info",
            "--color-disabled-bg",
            "--color-muted",
            "--logo-color",
            "--logo-background"
        ],
        "spacing": [
            "--space-internal-4",
            "--space-internal-8",
            "--space-internal-12",
            "--space-internal-16",
            "--space-internal-24"
        ]
    },
    "lightDarkVerified": true,
