{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Button",
    "tier": "molecule",
    "group": "interaction",
    "status": "stable",
    "description": "Primary action control with an orthogonal variant (visual weight) and tone (semantic color) model, loading state, and polymorphic button/link rendering.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=406-1569",
    "radixPrimitive": null,
    "element": "button",
    "variants": {
        "variant": {
            "values": [
                "primary",
                "secondary",
                "tertiary"
            ],
            "default": "primary",
            "propSourced": true
        },
        "tone": {
            "values": [
                "neutral",
                "error",
                "warning",
                "success",
                "info"
            ],
            "default": "neutral",
            "propSourced": true
        },
        "surface": {
            "values": [
                "default",
                "onDark",
                "onBrand"
            ],
            "default": "default",
            "propSourced": true
        },
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "propSourced": true
        }
    },
    "slots": [
        "icon",
        "endIcon"
    ],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Enter",
            "Space"
        ],
        "ariaRequirements": [
            "accessible name",
            "aria-busy when loading",
            "disabled state"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-06-18 — platinum pass: variant/tone API, scale(0.97) press feedback, tokenized motion, forced-colors + reduced-motion handled. AT snapshots refreshed.",
        "forcedColorsVerified": true,
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true,
        "axeTestExempt": "Interaction atom; axe asserted on Default/Primary and per-variant a11y tests."
    },
    "tokens": {
        "colors": [
            "--color-primary",
            "--color-white",
            "--color-error",
            "--color-warning-contrast",
            "--color-success",
            "--color-info",
            "--color-disabled-bg",
            "--color-muted",
            "--logo-color",
            "--logo-background"
        ],
        "spacing": [
            "--space-internal-4",
            "--space-internal-8",
            "--space-internal-12",
            "--space-internal-16",
            "--space-internal-24"
        ]
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "accessibleDescription",
        "accessibleName",
        "accessibleNameRef",
        "children",
        "className",
        "disabled",
        "endIcon",
        "form",
        "href",
        "icon",
        "id",
        "loading",
        "name",
        "onClick",
        "ref",
        "rel",
        "rounded",
        "size",
        "submits",
        "surface",
        "target",
        "tone",
        "tooltip",
        "type",
        "value",
        "variant"
    ],
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/error.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/not-found.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/layout.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/Card/Card.tsx",
            "since": "2026-06-18"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/Button/SplitButton.tsx",
            "since": "2026-06-18"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "variant": {
            "optional": true,
            "type": "union",
            "values": [
                "primary",
                "secondary",
                "tertiary"
            ]
        },
        "tone": {
            "optional": true,
            "type": "union",
            "values": [
                "neutral",
                "error",
                "warning",
                "success",
                "info"
            ]
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg"
            ]
        },
        "surface": {
            "optional": true,
            "type": "union",
            "values": [
                "default",
                "onDark",
                "onBrand"
            ]
        },
        "disabled": {
            "optional": true,
            "type": "boolean"
        },
        "loading": {
            "optional": true,
            "type": "boolean"
        },
        "rounded": {
            "optional": true,
            "type": "boolean"
        },
        "icon": {
            "optional": true,
            "type": "React.ReactNode | string"
        },
        "endIcon": {
            "optional": true,
            "type": "React.ReactNode | string"
        },
        "children": {
            "optional": true,
            "type": "React.ReactNode"
        },
        "accessibleName": {
            "optional": true,
            "type": "string"
        },
        "accessibleNameRef": {
            "optional": true,
            "type": "string"
        },
        "accessibleDescription": {
            "optional": true,
            "type": "string"
        },
        "tooltip": {
            "optional": true,
            "type": "string"
        },
        "submits": {
            "optional": true,
            "type": "boolean"
        },
        "href": {
            "optional": false,
            "type": "string"
        },
        "target": {
            "optional": true,
            "type": "HTMLAttributeAnchorTarget | undefined"
        },
        "rel": {
            "optional": true,
            "type": "string | undefined"
        }
    },
    "forbiddenUse": [
        "tertiary on low-contrast surfaces without verifying contrast",
        "surface onBrand without verifying brand-color contrast",
        "an icon-only button with a tooltip as the only accessible name",
        "nesting a Button inside another interactive control",
        "a Button for inline navigation in body copy. Use Link instead."
    ],
    "prefersOver": [
        "raw button",
        "Link for in-copy navigation"
    ],
    "composesWith": [
        "Title",
        "Text",
        "Icon",
        "Modal"
    ]
}
