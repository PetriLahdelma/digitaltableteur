{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Spinner",
    "tier": "atom",
    "group": "feedback",
    "status": "beta",
    "description": "Indeterminate loading spinner for async UI.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=368-16",
    "radixPrimitive": null,
    "element": "span",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "forwarded": true,
            "forwardedTo": "CSS module size classes on Spinner.module.css"
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "argTypesProxyExempt": [
        "className"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "aria-label or aria-labelledby"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "reviewedNote": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled."
    },
    "tokens": {
        "colors": [
            "--color-primary",
            "--color-border"
        ],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "label": {
            "optional": true,
            "type": "string"
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg"
            ]
        },
        "className": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ]
}
