{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Checkbox",
    "tier": "atom",
    "group": "form",
    "status": "beta",
    "description": "Accessible checkbox with label, indeterminate, and size variants.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=372-14",
    "radixPrimitive": null,
    "element": "input",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Space"
        ],
        "ariaRequirements": [
            "associated label",
            "indeterminate exposes aria-checked mixed when applicable"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior, keyboard, and forced-colors verified in Storybook.",
        "forcedColorsVerified": true
    },
    "tokens": {
        "colors": [
            "--checkbox-checkmark-color",
            "--color-light-bg",
            "--color-muted-light",
            "--color-primary",
            "--focus-ring-color"
        ],
        "spacing": [],
        "radii": [
            "--radius-md"
        ]
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "isChecked",
        "isDisabled",
        "isIndeterminate",
        "name",
        "ref",
        "style",
        "value"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "label": {
            "optional": true,
            "type": "string"
        },
        "showLabel": {
            "optional": true,
            "type": "boolean"
        },
        "checked": {
            "optional": true,
            "type": "boolean"
        },
        "indeterminate": {
            "optional": true,
            "type": "boolean"
        },
        "disabled": {
            "optional": true,
            "type": "boolean"
        },
        "defaultChecked": {
            "optional": true,
            "type": "boolean"
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg"
            ]
        },
        "onCheckedChange": {
            "optional": true,
            "type": "(checked: boolean) => void"
        },
        "id": {
            "optional": true,
            "type": "string"
        },
        "error": {
            "optional": true,
            "type": "string"
        },
        "helperText": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "use `checked` directly. The prefixed `isChecked` name is the",
        "rely on the native `indeterminate` HTML attribute — there is"
    ],
    "composesWith": [
        "TextInput",
        "Button",
        "Link",
        "Label",
        "Text",
        "Grid"
    ],
    "displayName": "Checkbox",
    "keywords": [
        "checkbox",
        "check",
        "consent",
        "multi-select",
        "indeterminate"
    ],
    "dense": "native checkbox with label, sm/md/lg, indeterminate, own error + helperText; onCheckedChange(boolean); controlled or uncontrolled",
    "usage": {
        "description": "Checkbox is a labelled native input for an independent yes/no choice that takes effect when the form is submitted. It supports controlled and uncontrolled use, an indeterminate state for select-all parents, and carries its own error and helper text.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Write the label as the positive assertion being agreed to (Subscribe to the newsletter)."
            },
            {
                "guidance": true,
                "description": "Use indeterminate only on a select-all parent whose children are mixed; activating it resolves to checked."
            },
            {
                "guidance": true,
                "description": "Use the error prop for validation such as required consent; it wires aria-invalid and announces via role=alert."
            },
            {
                "guidance": true,
                "description": "Group related checkboxes with CheckboxGroup or FormField so a legend names the set."
            },
            {
                "guidance": false,
                "description": "Do not use a Checkbox for an immediate on/off effect; that is Switch."
            },
            {
                "guidance": false,
                "description": "Do not hide the label with showLabel=false unless adjacent visible text names the control; the label is still the accessible name."
            }
        ]
    },
    "playground": {
        "defaults": {
            "label": "Subscribe to the newsletter",
            "size": "md"
        }
    }
}
