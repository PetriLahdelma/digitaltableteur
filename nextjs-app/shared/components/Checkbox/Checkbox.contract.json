            "path": "nextjs-app/shared/patterns/ContactPageContentEditorial/index.ts",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "label": {
            "optional": true,
            "type": "string",
            "description": "Label text displayed next to the checkbox"
        },
        "showLabel": {
            "optional": true,
            "type": "boolean",
            "description": "Whether to show the label text."
        },
        "checked": {
            "optional": true,
            "type": "boolean",
            "description": "Checked state (controlled)."
        },
        "indeterminate": {
            "optional": true,
            "type": "boolean",
            "description": "Indeterminate (mixed) state."
        },
        "disabled": {
            "optional": true,
            "type": "boolean",
            "description": "Disables interaction and dims the control."
        },
        "defaultChecked": {
            "optional": true,
            "type": "boolean",
            "description": "Initial checked state for uncontrolled use."
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "description": "Size."
        },
        "onCheckedChange": {
            "optional": true,
            "type": "(checked: boolean) => void",
            "description": "Called with the next checked value when toggled."
        },
        "id": {
            "optional": true,
            "type": "string",
            "description": "Custom ID for the checkbox element; auto-generated when omitted"
        },
        "error": {
            "optional": true,
            "type": "string",
            "description": "Error message under the control; sets aria-invalid and aria-describedby."
        },
        "helperText": {
            "optional": true,
            "type": "string",
            "description": "Supporting text under the control; always rendered, below `error` when both are set."
        }
    },
    "forbiddenUse": [
        "use `checked` directly. The prefixed `isChecked` name is the",
        "rely on the native `indeterminate` HTML attribute — there is"
    ],
    "composesWith": [
        "TextInput",
        "Button",
        "Link",
        "Label",
        "Text",
        "Grid"
    ],
    "displayName": "Checkbox",
    "keywords": [
        "checkbox",
        "check",
        "consent",
        "multi-select",
        "indeterminate"
    ],
    "dense": "native checkbox with label, sm/md/lg, indeterminate, own error + helperText; onCheckedChange(boolean); controlled or uncontrolled",
    "usage": {
        "description": "Checkbox is a labelled native input for an independent yes/no choice that takes effect when the form is submitted. It supports controlled and uncontrolled use, an indeterminate state for select-all parents, and carries its own error and helper text.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Write the label as the positive assertion being agreed to (Subscribe to the newsletter)."
            },
            {
                "guidance": true,
                "description": "Use indeterminate only on a select-all parent whose children are mixed; activating it resolves to checked."
            },
            {
                "guidance": true,
                "description": "Use the error prop for validation such as required consent; it wires aria-invalid and announces via role=alert."
            },
            {
                "guidance": true,
                "description": "Group related checkboxes with CheckboxGroup or FormField so a legend names the set."
            },
            {
                "guidance": false,
                "description": "Do not use a Checkbox for an immediate on/off effect; that is Switch."
            },
            {
                "guidance": false,
                "description": "Do not hide the label with showLabel=false unless adjacent visible text names the control; the label is still the accessible name."
            }
        ]
    },
    "playground": {
        "defaults": {
            "label": "Subscribe to the newsletter",
            "size": "md"
        }
    }
}
