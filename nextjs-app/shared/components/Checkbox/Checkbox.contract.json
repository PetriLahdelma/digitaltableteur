{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Checkbox",
    "tier": "atom",
    "group": "form",
    "status": "beta",
    "description": "Accessible checkbox with label, indeterminate, and size variants.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=372-14",
    "radixPrimitive": null,
    "element": "input",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Space"
        ],
        "ariaRequirements": [
            "associated label",
            "indeterminate exposes aria-checked mixed when applicable"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior, keyboard, and forced-colors verified in Storybook.",
        "forcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "defaultChecked",
        "id",
        "isChecked",
        "isDisabled",
        "isIndeterminate",
        "label",
        "name",
        "onCheckedChange",
        "ref",
        "showLabel",
        "size",
        "style",
        "value"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "label": {
            "optional": true,
            "type": "string"
        },
        "showLabel": {
            "optional": true,
            "type": "boolean"
        },
        "isChecked": {
            "optional": true,
            "type": "boolean"
        },
        "isIndeterminate": {
            "optional": true,
            "type": "boolean"
        },
        "isDisabled": {
            "optional": true,
            "type": "boolean"
        },
        "defaultChecked": {
            "optional": true,
            "type": "boolean"
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ]
        },
        "onCheckedChange": {
            "optional": true,
            "type": "(checked: boolean) => void"
        },
        "id": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "use `checked` directly. The prefixed `isChecked` name is the",
        "rely on the native `indeterminate` HTML attribute — there is"
    ]
}
