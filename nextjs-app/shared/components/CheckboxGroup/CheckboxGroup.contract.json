{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "CheckboxGroup",
    "tier": "molecule",
    "group": "form",
    "status": "beta",
    "description": "Grouped checkboxes with optional master checkbox.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=383-24",
    "radixPrimitive": null,
    "element": "fieldset",
    "variants": {},
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Space",
            "Tab"
        ],
        "ariaRequirements": [
            "fieldset legend",
            "group checkbox associations"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior verified in Storybook; argTypes and required stories aligned with validate:components.",
        "forcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "defaultSelected",
        "masterLabel",
        "onChange",
        "ref",
        "style"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "id": {
            "optional": true,
            "type": "string"
        },
        "label": {
            "optional": false,
            "type": "string"
        },
        "className": {
            "optional": true,
            "type": "string"
        },
        "options": {
            "optional": false,
            "type": "{ label: string; value: string }[]"
        },
        "showMasterCheckbox": {
            "optional": true,
            "type": "boolean"
        },
        "masterLabel": {
            "optional": true,
            "type": "string"
        },
        "defaultSelected": {
            "optional": true,
            "type": "string[]"
        },
        "onChange": {
            "optional": true,
            "type": "(selectedOptions: string[]) => void"
        }
    },
    "forbiddenUse": [
        "render a CheckboxGroup with one option. It's an awkward",
        "nest a CheckboxGroup inside another CheckboxGroup. AT",
        "rely on the master label translation key without testing the"
    ],
    "composesWith": [
        "TextInput",
        "Button",
        "Text",
        "TextArea",
        "Grid",
        "ArticleCard"
    ],
    "displayName": "CheckboxGroup",
    "keywords": [
        "checkbox group",
        "multi-select",
        "select all",
        "fieldset",
        "options"
    ],
    "dense": "checkbox set with fieldset legend and optional select-all master (indeterminate while mixed); onChange reports the selected value array",
    "usage": {
        "description": "CheckboxGroup renders a set of related checkboxes under one fieldset legend, with an optional master select-all checkbox that shows the indeterminate state while the set is mixed. It reports the full selected-value array on every change.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Use it when several checkboxes answer one question; the label becomes the fieldset legend every control announces."
            },
            {
                "guidance": true,
                "description": "Enable showMasterCheckbox for sets of four or more where select-all is a plausible intent."
            },
            {
                "guidance": true,
                "description": "Keep option labels parallel in wording so the set scans as one family."
            },
            {
                "guidance": true,
                "description": "Seed defaultSelected with the common case instead of forcing users to re-pick standard options."
            },
            {
                "guidance": false,
                "description": "Do not use it for exclusive choices; that is RadioGroup."
            },
            {
                "guidance": false,
                "description": "Do not mix unrelated decisions into one group; the legend must truthfully name every option."
            }
        ]
    },
    "playground": {
        "defaults": {
            "label": "Notification channels",
            "options": [
                {
                    "label": "Email",
                    "value": "email"
                },
                {
                    "label": "SMS",
                    "value": "sms"
                },
                {
                    "label": "Push",
                    "value": "push"
                }
            ],
            "showMasterCheckbox": true,
            "masterLabel": "All channels"
        }
    }
}
