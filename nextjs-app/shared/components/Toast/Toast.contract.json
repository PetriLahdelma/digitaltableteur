{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Toast",
    "tier": "molecule",
    "group": "feedback",
    "status": "beta",
    "description": "Transient status message with tone, position, and auto-dismiss.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=393-35",
    "radixPrimitive": null,
    "element": "div",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg"
            ],
            "default": "md",
            "forwarded": true,
            "forwardedTo": "CSS module size classes"
        },
        "tone": {
            "values": [
                "success",
                "error",
                "warning",
                "info"
            ],
            "default": "info",
            "forwarded": true
        },
        "position": {
            "values": [
                "top-left",
                "top-center",
                "top-right",
                "bottom-left",
                "bottom-center",
                "bottom-right"
            ],
            "default": "bottom-center",
            "forwarded": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "role=status",
            "aria-live polite"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior verified in Storybook; argTypes and required stories aligned with validate:components.",
        "forcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "duration",
        "id",
        "message",
        "onClose",
        "open",
        "position",
        "ref",
        "size",
        "style",
        "tone"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "open": {
            "optional": true,
            "type": "boolean"
        },
        "tone": {
            "optional": true,
            "type": "union",
            "values": [
                "info",
                "success",
                "warning",
                "error"
            ]
        },
        "position": {
            "optional": true,
            "type": "union",
            "values": [
                "top-left",
                "top-center",
                "top-right",
                "bottom-left",
                "bottom-center",
                "bottom-right"
            ]
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg"
            ]
        },
        "message": {
            "optional": false,
            "type": "string"
        },
        "duration": {
            "optional": true,
            "type": "number"
        },
        "onClose": {
            "optional": true,
            "type": "() => void"
        }
    },
    "forbiddenUse": [
        "stack toasts. The provider queues them — calling `showToast`",
        "rely on Toast for compliance acknowledgements (cookie consent,",
        "use Toast for validation errors on a field. The visual is far"
    ],
    "prefersOver": [
        "AlertBanner for page-level persistent status"
    ],
    "composesWith": [
        "Button",
        "Text",
        "Modal",
        "TextInput",
        "CheckboxGroup",
        "TextArea"
    ]
}
