{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "HelperText",
    "tier": "atom",
    "group": "form",
    "status": "stable",
    "description": "Semantic helper or validation copy below form controls.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=371-17",
    "radixPrimitive": null,
    "element": "p",
    "variants": {},
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "link to control via id / aria-describedby"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior, keyboard, and forced-colors verified in Storybook. 2026-07-06 beta->stable: independently re-verified all four semantic states (error/warning/success/info) in light/dark + forced-colors in a real browser (state color + fill icon track the theme; forced-colors keeps the icon + CanvasText copy legible); error state carries role=alert. Removed a dead helperTextVariants cva scaffolder stub (empty size axis, never used). realBrowserForcedColorsVerified + accessibilityTreeVerified set true.",
        "forcedColorsVerified": true,
        "realBrowserForcedColorsVerified": true,
        "accessibilityTreeVerified": true
    },
    "tokens": {
        "colors": [
            "--color-error",
            "--color-info",
            "--color-primary",
            "--color-success",
            "--color-warning-contrast"
        ],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [
        {
