                "flex-start",
                "flex-end",
                "stretch",
                "baseline",
                "-moz-initial",
                "initial",
                "revert",
                "revert-layer",
                "unset",
                "end",
                "self-end",
                "self-start",
                "start",
                "anchor-center",
                "normal",
