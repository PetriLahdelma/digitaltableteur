    "name": "Grid",
    "tier": "atom",
    "group": "layout",
    "status": "beta",
    "description": "CSS grid layout primitive with tokenized gaps.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-grid",
    "radixPrimitive": null,
    "element": "div",
    "variants": {
