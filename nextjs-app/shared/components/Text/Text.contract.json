{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Text",
    "tier": "atom",
    "group": "display",
    "status": "stable",
    "description": "Body and inline typography with size, terminal, and line-height tokens.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=370-19",
    "radixPrimitive": null,
    "element": "p",
    "variants": {
        "size": {
            "values": [
                "xxs",
                "xs",
                "s",
                "m",
                "l",
                "xl",
                "xxl"
            ],
            "default": "m",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "semantic element via as prop"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — typography contrast and forced-colors verified in Storybook.",
        "forcedColorsVerified": true,
        "axeTestExempt": "Typography display; axe in colocated tests.",
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/BlogArticleMdxBody.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/BlogArticleShare.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleContent.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleMain.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/dev/code-window/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/dev/tailwind-test/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/layout.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/tools/email-signature/EmailSignatureContent.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/tools/email-signature/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Blog/AuthorPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Blog/BlogArticlePage.tsx",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "displayName": "Text",
    "props": {
        "children": {
            "optional": true,
            "type": "ReactI18NextChildren | Iterable<ReactI18NextChildren>"
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "cite",
                "div",
                "em",
                "h1",
                "h2",
                "h3",
                "h4",
                "h5",
                "h6",
                "p",
                "span",
                "strong"
            ]
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "s",
                "xl",
                "xs",
                "xxs",
                "m",
                "l",
                "xxl"
            ]
        },
        "lineHeight": {
            "optional": true,
            "type": "union",
            "values": [
                "normal",
                "tight",
                "snug",
                "relaxed",
                "loose"
            ]
        }
    },
    "forbiddenUse": [
        "nest a `<Text as=\"p\">` inside another `<p>`. HTML rejects nested",
        "override font-size via inline `style`. The ladder is the contract;"
    ],
    "prefersOver": [
        "raw paragraph elements"
    ],
    "composesWith": [
        "Title",
        "StoryBlock",
        "ProjectDetailLayout",
        "ProjectHero",
        "RelatedProjects",
        "GridBlock"
    ],
    "keywords": [
        "text",
        "paragraph",
        "body",
        "typography",
        "lede",
        "caption",
        "emphasis"
    ],
    "dense": "body/inline typography; p by default, polymorphic as (span/strong/em/cite/headings), size + lineHeight ladder shared with Title",
    "usage": {
        "description": "Text owns body and inline typography: paragraphs by default, with a polymorphic as prop for span, strong, em, cite, div and the heading tags when you need a heading shape at body weight. It shares the size and lineHeight ladder with Title, so editorial rhythm stays consistent across the site.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Default to the p element for body copy; switch to as=span for inline positions so paragraphs never nest."
            },
            {
                "guidance": true,
                "description": "Set a lede with size=l and lineHeight=snug directly under a hero Title."
            },
            {
                "guidance": true,
                "description": "Use as=strong or as=em for inline emphasis so screen readers announce the semantics."
            },
            {
                "guidance": true,
                "description": "Use size=xs for captions and metadata."
            },
            {
                "guidance": false,
                "description": "Do not use Text for section headings; headings carry outline semantics Text does not, use Title."
            },
            {
                "guidance": false,
                "description": "Do not label form fields with Text; use Label (htmlFor) and HelperText (aria-describedby)."
            },
            {
                "guidance": false,
                "description": "Do not render code with Text; CodeSnippet and CodeBlockWindow own the monospace ramp."
            }
        ]
    },
    "playground": {
        "defaults": {
            "children": "We design clarity for ambitious teams.",
            "size": "m"
        }
    }
}
