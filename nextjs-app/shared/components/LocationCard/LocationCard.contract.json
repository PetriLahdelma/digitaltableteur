{
    "$schema": "../../../scripts/design-system/contract.schema.json",
    "name": "LocationCard",
    "tier": "molecule",
    "group": "display",
    "status": "alpha",
    "description": "Card variant for displaying a single office or service location (address, hours, map link). Visual sibling of `Card` with the location-specific slot order baked in.",
    "figma": null,
    "radixPrimitive": null,
    "element": "article",
    "variants": {
        "variant": {
            "values": [
                "default",
                "bordered",
                "elevated"
            ],
            "default": "default"
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground"
    ],
    "a11y": {
        "keyboard": [
            "Tab — focuses the embedded action (map link, contact CTA) in order."
        ],
        "ariaRequirements": [
            "Renders an `<article>` so the whole card is announced as a region.",
            "Address content sits inside a real `<address>` element so screen readers identify it as contact information."
        ],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [
            "--color-text",
            "--color-text-muted",
            "--color-surface-elevated"
        ],
        "spacing": [
            "--space-internal-8",
            "--space-internal-12",
            "--space-internal-16"
        ],
        "radii": [
            "--radius-md"
        ]
    },
    "lightDarkVerified": false,
    "consumers": []
}
