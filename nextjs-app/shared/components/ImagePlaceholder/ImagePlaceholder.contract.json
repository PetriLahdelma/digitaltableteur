{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ImagePlaceholder",
    "tier": "molecule",
    "group": "structure",
    "status": "beta",
    "description": "Dimension-labelled placeholder for imagery in layouts, demos, and drafts; swap for real media before shipping.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=1446-2375",
    "radixPrimitive": null,
    "element": "div",
    "variants": {
        "variant": {
            "values": [
                "light",
                "medium",
                "dark",
                "gradient"
            ],
            "default": "light",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "ariaRequirements": [],
        "reviewedNote": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled.",
        "accessibilityTreeVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "width": {
            "optional": false,
            "type": "number",
            "description": "Width in pixels"
        },
        "height": {
            "optional": false,
            "type": "number",
            "description": "Height in pixels"
        },
        "alt": {
            "optional": true,
            "type": "string",
            "description": "Alt text for accessibility"
        },
        "caption": {
            "optional": true,
            "type": "string",
            "description": "Caption text displayed below the image"
        },
        "variant": {
            "optional": true,
            "type": "union",
            "values": [
                "light",
                "medium",
                "dark",
                "gradient"
            ],
            "description": "Background color variant"
        },
        "showDimensions": {
            "optional": true,
            "type": "boolean",
            "description": "Display the dimensions on the placeholder"
        },
        "showIcon": {
            "optional": true,
            "type": "boolean",
            "description": "Display an icon on the placeholder"
        },
        "text": {
            "optional": true,
            "type": "string",
            "description": "Text to display on the placeholder"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Additional CSS class"
        },
        "style": {
            "optional": true,
            "type": "React.CSSProperties",
            "description": "Inline styles"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ],
    "displayName": "ImagePlaceholder",
    "keywords": [
        "placeholder",
        "image",
        "dimensions",
        "mock"
    ],
    "dense": "Fixed-dimension placeholder block for missing/mock imagery in layouts and demos",
    "usage": {
        "description": "Dimension-labelled placeholder for imagery in layouts, demos, and drafts. Swap for real media before shipping."
    }
}
