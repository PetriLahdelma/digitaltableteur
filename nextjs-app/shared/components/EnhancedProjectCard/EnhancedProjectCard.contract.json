    "schemaVersion": 2,
    "props": {
        "title": {
            "optional": false,
            "type": "string",
            "description": "Project title"
        },
        "slug": {
            "optional": false,
            "type": "string",
            "description": "URL slug for project detail page"
        },
        "thumbnail": {
            "optional": false,
            "type": "string",
            "description": "Thumbnail image URL"
        },
        "videoThumbnail": {
            "optional": true,
            "type": "string",
            "description": "Video thumbnail URL (for hover autoplay)"
        },
        "description": {
            "optional": true,
            "type": "string",
            "description": "Short description"
        },
        "category": {
            "optional": true,
            "type": "string",
            "description": "Project category"
        },
        "tags": {
            "optional": true,
            "type": "string[]",
            "description": "Project tags"
        },
        "aspectRatio": {
            "optional": true,
            "type": "union",
            "values": [
                "video",
                "square",
                "portrait",
                "landscape"
            ],
            "description": "Image aspect ratio"
        },
        "showCategory": {
            "optional": true,
            "type": "boolean",
            "description": "Show category in caption"
        },
        "showDescription": {
            "optional": true,
            "type": "boolean",
            "description": "Show description on hover"
        },
        "autoPlayVideo": {
            "optional": true,
            "type": "boolean",
            "description": "Autoplay video thumbnail continuously (not just on hover)"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Custom className"
        }
    },
    "forbiddenUse": [
        "Render both EnhancedProjectCard and ProjectCard in the same index — pick one per grid.",
        "Pass a non-decorative thumbnail without also passing a description (the sr-only span is the only accessible name)."
    ],
    "composesWith": [
        "Container",
        "Section"
    ],
    "displayName": "EnhancedProjectCard",
    "keywords": [
        "portfolio",
        "project",
        "card",
        "video hover",
        "work"
    ],
    "dense": "Portfolio project card w/ image, hover video preview, and metadata; the work-index upgrade of ProjectCard",
    "usage": {
        "description": "Work-index project card with image, hover video preview, and metadata. The richer sibling of ProjectCard; use one per index, not both."
    }
}
