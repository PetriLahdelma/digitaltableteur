{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Title",
    "tier": "atom",
    "group": "display",
    "status": "stable",
    "description": "Semantic heading with size and terminal (serif/sans) variants.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=370-12",
    "radixPrimitive": null,
    "element": "h1",
    "variants": {
        "size": {
            "values": [
                "XXS",
                "XS",
                "S",
                "M",
                "L",
                "XL",
                "XXL"
            ],
            "default": "L",
            "propSourced": true
        },
        "terminals": {
            "values": [
                "sans",
                "serif"
            ],
            "default": "serif",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "use correct heading level via as or level prop"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — heading level, contrast, forced-colors verified in Storybook.",
        "forcedColorsVerified": true,
        "axeTestExempt": "Typography display; axe covered in colocated tests.",
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "id",
        "ref",
        "style"
    ],
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/BlogArticleMdxBody.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleContent.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleMain.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/dev/code-window/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/dev/tailwind-test/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/layout.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/tools/email-signature/EmailSignatureContent.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/tools/email-signature/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/AccessibilityPage/AccessibilityPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/AccessibilityPage/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/AiUsagePage/AiUsagePage.tsx",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "children": {
            "optional": true,
            "type": "ReactI18NextChildren | Iterable<ReactI18NextChildren>"
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "h1",
                "h2",
                "h3",
                "h4",
                "h5",
                "h6"
            ]
        },
        "className": {
            "optional": true,
            "type": "string | undefined"
        },
        "unstyled": {
            "optional": true,
            "type": "boolean"
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "S",
                "M",
                "L",
                "XXS",
                "XS",
                "XL",
                "XXL"
            ]
        },
        "level": {
            "optional": true,
            "type": "1 | 2 | 3 | 4 | 5 | 6"
        },
        "terminals": {
            "optional": true,
            "type": "union",
            "values": [
                "serif",
                "sans"
            ]
        },
        "lineHeight": {
            "optional": true,
            "type": "union",
            "values": [
                "normal",
                "tight",
                "snug",
                "relaxed",
                "loose"
            ]
        }
    },
    "forbiddenUse": [
        "Default Title typography on pattern headings that already define font-display or module classes — use unstyled + existing className",
        "visually size a heading by passing custom inline styles — use the",
        "nest a Title inside a Button. Use the Button's text slot directly."
    ],
    "prefersOver": [
        "raw heading elements"
    ]
}
