{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Title",
    "tier": "atom",
    "group": "display",
    "status": "stable",
    "description": "Semantic heading with size and terminal (serif/sans) variants.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=370-12",
    "radixPrimitive": null,
    "element": "h1",
    "variants": {
        "size": {
            "values": [
                "xxs",
                "xs",
                "s",
                "m",
                "l",
                "xl",
                "xxl"
            ],
            "default": "l",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "use correct heading level via as or level prop"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — heading level, contrast, forced-colors verified in Storybook.",
        "forcedColorsVerified": true,
        "axeTestExempt": "Typography display; axe covered in colocated tests.",
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/BlogArticleMdxBody.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleContent.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/blog/[slug]/ServerArticleMain.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/dev/code-window/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/layout.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/tools/email-signature/EmailSignatureContent.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/tools/email-signature/page.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/AboutPage/AboutPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/AboutPage/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/AccessibilityPage/AccessibilityPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/AccessibilityPage/index.ts",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "displayName": "Title",
    "props": {
        "children": {
            "optional": true,
            "type": "React.ReactNode | ReactI18NextChildren | Iterable<ReactI18NextChildren>",
            "description": "Heading text."
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "h1",
                "h2",
                "h3",
                "h4",
                "h5",
                "h6"
            ],
            "description": "Override the rendered element (h1-h6); wins over level."
        },
        "className": {
            "optional": true,
            "type": "string | undefined",
            "description": "Additional CSS class names."
        },
        "unstyled": {
            "optional": true,
            "type": "boolean",
            "description": "When true, only sets the heading tag + className (no Title token typography). Use in patterns/pages that already define font/size in CSS or Tailwind."
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "s",
                "xl",
                "xs",
                "xxs",
                "m",
                "l",
                "xxl"
            ],
            "description": "Display size token for the heading."
        },
        "level": {
            "optional": true,
            "type": "1 | 2 | 3 | 4 | 5 | 6",
            "description": "Semantic heading level (maps to h1-h6 when as is unset)."
        },
        "lineHeight": {
            "optional": true,
            "type": "union",
            "values": [
                "normal",
                "tight",
                "snug",
                "relaxed",
                "loose"
            ],
            "description": "Line height variant."
        }
    },
    "forbiddenUse": [
        "Default Title typography on pattern headings that already define font-display or module classes — use unstyled + existing className",
        "visually size a heading by passing custom inline styles — use the",
        "nest a Title inside a Button. Use the Button's text slot directly."
    ],
    "prefersOver": [
        "raw heading elements"
    ],
    "composesWith": [
        "Text",
        "ProjectDetailLayout",
        "StoryBlock",
        "ProjectHero",
        "RelatedProjects",
        "ProcessBlock"
    ],
    "keywords": [
        "title",
        "heading",
        "h1",
        "display",
        "serif",
        "section",
        "outline"
    ],
    "dense": "page/section headings; semantic level (h1-h6 via level/as) decoupled from visual size (xxs-xxl); lineHeight ladder shared with Text",
    "usage": {
        "description": "Title renders page and section headings with the semantic level decoupled from the visual scale: pick the h1 to h6 tag with level or as, then choose the size (xxs to xxl) independently, so the document outline stays honest while the layout gets the right optics.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Decide the semantic level from the document outline first, then pick the visual size that fits the layout."
            },
            {
                "guidance": true,
                "description": "Always pass level or as when the page already has an h1; the default tag is h1."
            },
            {
                "guidance": true,
                "description": "Use size m or s for section headers in product chrome, and as=span for display text with no place in the outline."
            },
            {
                "guidance": true,
                "description": "Reach for size xl or xxl on hero headlines; the visual size scales the optics independently of the semantic level."
            },
            {
                "guidance": false,
                "description": "Do not let the visual size choose the heading level; skipped levels break rotor navigation."
            },
            {
                "guidance": false,
                "description": "Do not use Title for body copy or form labels; Text and Label own those semantics."
            }
        ]
    },
    "playground": {
        "defaults": {
            "children": "We design clarity.",
            "as": "h2",
            "size": "l"
        }
    }
}
