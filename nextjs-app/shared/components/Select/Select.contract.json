{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Select",
    "tier": "atom",
    "group": "form",
    "status": "beta",
    "description": "Native select with label, options, error state, and size tokens.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=383-23",
    "radixPrimitive": null,
    "element": "select",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ],
            "default": "md",
            "forwarded": true,
            "forwardedTo": "CSS module size classes"
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Arrow keys",
            "Enter",
            "Space",
            "Tab"
        ],
        "ariaRequirements": [
            "associated label",
            "error announced via HelperText"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-05-26 — production behavior verified in Storybook; argTypes and required stories aligned with validate:components.",
        "forcedColorsVerified": true
    },
    "tokens": {
        "colors": [
            "--color-disabled-bg",
            "--color-error",
            "--color-muted",
            "--color-primary",
            "--color-white"
        ],
        "spacing": [],
        "typography": [
            "--font-text"
        ]
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "as",
        "asChild",
        "children",
        "className",
        "id",
        "ref",
        "size",
        "style"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "label": {
            "optional": false,
            "type": "string"
        },
        "options": {
            "optional": true,
            "type": "SelectOptionItem[]"
        },
        "helperText": {
            "optional": true,
            "type": "string"
        },
        "error": {
            "optional": true,
            "type": "string"
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ]
        },
        "onValueChange": {
            "optional": true,
            "type": "(value: string) => void"
        },
        "onChange": {
            "optional": true,
            "type": "(value: string) => void"
        },
        "disabled": {
            "optional": true,
            "type": "boolean"
        }
    },
    "forbiddenUse": [
        "ship a Select with `value` and `defaultValue` both set —",
        "use Select for a freeform value with suggestions. Use an",
        "wrap the native chevron with a button overlay. The native"
    ],
    "composesWith": [
        "TextInput",
        "Button",
        "CheckboxGroup",
        "Modal",
        "Toast",
        "TextArea"
    ],
    "displayName": "Select",
    "keywords": [
        "select",
        "dropdown",
        "native select",
        "options",
        "picker"
    ],
    "dense": "native select with label, options array or option children, own error + helperText, sm/md/lg; onValueChange(value)",
    "usage": {
        "description": "Select wraps the native select element with the field chrome: label, chevron, helper and error text. Feed it an options array (or option children for grouped markup) and read changes via onValueChange. Native means built-in keyboard support, platform mobile pickers, and zero positioning code.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Use Select for five or more exclusive options, or when space is tight; RadioGroup is better when all options should stay visible."
            },
            {
                "guidance": true,
                "description": "Lead with an empty placeholder option when there is no safe default, and validate it as unselected."
            },
            {
                "guidance": true,
                "description": "Use the options array for flat lists; pass children only when you need optgroups."
            },
            {
                "guidance": true,
                "description": "Keep option labels short; native pickers truncate long labels differently per platform."
            },
            {
                "guidance": false,
                "description": "Do not use Select for search-among-many; Combobox owns typeahead."
            },
            {
                "guidance": false,
                "description": "Do not silently preselect a consequential option (billing plans); make the user choose."
            }
        ]
    },
    "playground": {
        "defaults": {
            "label": "Country",
            "options": [
                {
                    "value": "fi",
                    "label": "Finland"
                },
                {
                    "value": "se",
                    "label": "Sweden"
                },
                {
                    "value": "ee",
                    "label": "Estonia"
                }
            ]
        }
    }
}
