{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Select",
    "tier": "atom",
    "group": "form",
    "status": "stable",
    "description": "Native dropdown select with labelled options, error state, and size tokens.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=383-23",
    "radixPrimitive": null,
    "element": "select",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ],
            "default": "md",
            "forwarded": true,
            "forwardedTo": "CSS module size classes"
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [
            "Arrow keys",
            "Enter",
            "Space",
            "Tab"
        ],
        "ariaRequirements": [
            "associated label",
            "error announced via HelperText"
        ],
        "reducedMotion": true,
        "reviewed": true,
        "reviewedNote": "2026-07-07 — beta→stable: 4-mode AT (base/light/dark/forced-colors) verified on a non-6010 Storybook; accessibility tree and real-browser forced-colors confirmed.",
        "forcedColorsVerified": true,
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [
            "--color-disabled-bg",
            "--color-error",
            "--color-muted",
            "--color-primary",
            "--color-white"
        ],
        "spacing": [],
        "typography": [
            "--font-text"
        ]
    },
    "lightDarkVerified": true,
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "app/layout.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/ContactPage/ContactPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/ContactPage/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/ContactPageContentEditorial/ContactPageContentEditorial.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/ContactPageContentEditorial/index.ts",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "label": {
            "optional": false,
            "type": "string",
            "description": "Label text displayed above the select dropdown"
        },
        "options": {
            "optional": true,
            "type": "SelectOptionItem[]",
            "description": "Option objects with value, label, and optional disabled; children override this"
        },
        "helperText": {
            "optional": true,
            "type": "string",
            "description": "Supporting text under the control; always rendered, below `error` when both are set."
        },
        "error": {
            "optional": true,
            "type": "string",
            "description": "Error message under the control; sets aria-invalid and aria-describedby."
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ],
            "description": "Size variant for select"
        },
        "onValueChange": {
            "optional": true,
            "type": "(value: string) => void",
            "description": "Value change handler (recommended)"
        },
        "disabled": {
            "optional": true,
            "type": "boolean",
            "description": "Disables the select. Declared explicitly (not just via the native attribute extension) so the agent-blocks prop extraction sees it."
        },
        "onChange": {
            "optional": true,
            "type": "(value: string) => void",
            "deprecated": true
        }
    },
    "forbiddenUse": [
        "ship a Select with `value` and `defaultValue` both set —",
        "use Select for a freeform value with suggestions. Use an",
        "wrap the native chevron with a button overlay. The native"
    ],
    "composesWith": [
        "TextInput",
        "Button",
        "CheckboxGroup",
        "Modal",
        "Toast",
        "TextArea"
    ],
    "displayName": "Select",
    "keywords": [
        "dropdown select options",
        "select",
        "dropdown",
        "native select",
        "options",
        "picker"
    ],
    "dense": "native select with label, options array or option children, own error + helperText, sm/md/lg; onValueChange(value)",
    "usage": {
        "description": "Select wraps the native select element with the field chrome: label, chevron, helper and error text. Feed it an options array (or option children for grouped markup) and read changes via onValueChange. Native means built-in keyboard support, platform mobile pickers, and zero positioning code.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Use Select for five or more exclusive options, or when space is tight; RadioGroup is better when all options should stay visible."
            },
            {
                "guidance": true,
                "description": "Lead with an empty placeholder option when there is no safe default, and validate it as unselected."
            },
            {
                "guidance": true,
                "description": "Use the options array for flat lists; pass children only when you need optgroups."
            },
            {
                "guidance": true,
                "description": "Keep option labels short; native pickers truncate long labels differently per platform."
            },
            {
                "guidance": false,
                "description": "Do not use Select for search-among-many; Combobox owns typeahead."
            },
            {
                "guidance": false,
                "description": "Do not silently preselect a consequential option (billing plans); make the user choose."
            }
        ]
    },
    "playground": {
        "defaults": {
            "label": "Country",
            "options": [
                {
                    "value": "fi",
                    "label": "Finland"
                },
                {
                    "value": "se",
                    "label": "Sweden"
                },
                {
                    "value": "ee",
                    "label": "Estonia"
                }
            ]
        }
    }
}
