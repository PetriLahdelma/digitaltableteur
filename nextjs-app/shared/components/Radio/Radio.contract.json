{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Radio",
    "tier": "atom",
    "group": "form",
    "status": "beta",
    "description": "Single radio option; compose with RadioGroup for sets.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=372-27",
    "radixPrimitive": null,
    "element": "div",
    "variants": {
        "size": {
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ],
            "default": "sm",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "reviewedNote": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled."
    },
    "tokens": {
        "colors": [
            "--color-border",
            "--color-primary"
        ],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "label": {
            "optional": false,
            "type": "string"
        },
        "value": {
            "optional": false,
            "type": "string"
        },
        "name": {
            "optional": false,
            "type": "string"
        },
        "checked": {
            "optional": true,
            "type": "boolean"
        },
        "defaultChecked": {
            "optional": true,
            "type": "boolean"
        },
        "disabled": {
            "optional": true,
            "type": "boolean"
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ]
        },
        "onCheckedChange": {
            "optional": true,
            "type": "(checked: boolean) => void"
        },
        "showLabel": {
            "optional": true,
            "type": "boolean"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ],
    "displayName": "Radio",
    "keywords": [
        "radio",
        "radio button",
        "exclusive choice",
        "option"
    ],
    "dense": "single native radio with label and sm/md/lg; controlled via checked + onCheckedChange; use RadioGroup for sets (legend, state, error)",
    "usage": {
        "description": "Radio is one labelled option of an exclusive set. It is a low-level atom: in almost every case reach for RadioGroup, which owns the fieldset legend, the shared name, and the selection state. Use Radio directly only when composing a custom exclusive control.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Give every radio in a set the same name so the browser enforces exclusivity."
            },
            {
                "guidance": true,
                "description": "Prefer RadioGroup for sets; it wires the legend, selection state, and error text."
            },
            {
                "guidance": true,
                "description": "Use defaultChecked for uncontrolled forms that read values on submit."
            },
            {
                "guidance": true,
                "description": "Keep labels short and parallel; the group's legend carries the question."
            },
            {
                "guidance": false,
                "description": "Do not render a lone radio; a choice with one option is a Checkbox."
            },
            {
                "guidance": false,
                "description": "Do not set checked without onCheckedChange; a controlled radio that cannot change traps keyboard users."
            }
        ]
    },
    "playground": {
        "defaults": {
            "label": "Standard delivery",
            "value": "standard",
            "name": "delivery"
        }
    }
}
