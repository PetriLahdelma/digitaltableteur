{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "RadioGroup",
    "tier": "molecule",
    "group": "form",
    "status": "beta",
    "description": "Accessible radio button group with legend and validation.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=1227-2963",
    "radixPrimitive": null,
    "element": "div",
    "variants": {
        "orientation": {
            "values": [
                "vertical",
                "horizontal"
            ],
            "default": "vertical",
            "forwarded": true,
            "forwardedTo": "fieldset layout class in RadioGroup.module.css"
        },
        "size": {
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ],
            "default": "sm",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "reviewedNote": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled."
    },
    "tokens": {
        "colors": [
            "--color-title"
        ],
        "spacing": [
            "--space-internal-8",
            "--space-layout-16"
        ],
        "typography": [
            "--font-size-text-s",
            "--font-text"
        ]
    },
    "lightDarkVerified": true,
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "name": {
            "optional": true,
            "type": "string"
        },
        "legend": {
            "optional": false,
            "type": "string"
        },
        "options": {
            "optional": false,
            "type": "RadioGroupOption[]"
        },
        "value": {
            "optional": true,
            "type": "string"
        },
        "defaultValue": {
            "optional": true,
            "type": "string"
        },
        "onValueChange": {
            "optional": true,
            "type": "(value: string) => void"
        },
        "orientation": {
            "optional": true,
            "type": "union",
            "values": [
                "horizontal",
                "vertical"
            ]
        },
        "size": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "S",
                "M",
                "L"
            ]
        },
        "disabled": {
            "optional": true,
            "type": "boolean"
        },
        "error": {
            "optional": true,
            "type": "string"
        },
        "helperText": {
            "optional": true,
            "type": "string"
        },
        "className": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ],
    "displayName": "RadioGroup",
    "keywords": [
        "radio group",
        "exclusive",
        "single choice",
        "fieldset",
        "options"
    ],
    "dense": "exclusive choice set: fieldset legend, vertical/horizontal, sm/md/lg, own error + helperText; controlled or uncontrolled via onValueChange(value)",
    "usage": {
        "description": "RadioGroup is the standard way to ask for an exclusive choice: it renders a fieldset legend, the labelled radios, helper and error text, and manages the selection in controlled or uncontrolled mode.",
        "bestPractices": [
            {
                "guidance": true,
                "description": "Write the legend as the question (Delivery speed); the options then read as answers."
            },
            {
                "guidance": true,
                "description": "Use it whenever all options should be visible at once; switch to Select when space is tight or options exceed about seven."
            },
            {
                "guidance": true,
                "description": "Preselect the safest common option with defaultValue when a recommendation exists."
            },
            {
                "guidance": true,
                "description": "Use orientation=horizontal only for a few short options that still fit one line on mobile."
            },
            {
                "guidance": false,
                "description": "Do not leave a required group unselected without a recovery plan; users cannot un-pick a radio once one is chosen."
            },
            {
                "guidance": false,
                "description": "Do not use radios for actions or navigation; picking an option must not immediately commit anything."
            }
        ]
    },
    "playground": {
        "defaults": {
            "legend": "Delivery speed",
            "options": [
                {
                    "value": "standard",
                    "label": "Standard (3-5 days)"
                },
                {
                    "value": "express",
                    "label": "Express (1-2 days)"
                },
                {
                    "value": "pickup",
                    "label": "Pickup point"
                }
            ],
            "defaultValue": "standard"
        }
    }
}
