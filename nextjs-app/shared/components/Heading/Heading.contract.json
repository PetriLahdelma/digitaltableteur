{
    "$schema": "../../../scripts/design-system/contract.schema.json",
    "name": "Heading",
    "tier": "atom",
    "group": "display",
    "status": "alpha",
    "description": "Semantic heading primitive (h1–h6) with an explicit visual size axis decoupled from the HTML level so the document outline stays honest.",
    "figma": null,
    "radixPrimitive": null,
    "element": "h2",
    "variants": {
        "level": {
            "values": [
                "1",
                "2",
                "3",
                "4",
                "5",
                "6"
            ],
            "default": "2"
        },
        "size": {
            "values": [
                "display",
                "xl",
                "lg",
                "md",
                "sm",
                "xs"
            ],
            "default": "lg"
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [
            "Always renders an h1–h6 element matching `level`; the visual `size` axis does not change the rendered tag.",
            "Authors are responsible for keeping `level` aligned with the surrounding document outline — `Heading` does not introspect its DOM position."
        ],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [
            "--color-text"
        ],
        "spacing": [],
        "typography": [
            "--font-display",
            "--font-size-display",
            "--font-size-xl",
            "--font-size-lg",
            "--font-size-md",
            "--font-size-sm",
            "--line-height-tight"
        ]
    },
    "lightDarkVerified": false,
    "consumers": []
}
