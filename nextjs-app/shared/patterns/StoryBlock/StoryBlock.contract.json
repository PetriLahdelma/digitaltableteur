{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "StoryBlock",
    "tier": "pattern",
    "group": "structure",
    "status": "beta",
    "description": "StoryBlock — production @dt component (Storybook beta).",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-story-block",
    "radixPrimitive": null,
    "element": "div",
    "variants": {},
    "slots": [
        "content"
    ],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "ariaRequirements": [],
        "reviewedNote": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled."
    },
    "tokens": {
        "colors": [
            "--color-light-bg",
            "--color-white"
        ],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "ariaLabel",
        "as",
        "asChild",
        "backgroundColor",
        "children",
        "className",
        "content",
        "id",
        "imageLayout",
        "images",
        "maxWidth",
        "ref",
        "spacing",
        "style",
        "subtitle",
        "title"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "subtitle": {
            "optional": true,
            "type": "string"
        },
        "title": {
            "optional": false,
            "type": "string"
        },
        "content": {
            "optional": false,
            "type": "React.ReactNode[]"
        },
        "images": {
            "optional": true,
            "type": "StoryImage | StoryImage[]"
        },
        "imageLayout": {
            "optional": true,
            "type": "union",
            "values": [
                "none",
                "grid",
                "single"
            ]
        },
        "backgroundColor": {
            "optional": true,
            "type": "union",
            "values": [
                "light",
                "white",
                "transparent"
            ]
        },
        "maxWidth": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "xl",
                "full"
            ]
        },
        "spacing": {
            "optional": true,
            "type": "union",
            "values": [
                "default",
                "compact",
                "comfortable",
                "spacious"
            ]
        },
        "className": {
            "optional": true,
            "type": "string"
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "article",
                "div",
                "section"
            ]
        },
        "ariaLabel": {
            "optional": true,
            "type": "string"
        }
    },
    "composesWith": [
        "Title",
        "Text",
        "ProjectDetailLayout",
        "ProjectHero",
        "RelatedProjects",
        "ProcessBlock",
        "GridBlock"
    ],
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ]
}
