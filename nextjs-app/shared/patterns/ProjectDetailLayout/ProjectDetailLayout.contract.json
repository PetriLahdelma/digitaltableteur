{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ProjectDetailLayout",
    "tier": "template",
    "group": "layout",
    "status": "alpha",
    "description": "Case study detail layout shell.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-project-detail-layout",
    "radixPrimitive": null,
    "element": "main",
    "variants": {},
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": false,
    "schemaVersion": 2,
    "props": {
        "nav": {
            "optional": true,
            "type": "ReactNode",
            "description": "Navigation slot (top)"
        },
        "hero": {
            "optional": false,
            "type": "ReactNode",
            "description": "Hero section slot"
        },
        "children": {
            "optional": false,
            "type": "ReactNode",
            "description": "Main content sections"
        },
        "cta": {
            "optional": true,
            "type": "ReactNode | null",
            "description": "Call-to-action section slot (between content and related projects). Renders WorkCTA by default. Pass null to suppress."
        },
        "relatedProjects": {
            "optional": true,
            "type": "ReactNode",
            "description": "Related projects section slot"
        },
        "showScrollProgress": {
            "optional": true,
            "type": "boolean",
            "description": "Show scroll progress indicator"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Custom className"
        },
        "donnyTarget": {
            "optional": true,
            "type": "string",
            "description": "Donny site action target id for the project main landmark"
        }
    },
    "forbiddenUse": [
        "invent parallel primitives inside this folder",
        "promote to stable without production consumer evidence"
    ],
    "composesWith": [
        "StoryBlock",
        "ProjectHero",
        "RelatedProjects",
        "GridBlock",
        "ProjectMetaSection",
        "TeamBlock"
    ]
}
