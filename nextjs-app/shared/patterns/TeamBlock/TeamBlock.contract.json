{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "TeamBlock",
    "tier": "pattern",
    "group": "structure",
    "status": "stable",
    "description": "Centred team grid of member cards: an Avatar, the name and the role, plus avatar-size, column and spacing knobs.",
    "dense": "Centred team grid: Avatar, name and role cards with avatar-size, column and spacing knobs.",
    "keywords": [
        "team",
        "members",
        "grid",
        "people",
        "case-study"
    ],
    "usage": {
        "description": "TeamBlock renders a team/people grid: member cards with an Avatar (photo or initials), name and role, plus avatarSize, column and spacing knobs, under an optional section title and description. Rows with fewer members than columns stay centred. Work case studies use it to credit project teams; AboutPageContent has its own team treatment."
    },
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=1437-264",
    "radixPrimitive": null,
    "element": "div",
    "variants": {},
    "slots": [
        "description"
    ],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "ariaRequirements": [],
        "reviewedNote": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled. 2026-07-09 — Promoted beta→stable: AT snapshots captured for all required stories (base mode, pattern-tier convention), forced-colors re-verified in a real browser, consumers audited.",
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [
            "--color-light-bg",
            "--color-white"
        ],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Work/HelsinkiDesignSystem/HelsinkiDesignSystemPage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Work/HelsinkiDesignSystem/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/TeamBlock/index.ts",
            "since": "2026-06-04"
        }
    ],
    "schemaVersion": 2,
    "props": {
        "members": {
            "optional": false,
            "type": "TeamMember[]",
            "description": "Array of team members to display"
        },
        "sectionTitle": {
            "optional": true,
            "type": "string",
            "description": "Optional section title"
        },
        "description": {
            "optional": true,
            "type": "React.ReactNode",
            "description": "Optional description or introduction text"
        },
        "columns": {
            "optional": true,
            "type": "2 | 3 | 4 | 5 | 6",
            "description": "Number of columns for desktop layout (2-6)"
        },
        "backgroundColor": {
            "optional": true,
            "type": "union",
            "values": [
                "transparent",
                "light",
                "white"
            ],
            "description": "Background color variant"
        },
        "maxWidth": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "full",
                "xl"
            ],
            "description": "Maximum width constraint"
        },
        "spacing": {
            "optional": true,
            "type": "union",
            "values": [
                "compact",
                "default",
                "comfortable",
                "spacious"
            ],
            "description": "Spacing variant"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Additional CSS class"
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "article",
                "div",
                "section"
            ],
            "description": "Semantic HTML element to use"
        },
        "ariaLabel": {
            "optional": true,
            "type": "string",
            "description": "Accessible label for the section"
        },
        "avatarSize": {
            "optional": true,
            "type": "string",
            "description": "Avatar diameter as any CSS length (default 7rem)"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ],
    "composesWith": [
        "Text",
        "ProcessBlock",
        "StoryBlock",
        "GridBlock",
        "ProjectDetailLayout",
        "ProjectHero"
    ]
}
