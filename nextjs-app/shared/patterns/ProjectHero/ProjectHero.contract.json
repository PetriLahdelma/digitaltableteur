{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ProjectHero",
    "tier": "pattern",
    "group": "content",
    "status": "alpha",
    "description": "Case study hero with project title and summary.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-project-hero",
    "radixPrimitive": null,
    "element": "div",
    "variants": {
        "variant": {
            "values": [
                "full-width",
                "contained",
                "split"
            ],
            "default": "full-width",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": false,
    "schemaVersion": 2,
    "props": {
        "title": {
            "optional": false,
            "type": "string",
            "description": "Project title"
        },
        "description": {
            "optional": true,
            "type": "string",
            "description": "Project description/tagline"
        },
        "image": {
            "optional": true,
            "type": "ProjectHeroImage",
            "description": "Hero image"
        },
        "video": {
            "optional": true,
            "type": "ProjectHeroVideo",
            "description": "Hero video (takes precedence over image when provided)"
        },
        "category": {
            "optional": true,
            "type": "string",
            "description": "Project category"
        },
        "tags": {
            "optional": true,
            "type": "string[]",
            "description": "Project tags"
        },
        "date": {
            "optional": true,
            "type": "string",
            "description": "Project date/duration"
        },
        "liveUrl": {
            "optional": true,
            "type": "string",
            "description": "Live project URL"
        },
        "variant": {
            "optional": true,
            "type": "union",
            "values": [
                "contained",
                "full-width",
                "split"
            ],
            "description": "Hero layout variant"
        },
        "showScrollIndicator": {
            "optional": true,
            "type": "boolean",
            "description": "Show scroll indicator"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Custom className"
        }
    },
    "forbiddenUse": [
        "invent parallel primitives inside this folder",
        "promote to stable without production consumer evidence"
    ],
    "composesWith": [
        "Title",
        "Text",
        "Button",
        "StoryBlock",
        "ProjectDetailLayout",
        "RelatedProjects",
        "GridBlock",
        "ProjectMetaSection",
        "TeamBlock"
    ]
}
