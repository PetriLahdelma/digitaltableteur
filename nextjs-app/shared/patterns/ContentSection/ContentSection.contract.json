{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ContentSection",
    "tier": "pattern",
    "group": "content",
    "status": "alpha",
    "description": "Generic content section wrapper for marketing pages.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-content-section",
    "radixPrimitive": null,
    "element": "div",
    "variants": {},
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": false,
    "schemaVersion": 2,
    "props": {
        "subtitle": {
            "optional": true,
            "type": "string"
        },
        "title": {
            "optional": false,
            "type": "string"
        },
        "content": {
            "optional": true,
            "type": "ReactNode"
        },
        "images": {
            "optional": true,
            "type": "ContentImage | ContentImage[]"
        },
        "imageLayout": {
            "optional": true,
            "type": "union",
            "values": [
                "single",
                "none",
                "grid",
                "side-by-side"
            ]
        },
        "background": {
            "optional": true,
            "type": "union",
            "values": [
                "default",
                "muted",
                "accent"
            ]
        },
        "centered": {
            "optional": true,
            "type": "boolean"
        },
        "className": {
            "optional": true,
            "type": "string"
        },
        "donnyTarget": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "invent parallel primitives inside this folder",
        "promote to stable without production consumer evidence"
    ]
}
