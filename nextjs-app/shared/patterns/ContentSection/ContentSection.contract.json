{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ContentSection",
    "tier": "pattern",
    "group": "content",
    "status": "alpha",
    "description": "Generic content section wrapper for marketing pages.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-content-section",
    "radixPrimitive": null,
    "element": "div",
    "variants": {},
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": false,
    "schemaVersion": 2,
    "props": {
        "subtitle": {
            "optional": true,
            "type": "string",
            "description": "Subtitle/eyebrow text"
        },
        "title": {
            "optional": false,
            "type": "string",
            "description": "Section title"
        },
        "content": {
            "optional": true,
            "type": "ReactNode",
            "description": "Rich text content (optional)"
        },
        "images": {
            "optional": true,
            "type": "ContentImage | ContentImage[]",
            "description": "Single image or array of images"
        },
        "imageLayout": {
            "optional": true,
            "type": "union",
            "values": [
                "single",
                "none",
                "grid",
                "side-by-side"
            ],
            "description": "Image layout"
        },
        "background": {
            "optional": true,
            "type": "union",
            "values": [
                "default",
                "muted",
                "accent"
            ],
            "description": "Background variant"
        },
        "centered": {
            "optional": true,
            "type": "boolean",
            "description": "Center align text"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Custom className"
        },
        "donnyTarget": {
            "optional": true,
            "type": "string",
            "description": "Donny site action target id for this content block"
        }
    },
    "forbiddenUse": [
        "invent parallel primitives inside this folder",
        "promote to stable without production consumer evidence"
    ]
}
