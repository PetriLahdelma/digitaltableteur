{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ValuesSection",
    "tier": "pattern",
    "group": "marketing",
    "status": "alpha",
    "description": "Studio values section for about page.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-values-section",
    "radixPrimitive": null,
    "element": "div",
    "variants": {
