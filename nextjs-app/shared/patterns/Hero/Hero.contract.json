{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "Hero",
    "tier": "pattern",
    "group": "marketing",
    "status": "beta",
    "description": "Hero — production @dt component (Storybook beta).",
    "dense": "General-purpose hero: title/subtitle/description, optional image and actions; layout variant, background, and align knobs.",
    "keywords": [
        "hero",
        "header",
        "marketing",
        "title",
        "actions"
    ],
    "usage": {
        "description": "Hero is the configurable, general-purpose page hero: heading (with titleLevel control), subtitle/description, optional image, and an actions slot, across layout variants and backgrounds. The homepage uses the bespoke HomeHero instead; use Hero when a route needs a straightforward hero driven by props. For a bare full-bleed shell you fill yourself, use HeroSection."
    },
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-hero",
    "radixPrimitive": null,
    "element": "div",
    "variants": {
        "variant": {
            "values": [
                "default",
                "minimal",
                "centered",
                "split",
                "stacked"
            ],
            "default": "default",
            "propSourced": true
        },
        "align": {
            "values": [
                "center",
                "left",
                "right"
            ],
            "default": "center",
            "propSourced": true
        }
    },
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "ariaRequirements": [],
        "reviewedNote": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled."
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "argTypesProxyExempt": [
        "ariaLabel",
        "as",
        "asChild",
        "children",
        "className",
        "id",
        "ref",
        "style"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "title": {
            "optional": false,
            "type": "string"
        },
        "titleLevel": {
            "optional": true,
            "type": "1 | 2 | 3 | 4 | 5 | 6"
        },
        "subtitle": {
            "optional": true,
            "type": "string"
        },
        "description": {
            "optional": true,
            "type": "string"
        },
        "imageSrc": {
            "optional": true,
            "type": "string"
        },
        "imageAlt": {
            "optional": true,
            "type": "string"
        },
        "imageWidth": {
            "optional": true,
            "type": "number"
        },
        "imageHeight": {
            "optional": true,
            "type": "number"
        },
        "actions": {
            "optional": true,
            "type": "HeroAction[]"
        },
        "variant": {
            "optional": true,
            "type": "union",
            "values": [
                "minimal",
                "default",
                "centered",
                "split",
                "stacked"
            ]
        },
        "background": {
            "optional": true,
            "type": "union",
            "values": [
                "image",
                "light",
                "dark",
                "gradient",
                "transparent"
            ]
        },
        "align": {
            "optional": true,
            "type": "union",
            "values": [
                "center",
                "left",
                "right"
            ]
        },
        "maxWidth": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "full",
                "xl"
            ]
        },
        "spacing": {
            "optional": true,
            "type": "union",
            "values": [
                "default",
                "compact",
                "comfortable",
                "spacious"
            ]
        },
        "className": {
            "optional": true,
            "type": "string"
        },
        "ariaLabel": {
            "optional": true,
            "type": "string"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ]
}
