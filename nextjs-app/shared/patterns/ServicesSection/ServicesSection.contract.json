{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ServicesSection",
    "tier": "pattern",
    "group": "marketing",
    "status": "stable",
    "description": "Homepage services grid with icons and copy.",
    "dense": "Homepage services grid: icon + copy service cards, column count and card variant knobs.",
    "keywords": [
        "services",
        "grid",
        "homepage",
        "cards",
        "marketing"
    ],
    "usage": {
        "description": "ServicesSection is the homepage services grid: icon-led service cards with title/description copy, configurable columns and card variant. It anchors into the homepage band flow (id, donnyTarget) alongside HomeHero, WorkMagneticField, and CTASection. For a case-study scope summary use ServicesBlock instead."
    },
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=1437-246",
    "radixPrimitive": null,
    "element": "div",
    "variants": {},
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default",
        "Playground",
        "Example",
        "ForcedColors"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": true,
        "forcedColorsVerified": true,
        "reviewedNote": "2026-05-28 — Breadth beta port: keyboard/ARIA contract reviewed, ForcedColors story added, Storybook axe gate (parameters.a11y.test: error). 2026-07-09 — Promoted beta→stable: AT snapshots captured for all required stories (base mode, pattern-tier convention), forced-colors re-verified in a real browser, consumers audited.",
        "accessibilityTreeVerified": true,
        "realBrowserForcedColorsVerified": true
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": true,
    "consumers": [
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/components/pages/Home/HomePage.tsx",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/index.ts",
            "since": "2026-06-04"
        },
        {
            "repo": "digitaltableteur/digitaltableteur",
            "path": "nextjs-app/shared/patterns/ServicesSection/index.ts",
            "since": "2026-06-04"
        }
    ],
    "slots": [],
    "schemaVersion": 2,
    "props": {
        "title": {
            "optional": true,
            "type": "string",
            "description": "Section title"
        },
        "description": {
            "optional": true,
            "type": "string",
            "description": "Section description/lead text"
        },
        "services": {
            "optional": false,
            "type": "ServiceItem[]",
            "description": "Array of services to display"
        },
        "columns": {
            "optional": true,
            "type": "2 | 3 | 4",
            "description": "Number of columns (responsive)"
        },
        "cardVariant": {
            "optional": true,
            "type": "union",
            "values": [
                "minimal",
                "default",
                "bordered",
                "elevated"
            ],
            "description": "Card style variant"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Custom className"
        },
        "id": {
            "optional": true,
            "type": "string",
            "description": "Section ID for navigation"
        },
        "donnyTarget": {
            "optional": true,
            "type": "string",
            "description": "Donny site action target id for this section"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ],
    "composesWith": [
        "HomeHero",
        "WorkMagneticField",
        "CTASection",
        "NewsBulletin",
        "DesignSprintsSection",
        "HighlightSection"
    ]
}
