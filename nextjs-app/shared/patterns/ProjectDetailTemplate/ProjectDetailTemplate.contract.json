{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ProjectDetailTemplate",
    "tier": "template",
    "group": "layout",
    "status": "alpha",
    "description": "Full case study page template.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-project-detail-template",
    "radixPrimitive": null,
    "element": "main",
    "variants": {},
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": false,
    "schemaVersion": 2,
    "props": {
        "project": {
            "optional": false,
            "type": "Project",
            "description": "Project data from projects.ts"
        },
        "hero": {
            "optional": false,
            "type": "{\n    image: ProjectHeroImage;\n    variant?: \"full-width\" | \"contained\" | \"split\";\n  }",
            "description": "Hero configuration"
        },
        "meta": {
            "optional": false,
            "type": "{\n    services: string[];\n    duration?: string;\n    tools?: ToolItem[];\n    team?: TeamMember[];\n    client?: ClientInf",
            "description": "Metadata configuration"
        },
        "sections": {
            "optional": false,
            "type": "ContentSectionProps[]",
            "description": "Content sections"
        },
        "gallery": {
            "optional": true,
            "type": "GalleryImage[]",
            "description": "Gallery images"
        },
        "relatedEnabled": {
            "optional": true,
            "type": "boolean",
            "description": "Enable related projects section"
        },
        "nav": {
            "optional": true,
            "type": "ReactNode",
            "description": "Custom navigation element (overrides default ProjectNav)"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Custom className"
        }
    },
    "forbiddenUse": [
        "invent parallel primitives inside this folder",
        "promote to stable without production consumer evidence"
    ]
