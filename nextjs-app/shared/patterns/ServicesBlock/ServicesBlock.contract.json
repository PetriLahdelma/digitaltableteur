        },
        "toolsTitle": {
            "optional": true,
            "type": "string"
        },
        "maxWidth": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "xl",
                "full"
            ]
        },
        "spacing": {
            "optional": true,
            "type": "union",
            "values": [
                "default",
                "compact",
                "comfortable",
                "spacious"
            ]
        },
        "className": {
            "optional": true,
            "type": "string"
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "article",
                "div",
                "section"
            ]
        },
        "ariaLabel": {
            "optional": true,
            "type": "string"
        }
    }
