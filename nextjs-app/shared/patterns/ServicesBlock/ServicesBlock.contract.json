        "services",
        "servicesTitle",
        "spacing",
        "style",
        "tools",
        "toolsTitle"
    ],
    "consumers": [],
    "schemaVersion": 2,
    "props": {
        "services": {
            "optional": true,
            "type": "ServiceItem[]"
        },
        "duration": {
            "optional": true,
            "type": "string"
        },
        "tools": {
            "optional": true,
            "type": "ToolIcon[]"
        },
        "overviewTitle": {
            "optional": true,
            "type": "string"
        },
