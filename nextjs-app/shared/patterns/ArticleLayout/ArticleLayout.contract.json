{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ArticleLayout",
    "tier": "template",
    "group": "layout",
    "status": "alpha",
    "description": "Blog article page layout shell.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-article-layout",
    "radixPrimitive": null,
    "element": "main",
    "variants": {},
    "slots": [],
    "asChild": false,
    "subParts": [],
    "requiredStories": [
        "Default"
    ],
    "a11y": {
        "keyboard": [],
        "ariaRequirements": [],
        "reducedMotion": true,
        "reviewed": false,
        "forcedColorsVerified": false
    },
    "tokens": {
        "colors": [],
        "spacing": []
    },
    "lightDarkVerified": false,
    "schemaVersion": 2,
    "props": {
        "nav": {
            "optional": true,
            "type": "ReactNode",
            "description": "Navigation slot (back link, etc.)"
        },
        "hero": {
            "optional": false,
            "type": "ReactNode",
            "description": "Hero section"
        },
        "children": {
            "optional": false,
            "type": "ReactNode",
            "description": "Main content area"
        },
        "sidebar": {
            "optional": true,
            "type": "ReactNode",
            "description": "Sidebar content (TOC, etc.)"
        },
        "relatedPosts": {
            "optional": true,
            "type": "ReactNode",
            "description": "Related posts section"
        },
        "showReadingProgress": {
            "optional": true,
            "type": "boolean",
            "description": "Show reading progress indicator"
        },
        "contentRef": {
            "optional": true,
            "type": "RefObject<HTMLElement | null>",
            "description": "Ref for reading progress tracking"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Custom className"
        },
        "lang": {
            "optional": true,
            "type": "string",
            "description": "Document language for the article root"
        }
    },
    "forbiddenUse": [
        "invent parallel primitives inside this folder",
        "promote to stable without production consumer evidence"
    ]
}
