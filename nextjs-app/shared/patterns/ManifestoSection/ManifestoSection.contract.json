{
    "$schema": "../../../scripts/design-system/contract.schema.v2.json",
    "name": "ManifestoSection",
    "tier": "pattern",
    "group": "content",
    "status": "alpha",
    "description": "Long-form manifesto prose section.",
    "figma": "https://www.figma.com/design/PC2UPdYwm8qGt6ZTg0AakF/DT-Site-stuff?node-id=dt-manifesto-section",
    "radixPrimitive": null,
