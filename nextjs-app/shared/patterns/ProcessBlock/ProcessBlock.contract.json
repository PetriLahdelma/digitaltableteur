    "schemaVersion": 2,
    "props": {
        "phases": {
            "optional": false,
            "type": "ProcessPhase[]",
            "description": "Array of process phases to display"
        },
        "sectionTitle": {
            "optional": true,
            "type": "string",
            "description": "Optional main title for the process section"
        },
        "description": {
            "optional": true,
            "type": "React.ReactNode",
            "description": "Optional description or introduction text"
        },
        "backgroundColor": {
            "optional": true,
            "type": "union",
            "values": [
                "transparent",
                "light",
                "white"
            ],
            "description": "Background color variant"
        },
        "maxWidth": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "xl",
                "full"
            ],
            "description": "Maximum width constraint"
        },
        "spacing": {
            "optional": true,
            "type": "union",
            "values": [
                "default",
                "compact",
                "comfortable",
                "spacious"
            ],
            "description": "Spacing variant"
        },
        "columns": {
            "optional": true,
            "type": "2 | 3 | 4",
            "description": "Number of columns (2, 3, or 4)"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Additional CSS class"
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "article",
                "div",
                "section"
            ],
            "description": "Semantic HTML element to use"
        },
        "ariaLabel": {
            "optional": true,
            "type": "string",
            "description": "Accessible label for the section"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ],
    "composesWith": [
        "Text",
        "StoryBlock",
        "ProjectDetailLayout",
        "ProjectHero",
        "RelatedProjects",
        "GridBlock"
    ]
}
