    "schemaVersion": 2,
    "props": {
        "cells": {
            "optional": false,
            "type": "GridCell[]",
            "description": "Array of grid cells to render"
        },
        "columns": {
            "optional": true,
            "type": "1 | 2 | 3 | 4",
            "description": "Number of columns in the grid"
        },
        "gap": {
            "optional": true,
            "type": "union",
            "values": [
                "none",
                "small",
                "medium",
                "large"
            ],
            "description": "Gap between cells"
        },
        "backgroundColor": {
            "optional": true,
            "type": "union",
            "values": [
                "transparent",
                "light",
                "white"
            ],
            "description": "Background color variant"
        },
        "maxWidth": {
            "optional": true,
            "type": "union",
            "values": [
                "sm",
                "md",
                "lg",
                "xl",
                "full"
            ],
            "description": "Maximum width constraint"
        },
        "spacing": {
            "optional": true,
            "type": "union",
            "values": [
                "default",
                "compact",
                "comfortable",
                "spacious"
            ],
            "description": "Spacing variant"
        },
        "className": {
            "optional": true,
            "type": "string",
            "description": "Additional CSS class"
        },
        "as": {
            "optional": true,
            "type": "union",
            "values": [
                "article",
                "div",
                "section"
            ],
            "description": "Semantic HTML element to use"
        }
    },
    "forbiddenUse": [
        "Bypass design tokens or skip forced-colors verification at beta."
    ],
    "composesWith": [
        "Text",
        "StoryBlock",
        "ProjectDetailLayout",
        "ProjectHero",
        "RelatedProjects",
        "ProcessBlock"
    ]
}
