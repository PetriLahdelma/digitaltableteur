{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "ease": {
    "out": {
      "expo": {
        "$value": "cubic-bezier(\n    0.16,\n    1,\n    0.3,\n    1\n  )",
        "$description": "Cubic-bezier easing curve (out-expo).",
        "$type": "cubicBezier",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--ease-out-expo",
            "category": "motion",
            "subgroup": "General"
          }
        }
      },
      "quart": {
        "$value": "cubic-bezier(\n    0.25,\n    1,\n    0.5,\n    1\n  )",
        "$description": "Cubic-bezier easing curve (out-quart).",
        "$type": "cubicBezier",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--ease-out-quart",
            "category": "motion",
            "subgroup": "General"
          }
        }
      },
      "cubic": {
        "$value": "cubic-bezier(\n    0.33,\n    1,\n    0.68,\n    1\n  )",
        "$description": "Cubic-bezier easing curve (out-cubic).",
