        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--ease-out-cubic",
            "category": "motion",
            "subgroup": "General"
          }
        }
      }
    },
    "in": {
      "out": {
        "quart": {
          "$value": "cubic-bezier(\n    0.76,\n    0,\n    0.24,\n    1\n  )",
          "$description": "Cubic-bezier easing curve (in-out-quart).",
          "$type": "cubicBezier",
          "$extensions": {
            "digitaltableteur": {
              "cssVar": "--ease-in-out-quart",
              "category": "motion",
              "subgroup": "General"
            }
          }
        },
        "expo": {
          "$value": "cubic-bezier(\n    0.87,\n    0,\n    0.13,\n    1\n  )",
          "$description": "Cubic-bezier easing curve (in-out-expo).",
          "$type": "cubicBezier",
          "$extensions": {
            "digitaltableteur": {
              "cssVar": "--ease-in-out-expo",
              "category": "motion",
              "subgroup": "General"
            }
          }
        }
      }
    },
    "spring": {
      "$value": "cubic-bezier(\n    0.34,\n    1.56,\n    0.64,\n    1\n  )",
      "$description": "Cubic-bezier easing curve (spring).",
