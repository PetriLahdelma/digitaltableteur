{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "breakpoint": {
    "mobile": {
      "$value": "480px",
      "$description": "Responsive breakpoint reference for media queries.",
      "$type": "dimension",
      "$extensions": {
        "digitaltableteur": {
          "cssVar": "--breakpoint-mobile",
          "category": "layout",
          "subgroup": "General"
        }
      }
    },
    "tablet": {
      "$value": "768px",
      "$description": "Responsive breakpoint reference for media queries.",
      "$type": "dimension",
      "$extensions": {
        "digitaltableteur": {
          "cssVar": "--breakpoint-tablet",
          "category": "layout",
          "subgroup": "General"
        }
      }
    },
    "desktop": {
      "$value": "1024px",
      "$description": "Responsive breakpoint reference for media queries.",
      "$type": "dimension",
      "$extensions": {
        "digitaltableteur": {
          "cssVar": "--breakpoint-desktop",
          "category": "layout",
          "subgroup": "General"
        }
      }
    },
    "wide": {
      "$value": "1440px",
      "$description": "Responsive breakpoint reference for media queries.",
      "$type": "dimension",
      "$extensions": {
        "digitaltableteur": {
          "cssVar": "--breakpoint-wide",
          "category": "layout",
          "subgroup": "General"
        }
      }
