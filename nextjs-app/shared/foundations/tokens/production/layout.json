{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "com.digitaltableteur": {
      "nonDtcg": [
        {
          "cssVar": "--container-full",
          "css": "100%",
          "reason": "\"100%\" is not a px/rem dimension"
        }
      ]
    }
  },
  "breakpoint": {
    "mobile": {
      "$value": {
        "value": 480,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Responsive breakpoint reference for media queries.",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--breakpoint-mobile",
          "category": "layout",
          "subgroup": "General",
          "css": "480px"
        }
      }
    },
    "tablet": {
      "$value": {
        "value": 768,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Responsive breakpoint reference for media queries.",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--breakpoint-tablet",
          "category": "layout",
          "subgroup": "General",
          "css": "768px"
        }
      }
    },
    "desktop": {
      "$value": {
        "value": 1024,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Responsive breakpoint reference for media queries.",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--breakpoint-desktop",
          "category": "layout",
          "subgroup": "General",
          "css": "1024px"
        }
      }
    },
    "wide": {
      "$value": {
        "value": 1440,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Responsive breakpoint reference for media queries.",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--breakpoint-wide",
          "category": "layout",
          "subgroup": "General",
          "css": "1440px"
        }
      }
    },
    "ultra": {
      "$value": {
        "value": 1920,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Responsive breakpoint reference for media queries.",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--breakpoint-ultra",
          "category": "layout",
          "subgroup": "General",
          "css": "1920px"
        }
      }
    }
  },
