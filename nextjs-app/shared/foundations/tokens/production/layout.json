        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--grid-gap-tablet",
            "category": "layout",
            "subgroup": "General"
          }
        }
      },
      "desktop": {
        "$value": "var(--space-layout-32)",
        "$description": "Grid system token (columns or gap).",
        "$type": "dimension",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--grid-gap-desktop",
            "category": "layout",
            "subgroup": "General"
          }
        }
      }
    }
  },
