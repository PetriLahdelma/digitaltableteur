      "desktop": {
        "$value": "var(--space-layout-48)",
        "$description": "Horizontal page margin at a viewport tier.",
        "$type": "dimension",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--page-margin-desktop",
            "category": "layout",
