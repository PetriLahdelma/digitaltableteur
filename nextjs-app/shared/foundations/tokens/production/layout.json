      },
      "tablet": {
        "$value": "var(--space-layout-32)",
        "$description": "Horizontal page margin at a viewport tier.",
        "$type": "dimension",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--page-margin-tablet",
            "category": "layout",
            "subgroup": "General"
          }
        }
