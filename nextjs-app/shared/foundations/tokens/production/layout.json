  "rhythm": {
    "base": {
      "$value": {
        "value": 0.5,
        "unit": "rem"
      },
      "$type": "dimension",
      "$description": "Production token --rhythm-base",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--rhythm-base",
          "category": "layout",
          "subgroup": "General",
          "css": "0.5rem"
