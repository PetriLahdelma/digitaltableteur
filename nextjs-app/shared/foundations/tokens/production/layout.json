  "grid": {
    "columns": {
      "mobile": {
        "$value": "4",
        "$description": "Grid system token (columns or gap).",
        "$type": "number",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--grid-columns-mobile",
            "category": "layout",
            "subgroup": "General"
          }
        }
      },
      "tablet": {
        "$value": "8",
        "$description": "Grid system token (columns or gap).",
        "$type": "number",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--grid-columns-tablet",
            "category": "layout",
            "subgroup": "General"
          }
        }
      },
      "desktop": {
        "$value": "12",
        "$description": "Grid system token (columns or gap).",
        "$type": "number",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--grid-columns-desktop",
            "category": "layout",
            "subgroup": "General"
          }
        }
      }
    },
    "gap": {
      "mobile": {
        "$value": "var(--space-layout-16)",
        "$description": "Grid system token (columns or gap).",
        "$type": "dimension",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--grid-gap-mobile",
            "category": "layout",
            "subgroup": "General"
          }
        }
      },
      "tablet": {
        "$value": "var(--space-layout-24)",
        "$description": "Grid system token (columns or gap).",
