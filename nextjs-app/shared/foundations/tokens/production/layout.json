  "grid": {
    "columns": {
      "mobile": {
        "$value": 4,
        "$type": "number",
        "$description": "Grid system token (columns or gap).",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--grid-columns-mobile",
            "category": "layout",
            "subgroup": "General",
            "css": "4"
          }
        }
      },
      "tablet": {
        "$value": 8,
        "$type": "number",
        "$description": "Grid system token (columns or gap).",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--grid-columns-tablet",
            "category": "layout",
            "subgroup": "General",
            "css": "8"
          }
        }
      },
      "desktop": {
        "$value": 12,
        "$type": "number",
        "$description": "Grid system token (columns or gap).",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--grid-columns-desktop",
            "category": "layout",
            "subgroup": "General",
            "css": "12"
          }
        }
      }
    },
    "gap": {
      "mobile": {
        "$value": "{space.layout.16}",
        "$type": "dimension",
        "$description": "Grid system token (columns or gap).",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--grid-gap-mobile",
            "category": "layout",
            "subgroup": "General",
            "css": "var(--space-layout-16)"
          }
        }
      },
      "tablet": {
        "$value": "{space.layout.24}",
        "$type": "dimension",
        "$description": "Grid system token (columns or gap).",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--grid-gap-tablet",
            "category": "layout",
            "subgroup": "General",
            "css": "var(--space-layout-24)"
          }
        }
      },
      "desktop": {
        "$value": "{space.layout.32}",
        "$type": "dimension",
        "$description": "Grid system token (columns or gap).",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--grid-gap-desktop",
            "category": "layout",
            "subgroup": "General",
            "css": "var(--space-layout-32)"
          }
        }
      }
    }
  },
  "page": {
    "margin": {
      "mobile": {
        "$value": "{space.layout.16}",
        "$type": "dimension",
        "$description": "Horizontal page margin at a viewport tier.",
        "$extensions": {
