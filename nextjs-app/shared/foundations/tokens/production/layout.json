    "md": {
      "$value": "960px",
      "$description": "Max inline size for content containers.",
      "$type": "dimension",
      "$extensions": {
        "digitaltableteur": {
          "cssVar": "--container-md",
          "category": "layout",
          "subgroup": "General"
        }
      }
    },
    "lg": {
      "$value": "1200px",
      "$description": "Max inline size for content containers.",
      "$type": "dimension",
      "$extensions": {
