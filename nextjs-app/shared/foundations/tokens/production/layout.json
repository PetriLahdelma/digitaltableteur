      "mobile": {
        "$value": "var(--space-layout-16)",
        "$description": "Horizontal page margin at a viewport tier.",
        "$type": "dimension",
        "$extensions": {
          "digitaltableteur": {
            "cssVar": "--page-margin-mobile",
            "category": "layout",
            "subgroup": "General"
          }
