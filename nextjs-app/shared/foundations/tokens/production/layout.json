      "$extensions": {
        "digitaltableteur": {
          "cssVar": "--container-xl",
          "category": "layout",
          "subgroup": "General"
        }
      }
    },
    "full": {
      "$value": "100%",
      "$description": "Max inline size for content containers.",
      "$type": "dimension",
      "$extensions": {
        "digitaltableteur": {
          "cssVar": "--container-full",
          "category": "layout",
          "subgroup": "General"
        }
      }
    }
