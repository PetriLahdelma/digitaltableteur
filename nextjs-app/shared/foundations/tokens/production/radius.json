{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "com.digitaltableteur": {
      "nonDtcg": [
        {
          "cssVar": "--radius-circle",
          "css": "50%",
          "reason": "\"50%\" is not a px/rem dimension"
        }
      ]
    }
  },
  "radius": {
    "sm": {
      "$value": {
        "value": 2,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Border radius (sm).",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--radius-sm",
          "category": "radius",
          "subgroup": "General",
          "css": "2px"
        }
      }
    },
    "md": {
      "$value": {
        "value": 4,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Border radius (md).",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--radius-md",
          "category": "radius",
          "subgroup": "General",
          "css": "4px"
        }
      }
    },
    "lg": {
      "$value": {
        "value": 8,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Border radius (lg).",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--radius-lg",
          "category": "radius",
          "subgroup": "General",
          "css": "8px"
        }
      }
    },
    "xl": {
      "$value": {
        "value": 16,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Border radius (xl).",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--radius-xl",
          "category": "radius",
          "subgroup": "General",
          "css": "16px"
        }
      }
    },
    "full": {
      "$value": {
        "value": 9999,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Border radius (full).",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--radius-full",
          "category": "radius",
          "subgroup": "General",
          "css": "9999px"
        }
      }
    }
  }
}
