{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "focus": {
    "ring": {
      "color": {
        "$value": {
          "$ref": "#/color/primary/$root/$value"
        },
        "$type": "color",
        "$description": "Keyboard focus outline color (WCAG focus appearance).",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--focus-ring-color",
            "category": "focus",
            "subgroup": "General",
            "css": "var(--color-primary)"
          }
        }
      },
      "width": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$type": "dimension",
        "$description": "Focus ring token for keyboard accessibility.",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--focus-ring-width",
            "category": "focus",
            "subgroup": "General",
            "css": "2px"
          }
        }
      },
      "offset": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$type": "dimension",
        "$description": "Focus ring token for keyboard accessibility.",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--focus-ring-offset",
            "category": "focus",
            "subgroup": "General",
            "css": "2px"
          }
        }
      }
    }
  }
}
