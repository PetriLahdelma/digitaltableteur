{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": {
    "com.digitaltableteur": {
      "nonDtcg": [
        {
          "cssVar": "--font-title",
          "css": "var(--font-heading), system-ui, sans-serif",
          "reason": "font stack starts from --font-heading, which next/font sets at runtime (not in variables.css)"
        },
        {
          "cssVar": "--font-text",
          "css": "var(--font-body), system-ui, sans-serif",
          "reason": "font stack starts from --font-body, which next/font sets at runtime (not in variables.css)"
        },
        {
          "cssVar": "--measure-reading",
          "css": "30em",
          "reason": "\"30em\" is not a px/rem dimension"
        },
        {
          "cssVar": "--line-height-code-s",
          "css": "1.125rem",
          "reason": "\"1.125rem\" is not a unitless number"
        },
        {
          "cssVar": "--line-height-code-m",
          "css": "1.25rem",
          "reason": "\"1.25rem\" is not a unitless number"
        },
        {
          "cssVar": "--line-height-code-row",
          "css": "1.375rem",
          "reason": "\"1.375rem\" is not a unitless number"
        },
        {
          "cssVar": "--tracking-tighter",
          "css": "-0.05em",
          "reason": "\"-0.05em\" is not a px/rem dimension"
        },
        {
          "cssVar": "--tracking-tight",
          "css": "-0.025em",
          "reason": "\"-0.025em\" is not a px/rem dimension"
        },
        {
          "cssVar": "--tracking-wide",
          "css": "0.025em",
          "reason": "\"0.025em\" is not a px/rem dimension"
        },
        {
          "cssVar": "--tracking-wider",
          "css": "0.05em",
          "reason": "\"0.05em\" is not a px/rem dimension"
        },
        {
          "cssVar": "--tracking-widest",
          "css": "0.1em",
          "reason": "\"0.1em\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-text",
          "css": "var(--font-size-text-m)",
          "reason": "\"clamp(1.125rem, 0.208vi + 1.0833rem, 1.25rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-text-s",
          "css": "clamp(1rem, 0.208vi + 0.9583rem, 1.125rem)",
          "reason": "\"clamp(1rem, 0.208vi + 0.9583rem, 1.125rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-text-m",
          "css": "clamp(1.125rem, 0.208vi + 1.0833rem, 1.25rem)",
          "reason": "\"clamp(1.125rem, 0.208vi + 1.0833rem, 1.25rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-text-l",
          "css": "clamp(1.25rem, 0.417vi + 1.1667rem, 1.5rem)",
          "reason": "\"clamp(1.25rem, 0.417vi + 1.1667rem, 1.5rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-text-xl",
          "css": "clamp(1.5rem, 0.833vi + 1.3333rem, 2rem)",
          "reason": "\"clamp(1.5rem, 0.833vi + 1.3333rem, 2rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-text-xxl",
          "css": "clamp(2rem, 0.833vi + 1.8333rem, 2.5rem)",
          "reason": "\"clamp(2rem, 0.833vi + 1.8333rem, 2.5rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-title",
          "css": "clamp(2.25rem, 3.5vi + 1.5rem, 3.75rem)",
          "reason": "\"clamp(2.25rem, 3.5vi + 1.5rem, 3.75rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-title-xxs",
          "css": "clamp(1.125rem, 0.4vi + 1.05rem, 1.375rem)",
          "reason": "\"clamp(1.125rem, 0.4vi + 1.05rem, 1.375rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-title-xs",
          "css": "clamp(1.25rem, 0.9vi + 1.1rem, 1.75rem)",
          "reason": "\"clamp(1.25rem, 0.9vi + 1.1rem, 1.75rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-title-s",
          "css": "clamp(1.5rem, 2vi + 1.1rem, 2.25rem)",
          "reason": "\"clamp(1.5rem, 2vi + 1.1rem, 2.25rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-title-m",
          "css": "clamp(1.75rem, 2.8vi + 1.3rem, 3rem)",
          "reason": "\"clamp(1.75rem, 2.8vi + 1.3rem, 3rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-title-l",
          "css": "clamp(2rem, 5vi + 1rem, 4.25rem)",
          "reason": "\"clamp(2rem, 5vi + 1rem, 4.25rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-title-xl",
          "css": "clamp(2.25rem, 9vi + 0.5rem, 5.5rem)",
          "reason": "\"clamp(2.25rem, 9vi + 0.5rem, 5.5rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-title-xxl",
          "css": "clamp(4.5rem, 8vi + 3rem, 7rem)",
          "reason": "\"clamp(4.5rem, 8vi + 3rem, 7rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-display",
          "css": "clamp(\n    5rem,\n    10vi + 3rem,\n    8rem\n  )",
          "reason": "\"clamp( 5rem, 10vi + 3rem, 8rem )\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-display-xl",
          "css": "clamp(\n    6rem,\n    14vi + 3rem,\n    12rem\n  )",
          "reason": "\"clamp( 6rem, 14vi + 3rem, 12rem )\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-button-s",
          "css": "clamp(0.875rem, 0.3vi + 0.8rem, 1rem)",
          "reason": "\"clamp(0.875rem, 0.3vi + 0.8rem, 1rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-button-m",
          "css": "clamp(1rem, 0.35vi + 0.9rem, 1.125rem)",
          "reason": "\"clamp(1rem, 0.35vi + 0.9rem, 1.125rem)\" is not a px/rem dimension"
        },
        {
          "cssVar": "--font-size-button-l",
          "css": "clamp(1.125rem, 0.45vi + 1rem, 1.25rem)",
          "reason": "\"clamp(1.125rem, 0.45vi + 1rem, 1.25rem)\" is not a px/rem dimension"
        }
      ]
    }
  },
  "font": {
    "mono": {
      "$value": [
        "var(--font-code, source-code-pro)",
        "menlo",
        "monaco",
        "consolas",
        "Courier New",
        "monospace"
      ],
      "$type": "fontFamily",
      "$description": "Monospace font stack for code and technical UI.",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--font-mono",
          "category": "typography",
          "subgroup": "Families & aliases",
          "css": "var(--font-code, source-code-pro), menlo, monaco, consolas, \"Courier New\", monospace"
        }
      }
    },
    "size": {
      "text": {
        "xxs": {
          "$value": {
            "value": 0.875,
            "unit": "rem"
          },
          "$type": "dimension",
          "$description": "Fluid type size token (text-xxs); uses clamp().",
          "$extensions": {
            "com.digitaltableteur": {
              "cssVar": "--font-size-text-xxs",
              "category": "typography",
              "subgroup": "Type scale",
              "css": "0.875rem"
            }
          }
        },
        "xs": {
          "$value": {
            "value": 1,
            "unit": "rem"
          },
          "$type": "dimension",
          "$description": "Fluid type size token (text-xs); uses clamp().",
          "$extensions": {
            "com.digitaltableteur": {
              "cssVar": "--font-size-text-xs",
              "category": "typography",
              "subgroup": "Type scale",
              "css": "1rem"
            }
          }
        }
      },
      "disclaimer": {
        "$value": "{font.size.text.xs}",
        "$type": "dimension",
        "$description": "12px, for disclaimer copy only (price terms, legal small print). Below the 14px text-scale floor on purpose; never for body, UI or captions.",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--font-size-disclaimer",
            "category": "typography",
            "subgroup": "Type scale",
            "css": "var(--font-size-text-xs)"
          }
        }
      },
      "code": {
        "xs": {
          "$value": {
            "value": 0.75,
            "unit": "rem"
          },
          "$type": "dimension",
          "$description": "Fluid type size token (code-xs); uses clamp().",
          "$extensions": {
            "com.digitaltableteur": {
              "cssVar": "--font-size-code-xs",
              "category": "typography",
              "subgroup": "Type scale",
              "css": "0.75rem"
            }
          }
        },
        "s": {
          "$value": {
            "value": 0.8125,
            "unit": "rem"
          },
          "$type": "dimension",
          "$description": "Fluid type size token (code-s); uses clamp().",
          "$extensions": {
            "com.digitaltableteur": {
              "cssVar": "--font-size-code-s",
              "category": "typography",
              "subgroup": "Type scale",
              "css": "0.8125rem"
            }
          }
        },
        "m": {
          "$value": {
            "value": 0.875,
            "unit": "rem"
          },
          "$type": "dimension",
          "$description": "Fluid type size token (code-m); uses clamp().",
          "$extensions": {
            "com.digitaltableteur": {
              "cssVar": "--font-size-code-m",
              "category": "typography",
              "subgroup": "Type scale",
              "css": "0.875rem"
            }
          }
        },
        "l": {
          "$value": {
            "value": 1,
            "unit": "rem"
          },
          "$type": "dimension",
          "$description": "Fluid type size token (code-l); uses clamp().",
          "$extensions": {
            "com.digitaltableteur": {
              "cssVar": "--font-size-code-l",
              "category": "typography",
              "subgroup": "Type scale",
              "css": "1rem"
            }
          }
        }
      }
    },
    "weight": {
      "title": {
        "$value": 700,
        "$type": "fontWeight",
        "$description": "Production token --font-weight-title",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--font-weight-title",
            "category": "typography",
            "subgroup": "Weight",
            "css": "700"
          }
        }
      },
      "medium": {
        "$value": 500,
        "$type": "fontWeight",
        "$description": "Production token --font-weight-medium",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--font-weight-medium",
            "category": "typography",
            "subgroup": "Weight",
            "css": "500"
          }
        }
      },
      "text": {
        "$value": 400,
        "$type": "fontWeight",
        "$description": "Production token --font-weight-text",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--font-weight-text",
            "category": "typography",
            "subgroup": "Weight",
            "css": "400"
          }
        }
      }
    }
  },
  "tracking": {
    "normal": {
      "$value": {
        "value": 0,
        "unit": "px"
      },
      "$type": "dimension",
      "$description": "Letter-spacing for normal display/heading styles.",
      "$extensions": {
        "com.digitaltableteur": {
          "cssVar": "--tracking-normal",
          "category": "typography",
          "subgroup": "Rhythm",
          "css": "0"
        }
      }
    }
  },
  "line": {
    "height": {
      "tight": {
        "$value": 1.2,
        "$type": "number",
        "$description": "Line-height for tight typography rhythm.",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--line-height-tight",
            "category": "typography",
            "subgroup": "Rhythm",
            "css": "1.2"
          }
        }
      },
      "snug": {
        "$value": 1.375,
        "$type": "number",
        "$description": "Line-height for snug typography rhythm.",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--line-height-snug",
            "category": "typography",
            "subgroup": "Rhythm",
            "css": "1.375"
          }
        }
      },
      "normal": {
        "$value": 1.5,
        "$type": "number",
        "$description": "Line-height for normal typography rhythm.",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--line-height-normal",
            "category": "typography",
            "subgroup": "Rhythm",
            "css": "1.5"
          }
        }
      },
      "relaxed": {
        "$value": 1.625,
        "$type": "number",
        "$description": "Line-height for relaxed typography rhythm.",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--line-height-relaxed",
            "category": "typography",
            "subgroup": "Rhythm",
            "css": "1.625"
          }
        }
      },
      "loose": {
        "$value": 1.75,
        "$type": "number",
        "$description": "Line-height for loose typography rhythm.",
        "$extensions": {
          "com.digitaltableteur": {
            "cssVar": "--line-height-loose",
            "category": "typography",
            "subgroup": "Rhythm",
            "css": "1.75"
          }
        }
      }
    }
  }
}
