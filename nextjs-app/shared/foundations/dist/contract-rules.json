    "Button": {
      "propRelationships": [
        {
          "kind": "mutuallyExclusive",
          "props": [
            "href",
            "submits"
          ],
          "reason": "`href` and `submits` never coexist in a valid ButtonProps branch."
        },
        {
          "kind": "mutuallyExclusive",
          "props": [
            "clickAction",
            "href"
          ],
          "reason": "`clickAction` and `href` never coexist in a valid ButtonProps branch."
        },
        {
          "kind": "requires",
          "prop": "target",
          "requires": [
            "href"
          ],
          "reason": "Whenever `target` is accepted by ButtonProps, `href` must also be present."
        },
        {
          "kind": "requires",
          "prop": "rel",
          "requires": [
            "href"
          ],
          "reason": "Whenever `rel` is accepted by ButtonProps, `href` must also be present."
        }
      ],
      "forbiddenCombos": [
        {
          "id": "button-icon-only-needs-name",
          "when": {
            "icon": {
              "present": true
            },
            "children": {
              "absent": true
            }
          },
          "requireAnyOf": [
            "accessibleName",
            "accessibleNameRef",
            "tooltip",
            "aria-label"
          ],
          "reason": "An icon-only button has no accessible name. Add accessibleName, accessibleNameRef, or tooltip, e.g. <Button icon=\"search\" accessibleName=\"Search\" />.",
          "severity": "error",
          "evidence": "Button.tsx development warning (isIconOnly && !hasAccessibleName)"
        }
      ]
    },
    "ButtonGroup": {},
