            }
          },
          "forbid": [
            "animated",
            "background"
          ],
          "reason": "`animated` and `background` style the built-in mark only; with `src` set they are ignored.",
          "severity": "warning",
          "evidence": "Logo.tsx src branch returns before background/animated are applied"
        },
