# Akaunting Environment Configuration
# Copy this to .env and update with your values

# Application Key (Generate with: docker run --rm akaunting/akaunting php artisan key:generate --show)
AKAUNTING_APP_KEY=base64:REPLACE_WITH_GENERATED_KEY

# Application URL (update for production)
AKAUNTING_APP_URL=http://localhost:8080

# Database Passwords
AKAUNTING_DB_ROOT_PASSWORD=root
AKAUNTING_DB_PASSWORD=akaunting

# API Configuration (fill in after setup wizard)
# Self-hosted Akaunting uses Basic Authentication with admin credentials
AKAUNTING_API_USERNAME=admin@digitaltableteur.com
AKAUNTING_API_PASSWORD=
AKAUNTING_API_BASE_URL=http://localhost:8080/api
AKAUNTING_COMPANY_ID=1
