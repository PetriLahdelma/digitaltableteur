{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://digitaltableteur.com/schemas/agent-manifest.json",
  "title": "AgentManifest",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "summary", "components", "usageCoverage"],
  "properties": {
    "schemaVersion": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "required": ["componentCount", "statusCounts"],
      "properties": {
        "componentCount": { "type": "integer", "minimum": 0 },
        "statusCounts": { "type": "object", "additionalProperties": { "type": "integer" } },
        "honestBetaDocDebt": { "type": "integer" },
        "usageCoveragePercent": { "type": ["number", "null"] },
        "componentsWithProductionUsage": { "type": ["integer", "null"] }
      }
    },
    "usageCoverage": {
      "type": "object",
      "required": [
        "catalogedComponents",
        "withAnyUsage",
        "withProductionUsage",
        "uniqueImportedComponents"
      ],
      "properties": {
        "description": { "type": "string" },
        "catalogedComponents": { "type": "integer", "minimum": 0 },
        "withAnyUsage": { "type": "integer", "minimum": 0 },
        "withProductionUsage": { "type": "integer", "minimum": 0 },
        "uniqueImportedComponents": { "type": "integer", "minimum": 0 },
        "totalEvidenceRows": { "type": "integer", "minimum": 0 },
        "regenerate": { "type": "string" },
        "findComponent": { "type": "string" }
      }
    },
    "tokens": { "type": ["object", "null"] },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "contract", "usage", "agent"],
        "properties": {
          "name": { "type": "string" },
          "contract": { "type": "object" },
          "documentationDebt": { "type": "boolean" },
          "agent": {
            "type": "object",
            "required": ["preferredImport", "props", "variants"],
            "properties": {
              "preferredImport": { "type": "string" },
              "intent": { "type": "string" },
              "props": { "type": "object" },
              "propRelationships": {
                "type": "array",
                "items": {
                  "oneOf": [
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "props", "reason"],
                      "properties": {
                        "kind": { "const": "mutuallyExclusive" },
                        "props": {
                          "type": "array",
                          "items": { "type": "string" },
                          "minItems": 2,
                          "maxItems": 2,
                          "uniqueItems": true
                        },
                        "reason": { "type": "string", "minLength": 1 }
                      }
                    },
                    {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["kind", "prop", "requires", "reason"],
                      "properties": {
                        "kind": { "const": "requires" },
                        "prop": { "type": "string" },
                        "requires": {
                          "type": "array",
                          "items": { "type": "string" },
                          "minItems": 1,
                          "uniqueItems": true
                        },
                        "reason": { "type": "string", "minLength": 1 }
                      }
                    }
                  ]
                }
              },
              "variants": { "type": "object" },
              "useWhen": { "type": "array", "items": { "type": "string" } },
              "avoidWhen": { "type": "array", "items": { "type": "string" } },
              "requiredA11y": { "type": "array", "items": { "type": "string" } },
              "replacementFor": { "type": "array", "items": { "type": "string" } },
              "prefersOver": { "type": "array", "items": { "type": "string" } },
              "canonicalExamples": { "type": "array", "items": { "type": "string" } }
            }
          },
          "usage": {
            "type": "object",
            "required": [
              "publicImport",
              "importCount",
              "productionImportCount",
              "evidence"
            ],
            "properties": {
              "publicImport": { "type": "string", "pattern": "^@dt/" },
              "importCount": { "type": "integer", "minimum": 0 },
              "productionImportCount": { "type": "integer", "minimum": 0 },
              "patternImportCount": { "type": "integer", "minimum": 0 },
              "componentImportCount": { "type": "integer", "minimum": 0 },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["path", "importKind", "context"],
                  "properties": {
                    "path": { "type": "string" },
                    "importKind": { "enum": ["alias", "relative"] },
                    "importPath": { "type": "string" },
                    "context": {
                      "enum": [
                        "production",
                        "pattern",
                        "component",
                        "story",
                        "test",
                        "other"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
