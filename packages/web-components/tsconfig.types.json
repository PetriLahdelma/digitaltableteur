{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowJs": false,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "incremental": false,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "types": [
      "react",
      "react-dom"
    ],
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    // No paths overrides: before the root tsconfig dropped baseUrl (#1423)
    // the old src-pointing mappings resolved against the ROOT and were dead,
    // so @digitaltableteur/react always resolved via node_modules dist types
    // (the honest consumer posture). Dropping baseUrl activated them and
    // dragged react package SOURCE into this rootDir:src program (TS6059).
    "paths": {}
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "../../nextjs-app/shared/custom.d.ts",
    "../../nextjs-app/shared/types/**/*.d.ts"
  ],
  "exclude": [
    "dist"
  ]
}
