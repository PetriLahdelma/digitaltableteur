{
  "name": "@digitaltableteur/web-components",
  "version": "0.5.0",
  "private": false,
  "description": "Framework-neutral custom elements for the Digitaltableteur design system.",
  "type": "module",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PetriLahdelma/digitaltableteur.git",
    "directory": "packages/web-components"
  },
  "files": [
    "dist",
    "custom-elements.json"
  ],
  "customElements": "./custom-elements.json",
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./register/native": {
      "types": "./dist/register-native.d.ts",
      "import": "./dist/register-native.js"
    },
    "./register/react": {
      "types": "./dist/register-react.d.ts",
      "import": "./dist/register-react.js"
    }
  },
  "sideEffects": [
    "./dist/register.js",
    "./dist/register-native.js",
    "./dist/register-react.js"
  ],
  "peerDependencies": {
    "@digitaltableteur/react": "^0.1.16",
    "@r2wc/react-to-web-component": "^2.1.1",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "peerDependenciesMeta": {
    "@digitaltableteur/react": {
      "optional": true
    },
    "@r2wc/react-to-web-component": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "scripts": {
    "generate": "node ../../scripts/design-system/generate-web-components.mjs",
    "check:generated": "node ../../scripts/design-system/generate-web-components.mjs --check",
    "build": "npm run check:generated && vite build --config vite.config.ts && tsc -p tsconfig.types.json"
  }
}
