{
  "mcpServers": {
    "figma-desktop": {
      "type": "http",
      "url": "http://127.0.0.1:3845/mcp"
    },
    "figma-developer-mcp": {
      "type": "sse",
      "url": "http://localhost:3333/sse",
      "env": {
        "FIGMA_TOKEN": "<YOUR_FIGMA_TOKEN>"
      }
    },
    "ts-language-server": {
      "type": "command",
      "command": "npx",
      "args": [
        "typescript-language-server",
        "--stdio"
      ],
      "env": {
        "TYPESCRIPT_LOG_LEVEL": "error"
      }
    },
    "sentry-mcp": {
      "type": "command",
      "command": "node",
      "args": [
        "scripts/sentry-mcp.js",
        "issues"
      ],
      "env": {
        "SENTRY_AUTH_TOKEN": "<YOUR_SENTRY_TOKEN>",
        "SENTRY_ORG": "digitaltableteur",
        "SENTRY_PROJECT": "frontend"
      }
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp",
      "env": {
        "CONTEXT7_API_KEY": "<YOUR_CONTEXT7_API_KEY>"
      },
      "headers": {
        "Context7-API-Key": "{{CONTEXT7_API_KEY}}"
      }
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {{GITHUB_MCP_PAT}}"
      },
      "env": {
        "GITHUB_MCP_PAT": "<YOUR_GITHUB_PERSONAL_ACCESS_TOKEN>"
      }
    },
    "next-devtools": {
      "type": "command",
      "command": "npx",
      "args": [
        "-y",
        "next-devtools-mcp@latest"
      ],
      "env": {
        "NEXT_TELEMETRY_DISABLED": "1"
      }
    },
    "akaunting": {
      "type": "http",
      "baseUrl": "http://localhost:8080/api",
      "auth": {
        "type": "basic",
        "username": "{{AKAUNTING_API_USERNAME}}",
        "password": "{{AKAUNTING_API_PASSWORD}}"
      },
      "headers": {
        "X-Company": "1"
      },
      "description": "Akaunting Accounting Software API",
      "endpoints": {
        "invoices": "/invoices",
        "contacts": "/contacts",
        "items": "/items",
        "transactions": "/transactions",
        "reports": "/reports",
        "categories": "/categories",
        "expenses": "/expenses"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "GITHUB_MCP_PAT",
      "description": "GitHub Personal Access Token for MCP",
      "password": true
    },
    {
      "type": "promptString",
      "id": "AKAUNTING_API_USERNAME",
      "description": "Akaunting API Username (email)",
      "password": false
    },
    {
      "type": "promptString",
      "id": "AKAUNTING_API_PASSWORD",
      "description": "Akaunting API Password",
      "password": true
    }
  ]
}