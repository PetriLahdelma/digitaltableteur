{
  "mcpServers": {
    "figma-developer-mcp": {
      "type": "sse",
      "url": "http://localhost:3333/sse",
      "env": {
        "FIGMA_API_KEY": "<YOUR_FIGMA_API_KEY>"
      }
    },
    "ts-language-server": {
      "type": "command",
      "command": "npx",
      "args": ["typescript-language-server", "--stdio"],
      "env": {
        "TYPESCRIPT_LOG_LEVEL": "error"
      }
    }
  }
}
