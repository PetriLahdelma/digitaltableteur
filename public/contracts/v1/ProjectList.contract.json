  "specVersion": "1.0",
  "name": "ProjectList",
  "status": "beta",
  "description": "A compact project index: one row per project, the whole row a link to its case study. Narrow, a thumbnail, the title and one meta line; wide, aligned columns for project, client, discipline and period.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { ProjectList } from \"@digitaltableteur/react\";"
  },
  "props": {
    "items": {
      "type": "ProjectListItem[]",
      "optional": false,
      "description": "Projects in display order; items without href (or marked comingSoon) render as muted teaser rows."
    },
    "ariaLabel": {
      "type": "string",
      "optional": false,
      "description": "Accessible name for the list."
    },
    "comingSoonLabel": {
      "type": "string",
      "optional": true,
      "description": "Label on teaser rows; defaults to the translated \"Coming soon\"."
    },
    "contentLanguage": {
      "type": "string",
      "optional": true,
      "description": "Language of titles and clients when it differs from the page."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional className for the root element."
    }
  },
