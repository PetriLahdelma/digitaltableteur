{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "HighlightSection",
  "status": "stable",
  "description": "Highlight band with variant backgrounds and CTA slots.",
  "props": {
    "title": {
      "type": "string",
      "optional": false,
      "description": "Section title/headline"
    },
    "overline": {
      "type": "string",
      "optional": true,
      "description": "Optional overline text above title"
    },
    "description": {
      "type": "string",
      "optional": false,
      "description": "Supporting description text"
    },
    "cta": {
      "type": "HighlightSectionCTA | HighlightSectionCTA[]",
      "optional": true,
      "description": "CTA button configuration (up to 3 items)"
    },
    "variant": {
      "type": "union",
      "values": [
        "pattern",
        "solid",
        "gradient",
        "dots"
      ],
      "optional": true,
      "description": "Background variant"
    },
    "size": {
      "type": "union",
      "values": [
        "compact",
        "comfortable",
        "spacious"
      ],
      "optional": true,
      "description": "Section size (affects padding and spacing)"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom className for additional styling"
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "ARIA label for the section"
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Section id for anchor linking"
    },
    "donnyTarget": {
      "type": "string",
      "optional": true,
      "description": "Donny site action target id"
    }
  },
