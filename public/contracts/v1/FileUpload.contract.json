{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "FileUpload",
  "status": "stable",
  "description": "File picker with size validation and clear control.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { FileUpload } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Field label"
    },
    "placeholder": {
      "type": "string",
      "optional": true,
      "description": "Placeholder shown when no file is selected"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Helper copy below the control"
    },
    "uploadButtonLabel": {
      "type": "string",
      "optional": false,
      "description": "Upload button label"
    },
    "clearButtonLabel": {
      "type": "string",
      "optional": true,
      "description": "Clear/remove button label; the button shows only while a file is set"
    },
    "accept": {
      "type": "string",
      "optional": true,
      "description": "Accepted file extensions/MIME types for the native picker"
    },
    "maxSizeInBytes": {
      "type": "number",
      "optional": true,
      "description": "Maximum file size in bytes; checked when a file is picked"
    },
    "sizeErrorMessage": {
      "type": "string",
      "optional": true,
      "description": "Error shown when a picked file exceeds maxSizeInBytes"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "External error message; renders above the helper line"
    },
    "value": {
      "type": "File | null",
      "optional": true,
      "description": "Controlled File value"
    },
    "onFileChange": {
      "type": "(file: File | null) => void",
      "optional": true,
      "description": "Called when a file is selected or cleared"
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables the control."
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Marks the field required."
    },
    "appearance": {
      "type": "union",
      "values": [
        "default",
        "editorial"
      ],
      "optional": true,
      "description": "Match FormFieldEditorial / Combobox styling on editorial forms."
    },
    "className": {
      "type": "string",
      "optional": true
    }
  },
