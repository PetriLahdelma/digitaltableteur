{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ProofBlock",
  "status": "stable",
  "description": "Metrics band that presents headline numbers with captions under an optional title and subtitle, with tight and dark variants.",
  "props": {
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the proof section landmark."
    },
    "title": {
      "type": "string",
      "optional": false,
      "description": "Section heading."
    },
    "subTitle": {
      "type": "string",
      "optional": true,
      "description": "Supporting line under the title."
    },
    "caption": {
      "type": "string",
      "optional": true,
      "description": "Small print under the metrics (source, timeframe)."
    },
    "metrics": {
      "type": "ProofMetric[]",
      "optional": false,
      "description": "Proof metrics: value + label pairs."
    },
    "tight": {
      "type": "boolean",
      "optional": true,
      "description": "Reduce the band vertical padding."
    },
    "dark": {
      "type": "boolean",
      "optional": true,
      "description": "Render on the dark band treatment."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS classes on the section."
    }
  },
