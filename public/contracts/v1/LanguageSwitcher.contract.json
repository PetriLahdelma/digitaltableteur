{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "LanguageSwitcher",
  "status": "stable",
  "description": "Compact language selector: a current-language trigger that fans out the other locales as a button group.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { LanguageSwitcher } from \"@digitaltableteur/react\";"
  },
  "props": {
    "languages": {
      "type": "LanguageSwitcherOption[]",
      "optional": false,
      "description": "Available languages (code, label, accessible name)."
    },
    "currentLang": {
      "type": "string",
      "optional": false,
      "description": "Currently selected language code."
    },
    "onLanguageChange": {
      "type": "(code: string) => void",
      "optional": false,
      "description": "Called with the selected language code."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional classes on the group wrapper."
    },
    "buttonClassName": {
      "type": "string",
      "optional": true,
      "description": "Base class override applied to every language button."
    },
    "activeButtonClassName": {
      "type": "string",
      "optional": true,
      "description": "Class override for the current-language trigger."
    },
    "openTriggerClassName": {
      "type": "string",
      "optional": true,
      "description": "Class override for the trigger while the tray is open."
    },
    "floatedButtonClassName": {
      "type": "string",
      "optional": true,
      "description": "Class override for the fanned-out tray options."
    }
  },
