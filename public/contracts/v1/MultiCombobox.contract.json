{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "MultiCombobox",
  "status": "stable",
  "description": "Multi-select combobox with inline chips, type-to-filter dropdown, label, error, and helper text.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { MultiCombobox } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Field label; associates the input"
    },
    "options": {
      "type": "MultiComboboxOption[]",
      "optional": false,
      "description": "Selectable options"
    },
    "value": {
      "type": "string[]",
      "optional": false,
      "description": "Selected values (controlled)"
    },
    "onValueChange": {
      "type": "(value: string[]) => void",
      "optional": false,
      "description": "Called with the next selected values"
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Explicit control id (wires the label); auto-generated when omitted"
    },
    "placeholder": {
      "type": "string",
      "optional": true,
      "description": "Shown when nothing is selected"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Assistive text below the field"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message; renders above the helper line and sets aria-invalid"
    },
    "status": {
      "type": "FieldStatus",
      "optional": true,
      "description": "Semantic state: colours the border and styles statusMessage. `error` overrides it."
    },
    "statusMessage": {
      "type": "string",
      "optional": true,
      "description": "Message under the field for `status`, above the helper line"
    },
    "actions": {
      "type": "FieldAction[]",
      "optional": true,
      "description": "Icon buttons at the end of the label row: each runs an operation or opens a menu"
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Marks the field required."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables the control."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Classes on the field wrapper"
    }
  },
