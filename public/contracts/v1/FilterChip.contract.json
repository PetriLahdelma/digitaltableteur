  "specVersion": "1.0",
  "name": "FilterChip",
  "status": "stable",
  "description": "Single-select filter toggle chip: a button[aria-pressed] with pill, rectangle, underline, and minimal treatments.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { FilterChip } from \"@digitaltableteur/react\";"
  },
  "props": {
    "pressed": {
      "type": "boolean",
      "optional": false,
      "description": "Whether this chip's filter is active (rendered as aria-pressed)."
    },
    "children": {
      "type": "React.ReactNode",
      "optional": false,
      "description": "Chip label (compose counts etc. inline)."
    },
    "variant": {
      "type": "union",
      "values": [
        "underline",
        "minimal",
        "pill",
        "rectangle"
      ],
      "optional": true,
      "description": "Visual treatment."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size token."
    },
    "count": {
      "type": "number",
      "optional": true,
      "description": "Optional count suffix, rendered as \"(n)\"."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class names."
    }
  },
