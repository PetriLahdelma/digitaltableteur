{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "SocialIconLink",
  "status": "alpha",
  "description": "Icon-only social or profile link with enforced accessible name and external-safety (target=_blank + rel) by default.",
  "props": {
    "href": {
      "type": "string",
      "optional": false,
      "description": "Destination URL."
    },
    "label": {
      "type": "string",
      "optional": false,
      "description": "Accessible name — required, the control is icon-only."
    },
    "children": {
      "type": "React.ReactNode",
      "optional": false,
      "description": "The icon. Rendered inside an aria-hidden wrapper so only `label` names the link."
    },
    "variant": {
      "type": "union",
      "values": [
        "plain",
        "chip"
      ],
      "optional": true,
      "description": "Visual treatment: bare glyph (footers) or bordered circular chip (share rows)."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Hit-target size token."
    },
    "external": {
      "type": "boolean",
      "optional": true,
      "description": "Open in a new tab with rel=\"noopener noreferrer\"."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class names."
    }
  },
