{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "EnhancedProjectCard",
  "status": "stable",
  "description": "Portfolio project card with image, video hover, and metadata.",
  "props": {
    "title": {
      "type": "string",
      "optional": false,
      "description": "Project title"
    },
    "slug": {
      "type": "string",
      "optional": false,
      "description": "URL slug for project detail page"
    },
    "thumbnail": {
      "type": "string",
      "optional": false,
      "description": "Thumbnail image URL"
    },
    "videoThumbnail": {
      "type": "string",
      "optional": true,
      "description": "Video thumbnail URL (for hover autoplay)"
    },
    "description": {
      "type": "string",
      "optional": true,
      "description": "Short description"
    },
    "category": {
      "type": "string",
      "optional": true,
      "description": "Project category"
    },
    "tags": {
      "type": "string[]",
      "optional": true,
      "description": "Project tags"
    },
    "aspectRatio": {
      "type": "union",
      "values": [
        "video",
        "square",
        "portrait",
        "landscape"
      ],
      "optional": true,
      "description": "Image aspect ratio"
    },
    "showCategory": {
      "type": "boolean",
      "optional": true,
      "description": "Show category in caption"
    },
    "showDescription": {
      "type": "boolean",
      "optional": true,
      "description": "Show description on hover"
    },
    "autoPlayVideo": {
      "type": "boolean",
      "optional": true,
      "description": "Autoplay video thumbnail continuously (not just on hover)"
    },
    "comingSoon": {
      "type": "boolean",
      "optional": true,
      "description": "Render as a non-interactive teaser with a \"coming soon\" badge over the media"
    },
    "comingSoonLabel": {
      "type": "string",
      "optional": true,
      "description": "Visible badge label for the coming-soon overlay (pass a translated string)"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom className"
    }
  },
