{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "CodeBlock",
  "status": "beta",
  "description": "Multi-line source with an optional filename header, line numbers, highlighted, added and removed rows, copy and a caption.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { CodeBlock } from \"@digitaltableteur/react\";"
  },
  "props": {
    "code": {
      "type": "string",
      "optional": true,
      "description": "Source to show. Highlighted at runtime for the common languages; with\n`language=\"diff\"` the leading +/- of each line become added and removed\nrows. Pass either `code` or a pre-highlighted Shiki tree as `children`."
    },
    "children": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "A Shiki `<pre><code>` tree (rehype-pretty-code output). Callouts come\nfrom the MDX meta string: a line range highlights, and a range with the\nid \"added\" or \"removed\" marks a diff."
    },
    "language": {
      "type": "string",
      "optional": true,
      "description": "Language of the code; shown in the header and drives highlighting."
    },
    "filename": {
      "type": "string",
      "optional": true,
      "description": "File name shown in the header. Giving one turns the header on."
    },
    "header": {
      "type": "boolean",
      "optional": true,
      "description": "Show the header bar."
    },
    "lineNumbers": {
      "type": "boolean",
      "optional": true,
      "description": "Number the lines."
    },
    "highlightLines": {
      "type": "CodeLineSpec",
      "optional": true,
      "description": "Lines to highlight: `[2, 3]` or `\"2-3,7\"`. 1-based."
    },
    "addedLines": {
      "type": "CodeLineSpec",
      "optional": true,
      "description": "Lines to mark as added."
    },
    "removedLines": {
      "type": "CodeLineSpec",
      "optional": true,
      "description": "Lines to mark as removed. Copy leaves them out."
    },
    "caption": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Caption under the card."
    },
    "theme": {
      "type": "union",
      "values": [
        "light",
        "terminal"
      ],
      "optional": true,
      "description": "`terminal` renders the block in the dark theme on any page. In the\nhigh-contrast themes it follows the page so contrast stays at the\nhigh-contrast level."
    },
    "wrap": {
      "type": "boolean",
      "optional": true,
      "description": "Wrap long lines instead of scrolling sideways."
    },
    "maxHeight": {
      "type": "string | number",
      "optional": true,
      "description": "Cap the body height (any CSS length, or pixels) and scroll inside it."
    },
    "copyable": {
      "type": "boolean",
      "optional": true,
      "description": "Show the copy button."
    },
    "copyLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the copy button."
    },
    "onCopy": {
      "type": "(text: string) => void",
      "optional": true,
      "description": "Called with the copied text."
    }
  },
