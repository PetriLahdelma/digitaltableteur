{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Progress",
  "status": "stable",
  "description": "Linear progress indicator with determinate and indeterminate modes.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Progress } from \"@digitaltableteur/react\";"
  },
  "props": {
    "value": {
      "type": "number",
      "optional": true,
      "description": "Current progress value, scaled against max."
    },
    "max": {
      "type": "number",
      "optional": true,
      "description": "Maximum value."
    },
    "label": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the progressbar."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Track height token."
    },
    "state": {
      "type": "union",
      "values": [
        "info",
        "success",
        "warning",
        "error",
        "neutral"
      ],
      "optional": true,
      "description": "Semantic fill color."
    },
    "indeterminate": {
      "type": "boolean",
      "optional": true,
      "description": "Unknown duration: animates a sweeping bar and drops aria-valuenow."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional utility classes on the root."
    }
  },
  "rules": [
    {
      "id": "progress-indeterminate-ignores-value",
      "when": {
        "indeterminate": {
          "equals": true
        }
      },
      "forbid": [
        "value"
      ],
      "reason": "An indeterminate bar drops aria-valuenow and ignores `value`. Pass `value` only for determinate progress.",
      "severity": "warning",
      "evidence": "Progress.tsx: aria-valuenow and scale are skipped when indeterminate"
    }
  ],
