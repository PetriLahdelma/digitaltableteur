{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "List",
  "status": "stable",
  "description": "Typographic list (ul or ol) that renders `items` on the text ladder — size matches the surrounding Text voice, listStyleType styles or removes markers, and spacing owns the inter-item rhythm.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { List } from \"@digitaltableteur/react\";"
  },
  "props": {
    "items": {
      "type": "React.ReactNode[]",
      "optional": false,
      "description": "Ordered content rendered as one list item per entry."
    },
    "as": {
      "type": "union",
      "values": [
        "ol",
        "ul"
      ],
      "optional": true,
      "description": "Semantic list element."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional class name applied to the list element."
    },
    "size": {
      "type": "union",
      "values": [
        "xl",
        "xs",
        "s",
        "xxs",
        "m",
        "l",
        "xxl"
      ],
      "optional": true,
      "description": "Tokenized text size."
    },
    "lineHeight": {
      "type": "union",
      "values": [
        "normal",
        "tight",
        "snug",
        "relaxed",
        "loose"
      ],
      "optional": true,
      "description": "Optional tokenized line height."
    },
    "style": {
      "type": "React.CSSProperties",
      "optional": true,
      "description": "Inline style overrides applied after component defaults."
    },
    "listStyleType": {
      "type": "union",
      "values": [
        "none",
        "decimal",
        "circle",
        "square",
        "disc",
        "decimal-leading-zero",
        "lower-alpha",
        "upper-alpha",
        "lower-roman",
        "upper-roman",
        "dash"
      ],
      "optional": true,
      "description": "Native marker style or the custom dash treatment."
    },
    "spacing": {
      "type": "union",
      "values": [
        "normal",
        "relaxed",
        "compact"
      ],
      "optional": true,
      "description": "Vertical spacing between items."
    },
    "role": {
      "type": "string",
      "optional": true,
      "description": "Optional ARIA role override for specialized list semantics."
    },
    "striped": {
      "type": "boolean",
      "optional": true,
      "description": "Alternate row backgrounds for long lists of multi-line entries; rows get padding and no markers unless listStyleType asks for them."
    }
  },
