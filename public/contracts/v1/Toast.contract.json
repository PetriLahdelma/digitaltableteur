{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Toast",
  "status": "stable",
  "description": "Transient status message with tone, position, and auto-dismiss.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Toast } from \"@digitaltableteur/react\";"
  },
  "props": {
    "open": {
      "type": "boolean",
      "optional": true,
      "description": "Controls visibility."
    },
    "tone": {
      "type": "union",
      "values": [
        "info",
        "success",
        "warning",
        "error",
        "neutral"
      ],
      "optional": true,
      "description": "Semantic colour."
    },
    "position": {
      "type": "union",
      "values": [
        "top-left",
        "top-center",
        "top-right",
        "bottom-left",
        "bottom-center",
        "bottom-right"
      ],
      "optional": true,
      "description": "Position on screen."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size."
    },
    "message": {
      "type": "string",
      "optional": false,
      "description": "Message text displayed in the toast."
    },
    "duration": {
      "type": "number",
      "optional": true,
      "description": "Auto-dismiss delay in ms."
    },
    "onClose": {
      "type": "() => void",
      "optional": true,
      "description": "Called when the auto-dismiss timer fires."
    },
    "inline": {
      "type": "boolean",
      "optional": true,
      "description": "Render in normal document flow instead of fixed-positioning itself; a\nparent (ToastStack) owns placement. `position` is ignored when set."
    }
  },
  "rules": [
    {
      "id": "toast-inline-ignores-position",
      "when": {
        "inline": {
          "equals": true
        }
      },
      "forbid": [
        "position"
      ],
      "reason": "An inline toast is placed by its parent (ToastStack); `position` is ignored.",
      "severity": "warning",
      "evidence": "Toast.tsx: inline selects toast--inline instead of the position class"
    }
  ],
