{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "DonnyAvatar",
  "status": "stable",
  "description": "The assistant's animated avatar with thinking, speaking, and idle mood states, used inside ChatWidget and Donny surfaces.",
  "props": {
    "state": {
      "type": "union",
      "values": [
        "success",
        "error",
        "loading",
        "idle",
        "listening",
        "thinking",
        "searching",
        "confused",
        "handoff",
        "greeting",
        "acknowledging",
        "suggesting",
        "confident",
        "curious",
        "celebrating",
        "apologetic",
        "typing",
        "waving",
        "remembering",
        "focused",
        "playful",
        "impressed",
        "skeptical",
        "sleepy",
        "sleeping"
      ],
      "optional": true,
      "description": "Current expression or assistant lifecycle state."
    },
    "size": {
      "type": "union",
      "values": [
        "xs",
        "sm",
        "md",
        "lg",
        "xl"
      ],
      "optional": true,
      "description": "Rendered avatar size: xs 28px (chat toggle), sm 32px, md 48px, lg 64px, xl 96px."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class."
    },
    "onTransitionEnd": {
      "type": "() => void",
      "optional": true,
      "description": "Called when the state transition animation ends."
    },
    "showLabel": {
      "type": "boolean",
      "optional": true,
      "description": "Shows the current state label for diagnostics."
    },
    "trackMouse": {
      "type": "boolean",
      "optional": true,
      "description": "Makes the eyes follow the pointer."
    },
    "proximitySelectors": {
      "type": "string[]",
      "optional": true,
      "description": "CSS selectors whose pointer proximity can trigger curious or playful behavior."
    },
    "onProximityChange": {
      "type": "(isNearTarget: boolean, targetSelector?: string) => void",
      "optional": true,
      "description": "Called when proximity to a tracked target changes."
    },
    "proximityThreshold": {
      "type": "number",
      "optional": true,
      "description": "Pointer proximity threshold in pixels (default 150)."
    },
    "enableIdleExpressions": {
      "type": "boolean",
      "optional": true,
      "description": "Enables one randomized idle expression before the avatar settles."
    },
    "idleExpressionInterval": {
      "type": "number",
      "optional": true,
      "description": "Delay before the one idle expression, in milliseconds (default 12000), randomized by 50 percent."
    },
    "isSpeaking": {
      "type": "boolean",
      "optional": true,
      "description": "Animates the mouth during streaming responses."
    },
    "enableSleepDetection": {
      "type": "boolean",
      "optional": true,
      "description": "Enables sleepy and sleeping states after pointer inactivity."
    },
    "sleepyDelay": {
      "type": "number",
      "optional": true,
      "description": "Inactivity delay before the sleepy state, in milliseconds (default 120000)."
    },
    "sleepDelay": {
      "type": "number",
      "optional": true,
      "description": "Inactivity delay before the sleeping state, in milliseconds (default 150000)."
    },
    "decorative": {
      "type": "boolean",
      "optional": true,
      "description": "Removes role and label when a parent control owns the accessible name (e.g. the chat toggle)."
    }
  },
