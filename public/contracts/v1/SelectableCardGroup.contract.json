{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "SelectableCardGroup",
  "status": "beta",
  "description": "Selection owner for a set of SelectableCard options, with native fieldset semantics, controlled or uncontrolled state, and single or multiple selection.",
  "props": {
    "type": {
      "type": "union",
      "values": [
        "single",
        "multiple"
      ],
      "optional": true,
      "description": "Selection model: one exclusive value or several independent values."
    },
    "legend": {
      "type": "string",
      "optional": false,
      "description": "Visible fieldset legend and accessible group name."
    },
    "name": {
      "type": "string",
      "optional": true,
      "description": "Shared native radio name; generated when omitted."
    },
    "value": {
      "type": "string | string[]",
      "optional": true,
      "description": "Controlled selection value matching the selection type."
    },
    "defaultValue": {
      "type": "string | string[]",
      "optional": true,
      "description": "Initial selection for uncontrolled use."
    },
    "onValueChange": {
      "type": "(value: string | string[]) => void",
      "optional": true,
      "description": "Receives the next selection after an option is activated."
    },
    "orientation": {
      "type": "union",
      "values": [
        "vertical",
        "horizontal"
      ],
      "optional": true,
      "description": "Visual stack direction for the options."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables every option in the fieldset."
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Validation message announced below the group."
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Supporting guidance suppressed while an error is present."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional class name merged onto the fieldset."
    },
    "children": {
      "type": "ReactNode",
      "optional": false,
      "description": "SelectableCard options owned by this group."
    }
  },
