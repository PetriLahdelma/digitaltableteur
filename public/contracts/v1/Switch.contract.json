{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Switch",
  "status": "stable",
  "description": "Toggle control with label placement, loading, and helper text.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Switch } from \"@digitaltableteur/react\";"
  },
  "props": {
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables interaction and dims the control."
    },
    "loading": {
      "type": "boolean",
      "optional": true,
      "description": "Shows a loading spinner and blocks interaction; sets `aria-busy`."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Control size."
    },
    "onCheckedChange": {
      "type": "(checked: boolean) => void",
      "optional": true,
      "description": "Called with the next checked value when the switch is toggled."
    },
    "label": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Visible label."
    },
    "labelPlacement": {
      "type": "union",
      "values": [
        "left",
        "right",
        "top"
      ],
      "optional": true,
      "description": "Where the label sits relative to the control."
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Supporting text rendered beneath the control; always rendered, below `error` when both are set."
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message beneath the control; sets aria-invalid and aria-describedby."
    },
    "defaultChecked": {
      "type": "boolean | undefined",
      "optional": true,
      "description": "Initial checked state for uncontrolled use. Mutually exclusive with `checked`."
    },
    "checked": {
      "type": "boolean",
      "optional": true,
      "description": "Checked state for controlled use. Mutually exclusive with `defaultChecked`."
    }
  },
