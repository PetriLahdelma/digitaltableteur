{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "SocialShare",
  "status": "stable",
  "description": "Row of social share targets: per-network deep links plus a native-share or copy-link button, with an optional labelled article-footer variant.",
  "props": {
    "url": {
      "type": "string",
      "optional": false
    },
    "title": {
      "type": "string",
      "optional": false
    },
    "channels": {
      "type": "SocialShareChannel[]",
      "optional": true,
      "description": "Ordered list of network share targets. Defaults to all supported channels."
    },
    "variant": {
      "type": "union",
      "values": [
        "article",
        "inline"
      ],
      "optional": true,
      "description": "`article` adds a labelled section suited to blog post footers."
    },
    "showHeading": {
      "type": "boolean",
      "optional": true
    },
    "heading": {
      "type": "string",
      "optional": true
    }
  },
