  "name": "ContactInquiryPanel",
  "status": "stable",
  "description": "Contact page inquiry panel with message and book-a-call tabs wrapping the editorial form.",
  "props": {
    "initialMode": {
      "type": "union",
      "values": [
        "message",
        "book"
      ],
      "optional": true,
      "description": "Initial tab selection."
    },
    "packageId": {
      "type": "string",
      "optional": true,
      "description": "Optional pricing package id for booking prefill."
    },
    "messagePanel": {
      "type": "ReactNode",
      "optional": false,
      "description": "Editorial contact form slot shown on the message tab."
    },
    "bookingConfig": {
      "type": "SiteBookingConfig",
      "optional": true,
      "description": "Optional booking override; defaults from packageId."
    }
  },
