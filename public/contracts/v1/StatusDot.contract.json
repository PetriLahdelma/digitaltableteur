{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "StatusDot",
  "status": "stable",
  "description": "Tiny semantic status indicator: colored dot with visible or sr-only label.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { StatusDot } from \"@digitaltableteur/react\";"
  },
  "props": {
    "tone": {
      "type": "union",
      "values": [
        "info",
        "success",
        "warning",
        "error",
        "neutral"
      ],
      "optional": true,
      "description": "Semantic tone of the status."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size token."
    },
    "pulse": {
      "type": "boolean",
      "optional": true,
      "description": "Animates a soft pulse for live/ongoing states (respects reduced motion)."
    },
    "label": {
      "type": "string",
      "optional": true,
      "description": "Accessible label when no visible children are given (e.g. \"Online\")."
    },
    "children": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Visible label text rendered next to the dot."
    }
  },
