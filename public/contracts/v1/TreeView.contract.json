{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "TreeView",
  "status": "beta",
  "description": "Application tree with hierarchical selection, expansion, roving focus, and arrow-key navigation.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { TreeView } from \"@digitaltableteur/react\";"
  },
  "props": {
    "nodes": {
      "type": "TreeViewNode[]",
      "optional": false,
      "description": "Hierarchical nodes."
    },
    "aria-label": {
      "type": "string",
      "optional": false,
      "description": "Accessible name for the tree."
    },
    "selectedId": {
      "type": "string | null",
      "optional": true,
      "description": "Controlled selected node identifier."
    },
    "defaultSelectedId": {
      "type": "string | null",
      "optional": true,
      "description": "Initial uncontrolled selected node identifier."
    },
    "onSelectedIdChange": {
      "type": "(id: string) => void",
      "optional": true,
      "description": "Receives selection changes."
    },
    "expandedIds": {
      "type": "string[]",
      "optional": true,
      "description": "Controlled expanded node identifiers."
    },
    "defaultExpandedIds": {
      "type": "string[]",
      "optional": true,
      "description": "Initial uncontrolled expanded node identifiers."
    },
    "onExpandedIdsChange": {
      "type": "(ids: string[]) => void",
      "optional": true,
      "description": "Receives expansion changes."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Density scale."
    },
    "className": {
      "type": "string",
      "optional": true
    }
  },
