{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "CodeSnippet",
  "status": "deprecated",
  "description": "Syntax-highlighted code block with a language picker, optional line numbers, and a copy button.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { CodeSnippet } from \"@digitaltableteur/react\";"
  },
  "props": {
    "code": {
      "type": "string",
      "optional": false,
      "description": "The code string to highlight."
    },
    "language": {
      "type": "union",
      "values": [
        "go",
        "html",
        "javascript",
        "typescript",
        "xml",
        "python",
        "rust",
        "json",
        "bash",
        "markdown"
      ],
      "optional": true,
      "description": "Highlighting grammar."
    },
    "showLineNumbers": {
      "type": "boolean",
      "optional": true,
      "description": "Render a line-number gutter."
    },
    "aria-label": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the snippet region."
    },
    "allowCopy": {
      "type": "boolean",
      "optional": true,
      "description": "Show the copy button; keep on for reusable code."
    },
    "variant": {
      "type": "union",
      "values": [
        "single",
        "inline",
        "multi"
      ],
      "optional": true,
      "description": "Layout variant: inline token, single line, or multi-line window."
    },
    "maxLines": {
      "type": "number",
      "optional": true,
      "description": "Clamp height to this many lines; longer code scrolls. 0 disables the clamp."
    },
    "onCopy": {
      "type": "() => void",
      "optional": true,
      "description": "Fires after the code is copied to the clipboard."
    }
  },
  "accessibility": {
    "criteria": [
