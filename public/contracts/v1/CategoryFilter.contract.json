{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "CategoryFilter",
  "status": "stable",
  "description": "Filter pill row for list pages (blog archive, work index). Multiple visual treatments (pills, underline, minimal) for different surface densities.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { CategoryFilter } from \"@digitaltableteur/react\";"
  },
  "props": {
    "categories": {
      "type": "CategoryOption[]",
      "optional": false,
      "description": "Array of category options"
    },
    "activeCategory": {
      "type": "string",
      "optional": false,
      "description": "Currently active category value"
    },
    "onCategoryChange": {
      "type": "(category: string) => void",
      "optional": false,
      "description": "Callback when category changes"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom className"
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size variant"
    },
    "variant": {
      "type": "union",
      "values": [
        "pills",
        "underline",
        "minimal"
      ],
      "optional": true,
      "description": "Style variant"
    },
    "collapsible": {
      "type": "boolean",
      "optional": true,
      "description": "Collapse to the active chip and a disclosure button; expanding shows every chip and picking one collapses back to it."
    },
    "disclosureLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible name of the disclosure button; defaults to the translated \"All categories\"."
    }
  },
