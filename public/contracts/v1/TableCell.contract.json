  "name": "TableCell",
  "status": "stable",
  "description": "A table data cell (<td>) for the Table family. align controls text alignment; numeric right-aligns with tabular figures so columns line up on the decimal.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { TableCell } from \"@digitaltableteur/react\";"
  },
  "props": {
    "align": {
      "type": "union",
      "values": [
        "center",
        "end",
        "start"
      ],
      "optional": true,
      "description": "Cell content alignment."
    },
    "numeric": {
      "type": "boolean",
      "optional": true,
      "description": "Right-align and tabular-figure numeric values."
    },
    "label": {
      "type": "string",
      "optional": true,
      "description": "Column name shown before the value when the parent Table stacks rows (stackOnNarrow). Hidden from assistive technology, which reads the column header instead."
    }
  },
