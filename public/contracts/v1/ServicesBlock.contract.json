{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ServicesBlock",
  "status": "stable",
  "description": "Case-study engagement overview with services, duration, and tools columns alongside overview copy.",
  "props": {
    "services": {
      "type": "ServiceItem[]",
      "optional": true,
      "description": "List of services provided"
    },
    "duration": {
      "type": "string",
      "optional": true,
      "description": "Project duration or timeline"
    },
    "tools": {
      "type": "ToolIcon[]",
      "optional": true,
      "description": "Tools/technologies used (icon objects)"
    },
    "overviewTitle": {
      "type": "string",
      "optional": true,
      "description": "Overview title (defaults to \"Overview\")"
    },
    "overview": {
      "type": "React.ReactNode",
      "optional": false,
      "description": "Overview content (can be string or React node for rich content)"
    },
    "servicesTitle": {
      "type": "string",
      "optional": true,
      "description": "Optional title for services section (defaults to \"Services\")"
    },
    "durationTitle": {
      "type": "string",
      "optional": true,
      "description": "Optional title for duration section (defaults to \"Duration\")"
    },
    "toolsTitle": {
      "type": "string",
      "optional": true,
      "description": "Optional title for tools section (defaults to \"Tools\")"
    },
    "maxWidth": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "full"
      ],
      "optional": true,
      "description": "Maximum content width"
    },
    "spacing": {
      "type": "union",
      "values": [
        "default",
        "compact",
        "comfortable",
        "spacious"
      ],
      "optional": true,
      "description": "Vertical spacing"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom CSS class for styling extensions"
    },
    "as": {
      "type": "union",
      "values": [
        "article",
        "div",
        "section"
      ],
      "optional": true,
      "description": "Semantic HTML element to render as"
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "ARIA label for section"
    }
  },
