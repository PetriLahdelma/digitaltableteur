  "specVersion": "1.0",
  "name": "SiteHeader",
  "status": "stable",
  "description": "Production site header with nav, theme toggle, and mobile drawer.",
  "props": {
    "navItems": {
      "type": "NavItem[]",
      "optional": true,
      "description": "Navigation items (href, label, exact); the site default when unset."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional wrapper class."
    },
    "languageCodes": {
      "type": "readonly string[]",
      "optional": true,
      "description": "Limits the language switchers to these codes, for an area offered in\nfewer languages than the site (the client intake: EN and FI). All site\nlanguages when unset."
    },
    "account": {
      "type": "SiteHeaderAccount",
      "optional": true,
      "description": "The signed-in person in an account area (the client intake): an avatar\nwith their initials that opens a menu of account actions such as\nsigning out. Nothing renders when unset."
    }
  },
