{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Hero",
  "status": "deprecated",
  "description": "Configurable general-purpose page hero with heading, subtitle, optional image, and an actions slot across layout and background variants.",
  "props": {
    "title": {
      "type": "string",
      "optional": false,
      "description": "Hero title (required)"
    },
    "titleLevel": {
      "type": "1 | 2 | 3 | 4 | 5 | 6",
      "optional": true,
      "description": "Title semantic level (defaults to 1 for page hero)"
    },
    "subtitle": {
      "type": "string",
      "optional": true,
      "description": "Subtitle text"
    },
    "description": {
      "type": "string",
      "optional": true,
      "description": "Descriptive body text"
    },
    "imageSrc": {
      "type": "string",
      "optional": true,
      "description": "Hero image source"
    },
    "imageAlt": {
      "type": "string",
      "optional": true,
      "description": "Hero image alt text (required if imageSrc provided)"
    },
    "imageWidth": {
      "type": "number",
      "optional": true,
      "description": "Image width for Next.js Image optimization"
    },
    "imageHeight": {
      "type": "number",
      "optional": true,
      "description": "Image height for Next.js Image optimization"
    },
    "actions": {
      "type": "HeroAction[]",
      "optional": true,
      "description": "Call-to-action buttons"
    },
    "variant": {
      "type": "union",
      "values": [
        "minimal",
        "default",
        "stacked",
        "centered",
        "split"
      ],
      "optional": true,
      "description": "Layout variant"
    },
    "background": {
      "type": "union",
      "values": [
        "image",
        "transparent",
        "light",
        "dark",
        "gradient"
      ],
      "optional": true,
      "description": "Background color/gradient style"
    },
    "align": {
      "type": "union",
      "values": [
        "center",
        "right",
        "left"
      ],
      "optional": true,
      "description": "Content alignment"
    },
    "maxWidth": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "full",
        "xl"
      ],
      "optional": true,
      "description": "Maximum content width"
    },
    "spacing": {
      "type": "union",
      "values": [
        "compact",
        "default",
        "comfortable",
        "spacious"
      ],
      "optional": true,
      "description": "Vertical spacing"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom CSS class for styling extensions"
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "ARIA label for hero section"
    }
  },
