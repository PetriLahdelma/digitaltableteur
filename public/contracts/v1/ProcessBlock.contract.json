{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ProcessBlock",
  "status": "stable",
  "description": "Case-study process section that arranges titled phase cards in a grid under an optional title and description.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { ProcessBlock } from \"@digitaltableteur/react\";"
  },
  "props": {
    "phases": {
      "type": "ProcessPhase[]",
      "optional": false,
      "description": "Array of process phases to display"
    },
    "sectionTitle": {
      "type": "string",
      "optional": true,
      "description": "Optional main title for the process section"
    },
    "description": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Optional description or introduction text"
    },
    "backgroundColor": {
      "type": "union",
      "values": [
        "transparent",
        "light",
        "white"
      ],
      "optional": true,
      "description": "Background color variant"
    },
    "maxWidth": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "full"
      ],
      "optional": true,
      "description": "Maximum width constraint"
    },
    "spacing": {
      "type": "union",
      "values": [
        "default",
        "compact",
        "comfortable",
        "spacious"
      ],
      "optional": true,
      "description": "Spacing variant"
    },
    "columns": {
      "type": "2 | 3 | 4",
      "optional": true,
      "description": "Number of columns (2, 3, or 4)"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class"
    },
    "as": {
      "type": "union",
      "values": [
        "article",
        "div",
        "section"
      ],
      "optional": true,
      "description": "Semantic HTML element to use"
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible label for the section"
    }
  },
