{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Mermaid",
  "status": "alpha",
  "description": "Renders a Mermaid diagram with a concise accessible name, prose summary, and visible structured text alternative.",
  "props": {
    "chart": {
      "type": "string",
      "optional": false,
      "description": "Mermaid diagram source"
    },
    "title": {
      "type": "string",
      "optional": false,
      "description": "Concise meaningful name for the diagram"
    },
    "description": {
      "type": "string",
      "optional": false,
      "description": "Short prose summary of the diagram purpose and relationships"
    },
    "accessibleDetails": {
      "type": "ReactNode",
      "optional": false,
      "description": "Structured or prose equivalent of every material relationship in the diagram"
    },
    "detailsLabel": {
      "type": "string",
      "optional": true,
      "description": "Label for the visible text-alternative disclosure"
    },
    "caption": {
      "type": "string",
      "optional": true,
      "description": "Optional visible figure caption"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional className for the figure"
    },
    "themeColors": {
      "type": "MermaidThemeColors",
      "optional": true,
      "description": "Diagram color overrides: CSS colours or var(--token) references. Defaults to --color-text and --color-border, so diagrams follow the theme."
    }
  },
