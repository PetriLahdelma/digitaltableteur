{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Timestamp",
  "status": "stable",
  "description": "Formats an ISO calendar date, instant, Unix timestamp, or Date into human-readable text: relative for recency, absolute for precision, or auto to switch between them. Date-only values retain their calendar date across runtime timezones.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Timestamp } from \"@digitaltableteur/react\";"
  },
  "props": {
    "value": {
      "type": "string | number | Date",
      "optional": false,
      "description": "The date/time to display: ISO 8601 calendar date or instant, Unix seconds, or Date."
    },
    "format": {
      "type": "union",
      "values": [
        "auto",
        "date",
        "time",
        "relative",
        "date_time",
        "system_date",
        "system_date_time",
        "system_time"
      ],
      "optional": true,
      "description": "Display format."
    },
    "autoThreshold": {
      "type": "number",
      "optional": true,
      "description": "Seconds after which `auto` switches from relative to date_time."
    },
    "size": {
      "type": "union",
      "values": [
        "xs",
        "s",
        "xxs",
        "m"
      ],
      "optional": true,
      "description": "Text-ladder size."
    },
    "tone": {
      "type": "union",
      "values": [
        "default",
        "muted"
      ],
      "optional": true,
      "description": "Color role: body text or muted metadata."
    },
    "showTimezone": {
      "type": "boolean",
      "optional": true,
      "description": "Append the timezone abbreviation (date_time/time/system equivalents)."
    },
    "tooltip": {
      "type": "boolean",
      "optional": true,
      "description": "Native tooltip with the full date when showing relative time."
    },
    "live": {
      "type": "boolean",
      "optional": true,
      "description": "Keep relative output ticking while mounted."
    },
    "now": {
      "type": "string | number | Date",
      "optional": true,
      "description": "Reference \"now\" for relative/auto output. Defaults to render time; pass a\nfixed value in stories/tests for deterministic output."
    },
    "locale": {
      "type": "string",
      "optional": true,
      "description": "Locale override; defaults to the active site language."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional className passthrough."
    }
  },
