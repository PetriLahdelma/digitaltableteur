{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Avatar",
  "status": "stable",
  "description": "Profile image, initials, link, or menu trigger.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Avatar } from \"@digitaltableteur/react\";"
  },
  "props": {
    "name": {
      "type": "string",
      "optional": true
    },
    "imageUrl": {
      "type": "string | { default: string } | StaticImageData",
      "optional": true
    },
    "clickable": {
      "type": "boolean",
      "optional": true
    },
    "destinationUrl": {
      "type": "string",
      "optional": true
    },
    "size": {
      "type": "AvatarSize",
      "optional": true,
      "description": "Avatar size: token sizes `sm`/`md`/`lg`/`xl` (2/2.5/3/4rem) are\ncanonical; any CSS length is accepted as an escape hatch. Default `md`."
    },
    "srcSet": {
      "type": "string",
      "optional": true
    },
    "sizes": {
      "type": "string",
      "optional": true
    },
    "loading": {
      "type": "union",
      "values": [
        "lazy",
        "eager"
      ],
      "optional": true
    },
    "decoding": {
      "type": "union",
      "values": [
        "auto",
        "sync",
        "async"
      ],
      "optional": true
    },
    "menuItems": {
      "type": "AvatarMenuItem[]",
      "optional": true,
      "description": "When provided, renders an in-place dropdown menu triggered by the avatar"
    },
    "menuLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible label announced for the avatar menu trigger"
    },
    "variant": {
      "type": "union",
      "values": [
        "image",
        "initials"
      ],
      "optional": true,
      "description": "Controls whether the avatar prefers an image or initials"
    }
  },
