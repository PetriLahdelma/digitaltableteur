  "description": "Service tile with icon, title, description, and optional link.",
  "props": {
    "icon": {
      "type": "ReactNode",
      "optional": true,
      "description": "Icon element displayed at the top"
    },
    "title": {
      "type": "string",
      "optional": false,
      "description": "Card title"
    },
    "description": {
      "type": "string",
      "optional": false,
      "description": "Card description"
    },
    "href": {
      "type": "string",
      "optional": true,
      "description": "Optional link URL"
    },
    "variant": {
      "type": "union",
      "values": [
        "minimal",
        "default",
        "bordered",
        "elevated"
      ],
      "optional": true,
      "description": "Card style variant"
    },
    "iconPosition": {
      "type": "union",
      "values": [
        "left",
        "top"
      ],
      "optional": true,
      "description": "Icon position"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom className"
    },
    "donnyTarget": {
      "type": "string",
      "optional": true,
      "description": "Donny site action target id when this card is a spotlight anchor"
    }
  },
