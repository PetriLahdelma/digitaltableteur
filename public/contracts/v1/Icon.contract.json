{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Icon",
  "status": "stable",
  "description": "Phosphor icon wrapper with size, weight, and motion affordances.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Icon } from \"@digitaltableteur/react\";"
  },
  "props": {
    "name": {
      "type": "string",
      "optional": false,
      "description": "Phosphor icon name. Accepts PascalCase (e.g., \"ShareNetwork\") or slug (\"share-network\")."
    },
    "weight": {
      "type": "union",
      "values": [
        "thin",
        "light",
        "regular",
        "bold",
        "fill",
        "duotone"
      ],
      "optional": true,
      "description": "Optional Phosphor weight override."
    },
    "legacyStyle": {
      "type": "union",
      "values": [
        "thin",
        "light",
        "regular",
        "duotone",
        "solid",
        "brands"
      ],
      "optional": true,
      "description": "Legacy FontAwesome-style weight string kept for backward compatibility."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "xs",
        "2xs",
        "2xl"
      ],
      "optional": true,
      "description": "Tokenized or explicit pixel size."
    },
    "color": {
      "type": "string",
      "optional": true,
      "description": "SVG color override; defaults to the inherited current color."
    },
    "rotate": {
      "type": "0 | 90 | 180 | 270",
      "optional": true,
      "description": "Quarter-turn rotation applied to the glyph."
    },
    "flip": {
      "type": "union",
      "values": [
        "horizontal",
        "vertical",
        "both"
      ],
      "optional": true,
      "description": "Mirror the glyph along one or both axes."
    },
    "spin": {
      "type": "boolean",
      "optional": true,
      "description": "Apply the continuous rotation animation."
    },
    "pulse": {
      "type": "boolean",
      "optional": true,
      "description": "Apply the pulse animation when spin is not active."
    },
    "mirrored": {
      "type": "boolean",
      "optional": true,
      "description": "Use Phosphor's horizontal mirroring."
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for a meaningful icon."
    },
    "decorative": {
      "type": "boolean",
      "optional": true,
      "description": "Hide the icon from assistive technology. Defaults to true without ariaLabel."
    }
  },
