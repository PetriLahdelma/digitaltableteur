      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "xs",
        "2xl"
      ],
      "optional": true,
      "description": "Tokenized gap size."
    },
    "axis": {
      "type": "union",
      "values": [
        "horizontal",
        "vertical"
      ],
      "optional": true,
      "description": "Block (vertical) or inline (horizontal) axis."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class names."
    }
  },
