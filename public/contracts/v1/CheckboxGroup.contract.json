  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "CheckboxGroup",
  "status": "stable",
  "description": "Grouped checkboxes with optional master checkbox.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { CheckboxGroup } from \"@digitaltableteur/react\";"
  },
  "props": {
    "id": {
      "type": "string",
      "optional": true,
      "description": "Base id for the checkbox inputs"
    },
    "label": {
      "type": "string",
      "optional": false,
      "description": "Legend text for the group"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS classes on the group"
    },
    "options": {
      "type": "{ label: string; value: string }[]",
      "optional": false,
      "description": "Checkbox options (label, value)"
    },
    "showMasterCheckbox": {
      "type": "boolean",
      "optional": true,
      "description": "Shows the select-all master checkbox."
    },
    "masterLabel": {
      "type": "string",
      "optional": true,
      "description": "Label for the select-all master checkbox"
    },
    "hideLegend": {
      "type": "boolean",
      "optional": true,
      "description": "Keeps the legend as the accessible name but hides it visually, for a group whose section heading already names it."
    },
    "defaultSelected": {
      "type": "string[]",
      "optional": true,
      "description": "Initially selected option values (uncontrolled)"
    },
    "onChange": {
      "type": "(selectedOptions: string[]) => void",
      "optional": true
    }
  },
