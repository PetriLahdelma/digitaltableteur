  "specVersion": "1.0",
  "name": "CodeCopyButton",
  "status": "beta",
  "description": "Icon-only copy control for code surfaces: the copy glyph swaps to a check after a successful copy and a live region announces the result.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { CodeCopyButton } from \"@digitaltableteur/react\";"
  },
  "props": {
    "value": {
      "type": "string | (() => string)",
      "optional": false,
      "description": "Text to copy, or a function that returns it at click time."
    },
    "label": {
      "type": "string",
      "optional": true,
      "description": "Accessible name."
    },
    "onCopy": {
      "type": "(text: string) => void",
      "optional": true,
      "description": "Called with the copied text after a successful copy."
    },
    "resetAfterMs": {
      "type": "number",
      "optional": true,
      "description": "How long the check mark stays, in milliseconds."
    }
  },
