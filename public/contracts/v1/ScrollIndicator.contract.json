{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ScrollIndicator",
  "status": "stable",
  "description": "Animated affordance at the base of a hero that scrolls to the next section.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { ScrollIndicator } from \"@digitaltableteur/react\";"
  },
  "props": {
    "targetId": {
      "type": "string",
      "optional": true,
      "description": "ID of the target element to scroll to"
    },
    "label": {
      "type": "string",
      "optional": true,
      "description": "Optional text label"
    },
    "variant": {
      "type": "union",
      "values": [
        "arrow",
        "mouse",
        "chevron"
      ],
      "optional": true,
      "description": "Icon variant"
    },
    "position": {
      "type": "union",
      "values": [
        "center",
        "left",
        "right"
      ],
      "optional": true,
      "description": "Horizontal position"
    },
    "motion": {
      "type": "union",
      "values": [
        "none",
        "fade",
        "bounce",
        "pulse"
      ],
      "optional": true,
      "description": "Looping motion applied to the icon as a hint to scroll."
    },
    "speed": {
      "type": "number",
      "optional": true,
      "description": "Duration of one motion half-cycle, in seconds."
    },
    "distance": {
      "type": "number",
      "optional": true,
      "description": "Vertical travel of the bounce motion, in pixels (bounce only)."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom className for styling"
    }
  },
