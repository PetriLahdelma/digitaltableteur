  "specVersion": "1.0",
  "name": "Label",
  "status": "stable",
  "description": "Form field label with required, disabled, and tooltip affordances.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Label } from \"@digitaltableteur/react\";"
  },
  "props": {
    "htmlFor": {
      "type": "string",
      "optional": false,
      "description": "id of the form control this label describes."
    },
    "tooltipText": {
      "type": "string",
      "optional": true,
      "description": "Native tooltip text; used as a fallback when `title` is not set."
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Appends a \"*\" marker plus an sr-only \"(required)\" hint."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Dims the label and shows a not-allowed cursor."
    },
    "variant": {
      "type": "union",
      "values": [
        "option",
        "field"
      ],
      "optional": true,
      "description": "`field` names a control above or beside it (medium weight); `option` is\nthe text of a checkbox, radio or switch, which reads as plain text."
    }
  },
