{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Title",
  "status": "stable",
  "description": "Semantic heading with size and terminal (serif/sans) variants.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Title } from \"@digitaltableteur/react\";"
  },
  "props": {
    "children": {
      "type": "React.ReactNode | ReactI18NextChildren | Iterable<ReactI18NextChildren>",
      "optional": true,
      "description": "Heading text."
    },
    "as": {
      "type": "union",
      "values": [
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6"
      ],
      "optional": true,
      "description": "Override the rendered element (h1-h6); wins over level."
    },
    "className": {
      "type": "string | undefined",
      "optional": true,
      "description": "Additional CSS class names."
    },
    "unstyled": {
      "type": "boolean",
      "optional": true,
      "description": "When true, only sets the heading tag + className (no Title token typography). Use in patterns/pages that already define font/size in CSS or Tailwind."
    },
    "size": {
      "type": "union",
      "values": [
        "xl",
        "xs",
        "s",
        "xxs",
        "m",
        "l",
        "xxl"
      ],
      "optional": true,
      "description": "Display size token for the heading."
    },
    "level": {
      "type": "1 | 2 | 3 | 4 | 5 | 6",
      "optional": true,
      "description": "Semantic heading level (maps to h1-h6 when as is unset)."
    },
    "lineHeight": {
      "type": "union",
      "values": [
        "normal",
        "tight",
        "snug",
        "relaxed",
        "loose"
      ],
      "optional": true,
      "description": "Line height variant."
    }
  },
