{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "TeamBlock",
  "status": "stable",
  "description": "Team grid of member cards with photo, name, and role, plus round-image, column, and spacing knobs.",
  "props": {
    "members": {
      "type": "TeamMember[]",
      "optional": false,
      "description": "Array of team members to display"
    },
    "sectionTitle": {
      "type": "string",
      "optional": true,
      "description": "Optional section title"
    },
    "description": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Optional description or introduction text"
    },
    "columns": {
      "type": "2 | 3 | 4 | 5 | 6",
      "optional": true,
      "description": "Number of columns for desktop layout (2-6)"
    },
    "backgroundColor": {
      "type": "union",
      "values": [
        "transparent",
        "light",
        "white"
      ],
      "optional": true,
      "description": "Background color variant"
    },
    "maxWidth": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "full"
      ],
      "optional": true,
      "description": "Maximum width constraint"
    },
    "spacing": {
      "type": "union",
      "values": [
        "default",
        "compact",
        "comfortable",
        "spacious"
      ],
      "optional": true,
      "description": "Spacing variant"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class"
    },
    "as": {
      "type": "union",
      "values": [
        "article",
        "div",
        "section"
      ],
      "optional": true,
      "description": "Semantic HTML element to use"
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible label for the section"
    },
    "roundImages": {
      "type": "boolean",
      "optional": true,
      "description": "Show member images as circles instead of rounded squares"
    }
  },
