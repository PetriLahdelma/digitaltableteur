{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "PageLayout",
  "status": "stable",
  "description": "Page-body wrapper with a max-width container, default page margins, an optional grid mode, and a spacing scale.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { PageLayout } from \"@digitaltableteur/react\";"
  },
  "props": {
    "children": {
      "type": "React.ReactNode",
      "optional": false,
      "description": "Content to be displayed within the layout"
    },
    "maxWidth": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "full"
      ],
      "optional": true,
      "description": "Maximum width constraint for the content"
    },
    "grid": {
      "type": "boolean",
      "optional": true,
      "description": "Whether to use the 12-column grid system"
    },
    "columns": {
      "type": "number",
      "optional": true,
      "description": "Number of columns for grid layout (only applies when grid=true)\nAutomatically responsive: 4 cols mobile, 8 cols tablet, 12 cols desktop"
    },
    "spacing": {
      "type": "union",
      "values": [
        "default",
        "compact",
        "comfortable",
        "spacious"
      ],
      "optional": true,
      "description": "Vertical spacing between sections"
    },
    "withMargins": {
      "type": "boolean",
      "optional": true,
      "description": "Apply consistent page margins"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class name"
    },
    "as": {
      "type": "union",
      "values": [
        "article",
        "main",
        "div",
        "section"
      ],
      "optional": true,
      "description": "Semantic HTML element to use for the container"
    },
    "role": {
      "type": "string",
      "optional": true,
      "description": "ARIA role for accessibility"
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "ARIA label for accessibility"
    },
    "style": {
      "type": "React.CSSProperties",
      "optional": true
    }
  },
  "rules": [
    {
      "id": "pagelayout-columns-need-grid",
      "when": {
        "columns": {
          "present": true
        },
        "grid": {
          "absent": true
        }
      },
      "requireAllOf": [
        "grid"
      ],
      "reason": "`columns` only applies when `grid` is true; `grid` defaults to false, so the column count is dropped.",
      "severity": "error",
      "evidence": "PageLayout.tsx gridStyle: returns {} when !grid"
    },
    {
      "id": "pagelayout-columns-with-grid-off",
      "when": {
        "grid": {
          "equals": false
        }
      },
      "forbid": [
        "columns"
      ],
      "reason": "`columns` only applies when `grid` is true.",
      "severity": "error",
      "evidence": "PageLayout.tsx gridStyle: returns {} when !grid"
    }
  ],
