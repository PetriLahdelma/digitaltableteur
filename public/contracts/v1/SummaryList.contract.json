  "name": "SummaryList",
  "status": "alpha",
  "description": "Questions and their answers as a description list, one row per question with an optional action: for checking answers before submitting and for showing a submitted record.",
  "props": {
    "rows": {
      "type": "SummaryListRow[]",
      "optional": false,
      "description": "Rows in order."
    },
    "layout": {
      "type": "union",
      "values": [
        "auto",
        "stacked"
      ],
      "optional": true,
      "description": "\"auto\" stacks the label above the value in narrow containers and puts\nthem side by side once the list is wide enough (about 40rem)."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Merged onto the dl element."
    }
  },
