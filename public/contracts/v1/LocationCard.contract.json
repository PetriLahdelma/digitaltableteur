    "officeName": {
      "type": "string",
      "optional": false,
      "description": "Office name heading"
    },
    "address": {
      "type": "string[]",
      "optional": false,
      "description": "Address lines"
    },
    "email": {
      "type": "string",
      "optional": true,
      "description": "Contact email"
    },
    "phone": {
      "type": "string",
      "optional": true,
      "description": "Contact phone"
    },
    "variant": {
      "type": "union",
      "values": [
        "default",
        "bordered",
        "elevated"
      ],
      "optional": true,
      "description": "Card variant"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom className"
    }
  },
