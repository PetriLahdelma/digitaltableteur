  "specVersion": "1.0",
  "name": "HeroSection",
  "status": "stable",
  "description": "Full-bleed hero shell with min-height, alignment, and background variants.",
  "props": {
    "children": {
      "type": "ReactNode",
      "optional": false,
      "description": "Hero content"
    },
    "background": {
      "type": "union",
      "values": [
        "image",
        "transparent",
        "solid",
        "gradient"
      ],
      "optional": true,
      "description": "Background style variant"
    },
    "backgroundImage": {
      "type": "string",
      "optional": true,
      "description": "Background image URL (only used when background=\"image\")"
    },
    "minHeight": {
      "type": "union",
      "values": [
        "auto",
        "hero",
        "screen",
        "half"
      ],
      "optional": true,
      "description": "Minimum height of the hero section"
    },
