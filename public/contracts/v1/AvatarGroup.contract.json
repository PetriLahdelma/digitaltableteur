  "name": "AvatarGroup",
  "status": "beta",
  "description": "Overlapping stack of Avatars with a +N overflow bubble.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { AvatarGroup } from \"@digitaltableteur/react\";"
  },
  "props": {
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the cluster (e.g. \"Project members\")."
    },
    "max": {
      "type": "number",
      "optional": true,
      "description": "Avatars beyond this count collapse into a \"+N\" bubble."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size of the overflow bubble; children Avatars should match\n(sm=2rem, md=2.5rem, lg=3rem)."
    },
    "children": {
      "type": "React.ReactNode",
      "optional": false
    }
  },
