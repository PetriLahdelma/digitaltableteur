{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Combobox",
  "status": "stable",
  "description": "Single-select combobox with portaled dropdown, shared with MultiCombobox.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Combobox } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Field label; associates the trigger"
    },
    "options": {
      "type": "ComboboxOption[]",
      "optional": false,
      "description": "Selectable options"
    },
    "value": {
      "type": "string",
      "optional": false,
      "description": "Selected option value (controlled); \"\" shows the placeholder"
    },
    "onValueChange": {
      "type": "(value: string) => void",
      "optional": false,
      "description": "Called with the chosen value"
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Explicit control id (wires the label); auto-generated when omitted"
    },
    "placeholder": {
      "type": "string",
      "optional": true,
      "description": "Shown when no value is selected"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Assistive text below the field"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message; renders above the helper line and sets aria-invalid"
    },
    "status": {
      "type": "FieldStatus",
      "optional": true,
      "description": "Semantic state: colours the border and styles statusMessage. `error` overrides it."
    },
    "statusMessage": {
      "type": "string",
      "optional": true,
      "description": "Message under the field for `status`, above the helper line"
    },
    "actions": {
      "type": "FieldAction[]",
      "optional": true,
      "description": "Icon buttons at the end of the label row: each runs an operation or opens a menu"
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Marks the field required."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables the control."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Classes on the field wrapper"
    },
    "size": {
      "type": "FieldSize",
      "optional": true,
      "description": "Field size shared by every DS field: 40, 48 or 56px tall."
    },
    "name": {
      "type": "string",
      "optional": true,
      "description": "Submits the value with a surrounding form, through a hidden input"
    }
  },
