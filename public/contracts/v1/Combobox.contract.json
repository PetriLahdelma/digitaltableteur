{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Combobox",
  "status": "stable",
  "description": "Single-select combobox with portaled dropdown, shared with MultiCombobox.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Combobox } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Field label; associates the trigger"
    },
    "options": {
      "type": "ComboboxOption[]",
      "optional": false,
      "description": "Selectable options"
    },
    "value": {
      "type": "string",
      "optional": false,
      "description": "Selected option value (controlled); \"\" shows the placeholder"
    },
    "onValueChange": {
      "type": "(value: string) => void",
      "optional": false,
      "description": "Called with the chosen value"
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Explicit control id (wires the label); auto-generated when omitted"
    },
    "placeholder": {
      "type": "string",
      "optional": true,
      "description": "Shown when no value is selected"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Assistive text below the field"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message; renders above the helper line and sets aria-invalid"
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Marks the field required."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables the control."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Classes on the field wrapper"
    }
  },
