{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "TextArea",
  "status": "stable",
  "description": "Multi-line text field with label, error/helper text, and optional animated auto-grow.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { TextArea } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Visible field label"
    },
    "value": {
      "type": "string",
      "optional": true,
      "description": "Value synced into the field; typing still works after it is set"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Validation error message; renders above the helper line"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Helper copy below the field"
    },
    "onChange": {
      "type": "(value: string) => void",
      "optional": true,
      "description": "Change handler receiving the raw string value"
    },
    "animateResize": {
      "type": "boolean",
      "optional": true,
      "description": "Enable smooth animated auto-growing (default: false)"
    },
    "minRows": {
      "type": "number",
      "optional": true,
      "description": "Minimum number of rows when animateResize is enabled"
    },
    "maxRows": {
      "type": "number",
      "optional": true,
      "description": "Maximum number of rows when animateResize is enabled"
    }
  },
