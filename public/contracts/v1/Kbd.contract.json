        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size token."
    },
    "variant": {
      "type": "union",
      "values": [
        "primary",
        "secondary"
      ],
      "optional": true,
      "description": "Visual style. `primary` is a filled light-gray keycap with a bottom edge\nthat reads like a physical key; `secondary` is the flatter outlined chip."
    }
  },
