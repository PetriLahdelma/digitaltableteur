{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "StageList",
  "status": "beta",
  "description": "Places entries by the lifecycle stage they belong to, so a reader at any stage finds what applies now. Five layouts over one data model: sheet, rail, index, checklist and cards.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { StageList } from \"@digitaltableteur/react\";"
  },
  "props": {
    "items": {
      "type": "StageListItem[]",
      "optional": false,
      "description": "Entries to place by stage; each sits under the first stage it lists."
    },
    "stages": {
      "type": "StageListStage[]",
      "optional": false,
      "description": "Lifecycle stages in order."
    },
    "phases": {
      "type": "StageListPhase[]",
      "optional": true,
      "description": "Groups consecutive stages into phases for the sheet, checklist and cards layouts."
    },
    "variant": {
      "type": "union",
      "values": [
        "sheet",
        "rail",
        "index",
        "checklist",
        "cards"
      ],
      "optional": true,
      "description": "Layout of the list."
    },
    "headingLevel": {
      "type": "union",
      "values": [
        "2",
        "3",
        "4"
      ],
      "optional": true,
      "description": "Level of the top headings the list renders."
    },
    "storageKey": {
      "type": "string",
      "optional": true,
      "description": "Checklist only: localStorage key that keeps ticks between visits."
    },
    "indexLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the index layout's overview navigation."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional className for the root element."
    }
  },
  "accessibility": {
