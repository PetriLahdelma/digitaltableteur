{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "BlogNav",
  "status": "stable",
  "description": "Blog article sub-navigation: a back-to-articles action plus previous/next controls for stepping through the article sequence.",
  "props": {
    "currentPath": {
      "type": "string",
      "optional": true,
      "description": "Active route used to compute the prev/next disabled state. Defaults to the\ncurrent pathname from the router; stories and tests override it to show a\ngiven position in the article sequence."
    },
    "pages": {
      "type": "readonly BlogNavPage[]",
      "optional": true,
      "description": "Ordered article paths. Defaults to the bundled legacy sequence."
    },
    "onNavigate": {
      "type": "(path: string) => void",
      "optional": true,
      "description": "Host navigation callback. Defaults to the configured navigation runtime."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables every action while host navigation is pending."
    }
  },
