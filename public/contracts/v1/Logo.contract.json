{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Logo",
  "status": "stable",
  "description": "Logo atom — the Digitaltableteur mark by default (monochrome currentColor, square footprint, optional controlled pulse), or any custom PNG/JPEG/SVG logo via src.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Logo } from \"@digitaltableteur/react\";"
  },
  "props": {
    "src": {
      "type": "string",
      "optional": true,
      "description": "Optional image URL (PNG, JPEG, or SVG) rendered instead of the built-in\nDigitaltableteur mark. `title` becomes the alt text; `animated` and\n`background` apply to the built-in mark only and are ignored when `src` is\nset."
    },
    "size": {
      "type": "number",
      "optional": true,
      "description": "Square render box in pixels. Default 24."
    },
    "animated": {
      "type": "boolean",
      "optional": true,
      "description": "Pulse the three leading bars while true; a controlled signal driven from the\nconsumer's hover/focus state (respects prefers-reduced-motion). Default false."
    },
    "background": {
      "type": "boolean",
      "optional": true,
      "description": "Render the brand lime circle background behind a contrast mark\n(`--logo-background` / `--logo-color`). Default false."
    },
    "title": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the mark. Ignored when `decorative`. Default \"Digitaltableteur\"."
    },
    "decorative": {
      "type": "boolean",
      "optional": true,
      "description": "When true the mark is purely decorative and removed from the accessibility tree. Default false."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional utility/spacing classes."
    }
  },
  "rules": [
    {
      "id": "logo-src-ignores-mark-options",
      "when": {
        "src": {
          "present": true
        }
      },
      "forbid": [
        "animated",
        "background"
      ],
      "reason": "`animated` and `background` style the built-in mark only; with `src` set they are ignored.",
      "severity": "warning",
      "evidence": "Logo.tsx src branch returns before background/animated are applied"
    },
    {
      "id": "logo-decorative-ignores-title",
      "when": {
        "decorative": {
          "equals": true
        }
      },
      "forbid": [
        "title"
      ],
      "reason": "A decorative logo is removed from the accessibility tree, so `title` is never announced. Drop `title` or make the logo non-decorative.",
      "severity": "warning",
      "evidence": "Logo.tsx: title is not rendered when decorative"
    }
  ],
