{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "WorkNav",
  "status": "stable",
  "description": "Work section sub-navigation: a back-to-index action plus previous/next controls for stepping through the portfolio case studies.",
  "props": {
    "currentPath": {
      "type": "string",
      "optional": true,
      "description": "Active route used to compute the prev/next disabled state. Defaults to the\ncurrent pathname from the router; stories and tests override it to show a\ngiven position in the work sequence."
    },
    "pages": {
      "type": "readonly WorkNavPage[]",
      "optional": true,
      "description": "Ordered case-study paths. Defaults to the bundled legacy sequence."
    },
    "onNavigate": {
      "type": "(path: string) => void",
      "optional": true,
      "description": "Host navigation callback. Defaults to the configured navigation runtime."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables every action while host navigation is pending."
    }
  },
