{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Accordion",
  "status": "beta",
  "description": "Coordinated disclosure group: single or multiple open sections, animated reveal, keyboard-operable triggers.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Accordion } from \"@digitaltableteur/react\";"
  },
  "props": {
    "items": {
      "type": "AccordionItem[]",
      "optional": false,
      "description": "Accordion sections (id, title, content, optional disabled)."
    },
    "type": {
      "type": "union",
      "values": [
        "single",
        "multiple"
      ],
      "optional": true,
      "description": "\"single\" (default) keeps at most one section open — opening another closes\nthe previous. \"multiple\" lets any number stay open for side-by-side reading."
    },
    "variant": {
      "type": "union",
      "values": [
        "contained",
        "enclosed",
        "divided"
      ],
      "optional": true,
      "description": "\"contained\" (default) is a bordered card group with dividers between rows;\n\"enclosed\" is the same outer border but seamless inside (no dividers);\n\"divided\" is flush with hairline separators only, for inline disclosure."
    },
    "defaultOpenId": {
      "type": "string",
      "optional": true,
      "description": "Initially open id (uncontrolled, single)."
    },
    "defaultOpenIds": {
      "type": "string[]",
      "optional": true,
      "description": "Initially open ids (uncontrolled); wins over defaultOpenId when set."
    },
    "openIds": {
      "type": "string[]",
      "optional": true,
      "description": "Controlled open ids. When set, the parent owns open state."
    },
    "onOpenChange": {
      "type": "(openIds: string[]) => void",
      "optional": true,
      "description": "Called with the full set of open ids whenever it changes."
    },
    "headingLevel": {
      "type": "2 | 3 | 4 | 5 | 6",
      "optional": true,
      "description": "Wraps each trigger in a heading of this level, so the section titles\njoin the page outline (screen reader users list and jump by headings).\nPick the level below the heading that introduces the accordion. Unset,\ntriggers are plain buttons."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional utility classes on the container."
    }
  },
