{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Tooltip",
  "status": "beta",
  "description": "Radix tooltip primitive set (Provider, Trigger, Content) for icon hints.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Tooltip } from \"@digitaltableteur/react\";"
  },
  "props": {
    "className": {
      "type": "string",
      "optional": true,
      "description": "Extra class on the content bubble."
    },
    "side": {
      "type": "union",
      "values": [
        "left",
        "right",
        "top",
        "bottom"
      ],
      "optional": true,
      "description": "Preferred placement relative to the trigger; flips when out of room."
    },
    "sideOffset": {
      "type": "number",
      "optional": true,
      "description": "Gap in px between the trigger and the bubble."
    },
    "children": {
      "type": "ReactNode",
      "optional": false,
      "description": "Hint content — a short phrase, never interactive."
    },
    "shortcut": {
      "type": "string[]",
      "optional": true,
      "description": "Keys held together for the trigger's action, one entry per key; rendered after the label as keycaps joined by plus signs. Modifier symbols (⌘ ⇧ ⌥ ⌃ ⌫ ↵) render as icons with a translated key name for assistive technology."
    }
  },
