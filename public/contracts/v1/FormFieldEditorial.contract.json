  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "FormFieldEditorial",
  "status": "stable",
  "description": "Uppercase-label form field for editorial contact flows.",
  "props": {
    "type": {
      "type": "union",
      "values": [
        "text",
        "tel",
        "email",
        "textarea",
        "select"
      ],
      "optional": true
    },
    "children": {
      "type": "ReactNode",
      "optional": true,
      "description": "Select options"
    },
    "label": {
      "type": "string",
      "optional": false,
      "description": "Field label (displayed as uppercase)"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message"
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Whether the field is required"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional className"
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Field ID (auto-generated from label if not provided)"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Supporting text under the field, linked with aria-describedby. Text and textarea fields only; use it to say why a read-only value is fixed."
    },
    "status": {
      "type": "FieldStatus",
      "optional": true,
      "description": "Semantic state: colours the border and styles statusMessage. `error` overrides it."
    },
    "statusMessage": {
      "type": "string",
      "optional": true,
      "description": "Message under the field for `status`, above the helper line"
    },
    "actions": {
      "type": "FieldAction[]",
      "optional": true,
      "description": "Icon buttons at the end of the label row: each runs an operation or opens a menu"
    }
  },
