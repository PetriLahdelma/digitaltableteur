  "status": "stable",
  "description": "Uppercase-label form field for editorial contact flows.",
  "props": {
    "type": {
      "type": "union",
      "values": [
        "text",
        "tel",
        "email",
        "textarea",
        "select"
      ],
      "optional": true
    },
    "children": {
      "type": "ReactNode",
      "optional": true,
      "description": "Select options"
    },
    "label": {
      "type": "string",
      "optional": false,
      "description": "Field label (displayed as uppercase)"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message"
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Whether the field is required"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional className"
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Field ID (auto-generated from label if not provided)"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Supporting text under the field, linked with aria-describedby. Text and textarea fields only; use it to say why a read-only value is fixed."
    }
  },
