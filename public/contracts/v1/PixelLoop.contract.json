  "governance": {
    "owner": "design-system",
    "lastReviewed": "2026-10-31",
    "note": "The Primary Studio reference informed the compact modular format, while original 5x5 vector cell-grid artwork, round marks, row-aware choreography, and timing establish a distinct implementation. Supports one, two, or three rows of three glyph grids."
  },
