{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "PixelLoop",
  "status": "beta",
  "description": "Decorative constellation loop with rounded-dot and 45-degree vector-stroke variants; the glyph pool includes the studio D and T initials.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { PixelLoop } from \"@digitaltableteur/react\";"
  },
  "props": {
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Scales the glyphs and the equal space between them."
    },
    "variant": {
      "type": "union",
      "values": [
        "dots",
        "strokes"
      ],
      "optional": true,
      "description": "Rounded dots or short, round-capped 45-degree strokes."
    },
    "rows": {
      "type": "PixelLoopRows",
      "optional": true,
      "description": "Number of three-cell rows in the field."
    },
    "animate": {
      "type": "boolean",
      "optional": true,
      "description": "Runs the cross-fade cycle. Disable for a deliberate static composition."
    },
    "cycle": {
      "type": "boolean",
      "optional": true,
      "description": "Renders a single glyph cell (one row, one column) that steps through the whole glyph pool one formation at a time. Ignores `rows`."
    }
  },
