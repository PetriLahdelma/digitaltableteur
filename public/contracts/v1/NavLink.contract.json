{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "NavLink",
  "status": "stable",
  "description": "Navigation anchor primitive used inside `SiteHeader`, `Footer`, and in-page navs. Renders an underlying `next/link` and applies the `aria-current='page'` token when the active route matches.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { NavLink } from \"@digitaltableteur/react\";"
  },
  "props": {
    "href": {
      "type": "string",
      "optional": false,
      "description": "Route path for next/link."
    },
    "children": {
      "type": "ReactNode",
      "optional": false,
      "description": "Navigation link label."
    },
    "exact": {
      "type": "boolean",
      "optional": true,
      "description": "Match href exactly for the active state instead of by prefix."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Base class names applied in every state."
    },
    "activeClassName": {
      "type": "string",
      "optional": true,
      "description": "Class names applied when the route is active."
    },
    "inactiveClassName": {
      "type": "string",
      "optional": true,
      "description": "Class names applied when the route is inactive."
    },
    "onClick": {
      "type": "() => void",
      "optional": true,
      "description": "Called when the link is activated. Fires only for the navigable anchor;\nthe current-page indicator is a non-interactive span and never calls it.\nLets containers (the mobile drawer) close as soon as the visitor taps a\ndestination instead of waiting for the route change to land."
    }
  },
