{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "AuthorBio",
  "status": "stable",
  "description": "Author biography card: avatar, name, role, and markdown bio. Fully input-driven — pass the details directly, or pass slug to resolve them from the site's author registry (direct props override registry fields).",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { AuthorBio } from \"@digitaltableteur/react\";"
  },
  "props": {
    "slug": {
      "type": "string",
      "optional": true,
      "description": "Optional author slug resolved from the site's authors registry; direct\nprops below override the registry fields."
    },
    "name": {
      "type": "string",
      "optional": true,
      "description": "Author name. Required unless `slug` resolves it."
    },
    "imageUrl": {
      "type": "string | { default: string } | StaticImageData",
      "optional": true,
      "description": "Avatar image source: a URL, an imported asset path, or static image data."
    },
    "role": {
      "type": "string",
      "optional": true,
      "description": "Role/title shown under the name (e.g. \"Founder, CEO\")."
    },
    "bio": {
      "type": "string",
      "optional": true,
      "description": "Biography text; markdown after the first paragraph. The first paragraph\nrenders as the lead/tagline."
    },
    "email": {
      "type": "string",
      "optional": true,
      "description": "Contact email rendered as a mailto link when `showContact` is set."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional CSS class for styling extension"
    },
    "heading": {
      "type": "string",
      "optional": true,
      "description": "Optional custom heading text (defaults to the author name)"
    },
    "showContact": {
      "type": "boolean",
      "optional": true,
      "description": "Render the author's contact email (mailto) after the bio, if the author has one."
    }
  },
