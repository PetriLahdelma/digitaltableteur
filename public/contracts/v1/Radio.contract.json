  "specVersion": "1.0",
  "name": "Radio",
  "status": "beta",
  "description": "Single radio option; compose with RadioGroup for sets.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Radio } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Option label"
    },
    "value": {
      "type": "string",
      "optional": false,
      "description": "Submitted value when selected"
    },
    "name": {
      "type": "string",
      "optional": false,
      "description": "Group name; must match siblings to form the exclusive set"
    },
    "checked": {
      "type": "boolean",
      "optional": true,
      "description": "Checked state (controlled); use inside RadioGroup for sets."
    },
    "defaultChecked": {
      "type": "boolean",
      "optional": true,
      "description": "Initial checked state (uncontrolled mode only)"
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables interaction and dims the control."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "S",
        "M",
        "L"
      ],
      "optional": true,
      "description": "Control hit area."
    },
    "onCheckedChange": {
      "type": "(checked: boolean) => void",
      "optional": true,
      "description": "Fired with the next checked value when selection changes"
    },
    "showLabel": {
      "type": "boolean",
      "optional": true,
      "description": "Render the visible label."
    }
  },
