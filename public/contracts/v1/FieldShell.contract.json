{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "FieldShell",
  "status": "beta",
  "description": "The frame every text and choice field is built on: a label row with icon actions at its end, the control, then a status message and a helper line.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { FieldShell } from \"@digitaltableteur/react\";"
  },
  "props": {
    "controlId": {
      "type": "string",
      "optional": false,
      "description": "id of the control inside; the label, status and helper ids derive from it."
    },
    "label": {
      "type": "string",
      "optional": false,
      "description": "Visible field label."
    },
    "children": {
      "type": "React.ReactNode",
      "optional": false,
      "description": "The control: an input, textarea, select or composite control."
    },
    "status": {
      "type": "union",
      "values": [
        "success",
        "warning",
        "error"
      ],
      "optional": true,
      "description": "Semantic state; pairs with `statusMessage`."
    },
    "statusMessage": {
      "type": "string",
      "optional": true,
      "description": "Message under the control, styled and announced for `status`."
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Supporting copy under the control, after the status message."
    },
    "actions": {
      "type": "FieldAction[]",
      "optional": true,
      "description": "Icon buttons at the end of the label row, level with the label."
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Shows the required marker on the label."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Dims the label and disables every action."
    },
    "hideLabel": {
      "type": "boolean",
      "optional": true,
      "description": "Visually hides the label; it stays the control's accessible name."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Merged onto the field wrapper."
    }
  },
