{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "SegmentedControl",
  "status": "beta",
  "description": "Single-select segmented control: a compact, pill-shaped row of mutually exclusive options with one visibly selected, as a radiogroup with roving-tabindex arrow-key navigation. The selection indicator slides between options.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { SegmentedControl } from \"@digitaltableteur/react\";"
  },
  "props": {
    "items": {
      "type": "SegmentedControlItem[]",
      "optional": false,
      "description": "Segments to render, in order."
    },
    "value": {
      "type": "string",
      "optional": false,
      "description": "Currently selected value (controlled)."
    },
    "onValueChange": {
      "type": "(value: string) => void",
      "optional": false,
      "description": "Called with the new value when a segment is selected."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size token."
    },
    "ariaLabel": {
      "type": "string",
      "optional": false,
      "description": "Accessible name for the group (required; announced by screen readers)."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class names."
    }
  },
