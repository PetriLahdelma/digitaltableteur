  "name": "ResizablePanelGroup",
  "status": "beta",
  "description": "Two-or-more-panel layout with pointer and keyboard-accessible resize separators.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { ResizablePanelGroup } from \"@digitaltableteur/react\";"
  },
  "props": {
    "panels": {
      "type": "ResizablePanel[]",
      "optional": false,
      "description": "Two or more ordered panels."
    },
    "orientation": {
      "type": "union",
      "values": [
        "horizontal",
        "vertical"
      ],
      "optional": true,
      "description": "Resize axis."
    },
    "keyboardStep": {
      "type": "number",
      "optional": true,
      "description": "Keyboard resize increment in percentage points."
    },
    "onSizesChange": {
      "type": "(sizes: Record<string, number>) => void",
      "optional": true,
      "description": "Receives the current percentage per panel id."
    },
    "className": {
      "type": "string",
      "optional": true
    }
  },
