{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Tabs",
  "status": "stable",
  "description": "Tablist navigation with keyboard support, a sliding selection indicator, and per-item icon/count.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Tabs } from \"@digitaltableteur/react\";"
  },
  "props": {
    "activeTab": {
      "type": "string",
      "optional": true,
      "description": "Active tab key (controlled mode); \"\" is treated as absent."
    },
    "defaultActiveTab": {
      "type": "string",
      "optional": true,
      "description": "Initially active tab key (uncontrolled mode)."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size."
    },
    "tabs": {
      "type": "TabItem[]",
      "optional": false,
      "description": "Array of tab items with key, label, optional disabled/icon/count."
    },
    "onTabChange": {
      "type": "(key: string) => void",
      "optional": true,
      "description": "Called with the clicked tab's key."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional utility classes on the tablist."
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible label for the tablist."
    },
    "variant": {
      "type": "union",
      "values": [
        "pills",
        "underline",
        "default"
      ],
      "optional": true,
      "description": "Visual style variant."
    }
  },
