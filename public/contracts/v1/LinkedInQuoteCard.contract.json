{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "LinkedInQuoteCard",
  "status": "beta",
  "description": "Quote card styled like a LinkedIn post for embedding social content in articles without an external embed.",
  "props": {
    "quote": {
      "type": "string",
      "optional": false,
      "description": "The quote/post text"
    },
    "name": {
      "type": "string",
      "optional": false,
      "description": "Name of the person"
    },
    "title": {
      "type": "string",
      "optional": false,
      "description": "Title/position of the person"
    },
    "company": {
      "type": "string",
      "optional": false,
      "description": "Company name"
    },
    "connectionDegree": {
      "type": "string",
      "optional": true,
      "description": "Connection degree (e.g., \"1st\", \"2nd\", \"3rd\")"
    },
    "linkedinUrl": {
      "type": "string",
      "optional": true,
      "description": "LinkedIn profile URL (optional)"
    },
    "avatarUrl": {
      "type": "string",
      "optional": true,
      "description": "Avatar image URL (optional)"
    },
    "companyLogoUrl": {
      "type": "string",
      "optional": true,
      "description": "Company logo URL (optional, displayed at bottom)"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS classes"
    },
    "variant": {
      "type": "union",
      "values": [
        "muted",
        "light",
        "dark"
      ],
      "optional": true,
      "description": "Background color variant"
    }
  },
