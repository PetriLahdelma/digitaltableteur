{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ListItem",
  "status": "stable",
  "description": "Presentational row for menus, selects, palettes, and lists: leading icon, truncating label, end-aligned meta (text, Badge, Kbd, StatusDot, value), trailing icon, selection check, and a destructive tone. Consumers own semantics.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { ListItem } from \"@digitaltableteur/react\";"
  },
  "props": {
    "children": {
      "type": "React.ReactNode",
      "optional": false,
      "description": "Primary label. Truncates with an ellipsis; never wraps."
    },
    "icon": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Leading icon node; rendered in a fixed gutter so labels column-align."
    },
    "meta": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "End-aligned secondary content: muted small text, Badge, Kbd, StatusDot, or a value. Exposed to AT."
    },
    "trailingIcon": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Trailing icon after meta (chevron, external-link). Decorative."
    },
    "selected": {
      "type": "boolean",
      "optional": true,
      "description": "Renders the check indicator in the trailing position. Visual only; semantic selection belongs to the consumer."
    },
    "tone": {
      "type": "union",
      "values": [
        "neutral",
        "destructive"
      ],
      "optional": true,
      "description": "Destructive rows (deletions) use the error color treatment."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Visual disabled treatment via the canonical disabled tokens. The consumer carries aria-disabled."
    },
    "highlighted": {
      "type": "boolean",
      "optional": true,
      "description": "Parent-driven active row (combobox/palette). Radix menus work without it via [data-highlighted]."
    },
    "className": {
      "type": "string",
      "optional": true
    }
  },
