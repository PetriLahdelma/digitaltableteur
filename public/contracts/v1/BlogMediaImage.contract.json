{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "BlogMediaImage",
  "status": "stable",
  "description": "Blog-optimized responsive image: renders raster sources through next/image and SVG sources as a plain img, with fill, cover/contain fit and a fluid full-bleed mode.",
  "props": {
    "src": {
      "type": "string",
      "optional": false
    },
    "alt": {
      "type": "string",
      "optional": false
    },
    "fill": {
      "type": "boolean",
      "optional": true
    },
    "width": {
      "type": "number",
      "optional": true
    },
    "height": {
      "type": "number",
      "optional": true
    },
    "className": {
      "type": "string",
      "optional": true
    },
    "priority": {
      "type": "boolean",
      "optional": true
    },
    "sizes": {
      "type": "string",
      "optional": true
    },
    "onLoad": {
      "type": "() => void",
      "optional": true
    },
    "onError": {
      "type": "() => void",
      "optional": true
    },
    "fit": {
      "type": "union",
      "values": [
        "cover",
        "contain"
      ],
      "optional": true,
      "description": "Diagram heroes should use contain; photos use cover."
    },
    "fluid": {
      "type": "boolean",
      "optional": true,
      "description": "When true, image spans its container (no max-width cap from width prop)."
    }
  },
