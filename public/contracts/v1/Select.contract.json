{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Select",
  "status": "stable",
  "description": "Single-choice field that opens the DS option list (a select-only combobox), with labelled options, statuses, label-row actions and size tokens.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Select } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Label text displayed above the select dropdown"
    },
    "options": {
      "type": "SelectOptionItem[]",
      "optional": true,
      "description": "Option objects with value, label, and optional disabled; children override this"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Supporting text under the control; always rendered, below `error` when both are set."
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message under the control; sets aria-invalid and aria-describedby."
    },
    "status": {
      "type": "FieldStatus",
      "optional": true,
      "description": "Semantic state: colours the border and styles statusMessage. `error` overrides it."
    },
    "statusMessage": {
      "type": "string",
      "optional": true,
      "description": "Message under the control for `status`, above the helper line"
    },
    "actions": {
      "type": "FieldAction[]",
      "optional": true,
      "description": "Icon buttons at the end of the label row: each runs an operation or opens a menu"
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "S",
        "M",
        "L"
      ],
      "optional": true,
      "description": "Size variant for select"
    },
    "onValueChange": {
      "type": "(value: string) => void",
      "optional": true,
      "description": "Value change handler (recommended)"
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables the select. Declared explicitly (not just via the native attribute extension) so the agent-blocks prop extraction sees it."
    },
    "onChange": {
      "type": "(value: string) => void",
      "optional": true,
      "deprecated": {
        "reason": "Renamed to onValueChange; a development warning fires on use.",
        "replacement": "onValueChange"
      }
    },
    "children": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "`<option>` or `SelectOption` children; an option with value \"\" becomes the placeholder"
    },
    "value": {
      "type": "string",
      "optional": true,
      "description": "Selected value (controlled); \"\" shows the placeholder"
    },
    "defaultValue": {
      "type": "string",
      "optional": true,
      "description": "Initial value when uncontrolled"
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Marks the field required."
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Explicit control id (wires the label); auto-generated when omitted"
    },
    "name": {
      "type": "string",
      "optional": true,
      "description": "Submits the value with a surrounding form, through a hidden input"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Classes on the field wrapper"
    }
  },
