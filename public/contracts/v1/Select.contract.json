{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Select",
  "status": "stable",
  "description": "Native dropdown select with labelled options, error state, and size tokens.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Select } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Label text displayed above the select dropdown"
    },
    "options": {
      "type": "SelectOptionItem[]",
      "optional": true,
      "description": "Option objects with value, label, and optional disabled; children override this"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Supporting text under the control; always rendered, below `error` when both are set."
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message under the control; sets aria-invalid and aria-describedby."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "S",
        "M",
        "L"
      ],
      "optional": true,
      "description": "Size variant for select"
    },
    "onValueChange": {
      "type": "(value: string) => void",
      "optional": true,
      "description": "Value change handler (recommended)"
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables the select. Declared explicitly (not just via the native attribute extension) so the agent-blocks prop extraction sees it."
    },
    "onChange": {
      "type": "(value: string) => void",
      "optional": true,
      "deprecated": {
        "reason": "Renamed to onValueChange; a development warning fires on use.",
        "replacement": "onValueChange"
      }
    }
  },
