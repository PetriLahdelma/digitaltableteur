  "description": "Flexbox layout primitive for stacks and rows.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { FlexBox } from \"@digitaltableteur/react\";"
  },
  "props": {
    "direction": {
      "type": "union",
      "values": [
        "row",
        "row-reverse",
        "column",
        "column-reverse"
      ],
      "optional": true,
      "description": "flex-direction."
    },
    "wrap": {
      "type": "union",
      "values": [
        "nowrap",
        "wrap",
        "wrap-reverse"
      ],
      "optional": true,
      "description": "flex-wrap."
    },
    "justify": {
      "type": "union",
      "values": [
        "center",
        "flex-start",
        "flex-end",
        "space-between",
        "space-around",
        "space-evenly"
      ],
      "optional": true,
      "description": "Main-axis distribution."
    },
    "align": {
      "type": "union",
      "values": [
        "center",
        "flex-start",
        "flex-end",
        "stretch",
        "baseline"
      ],
      "optional": true,
      "description": "Cross-axis item alignment."
    },
    "alignContent": {
      "type": "union",
      "values": [
        "center",
        "flex-start",
        "flex-end",
        "space-between",
        "space-around",
        "stretch"
      ],
      "optional": true,
      "description": "Cross-axis line distribution when wrapping."
    },
    "gap": {
      "type": "string | number",
      "optional": true,
      "description": "Shorthand gap (CSS length or number of px)."
    },
    "rowGap": {
      "type": "string | number",
      "optional": true,
      "description": "Row gap override."
    },
    "columnGap": {
      "type": "string | number",
      "optional": true,
      "description": "Column gap override."
    },
    "style": {
      "type": "React.CSSProperties",
      "optional": true,
      "description": "Inline style overrides applied after generated flex declarations."
    },
    "children": {
      "type": "React.ReactNode",
      "optional": false,
      "description": "Flex items rendered inside the container."
    }
  },
