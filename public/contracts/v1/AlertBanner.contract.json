{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "AlertBanner",
  "status": "stable",
  "description": "Inline alert for info, warning, success, and error feedback.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { AlertBanner } from \"@digitaltableteur/react\";"
  },
  "props": {
    "tone": {
      "type": "union",
      "values": [
        "info",
        "success",
        "warning",
        "error"
      ],
      "optional": true,
      "description": "Semantic tone controlling icon and surface colors."
    },
    "title": {
      "type": "string",
      "optional": true,
      "description": "Alert heading text."
    },
    "description": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Supporting body copy."
    },
    "action": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Optional action slot rendered under the description (e.g. a tertiary Button)."
    },
    "showIcon": {
      "type": "boolean",
      "optional": true,
      "description": "Show the semantic tone icon. The icon is derived from `tone`; set false for a text-only banner."
    },
    "dismissible": {
      "type": "boolean",
      "optional": true,
      "description": "Shows a localized dismiss control when true."
    },
    "onDismiss": {
      "type": "() => void",
      "optional": true,
      "description": "Called when the user dismisses the banner."
    },
    "aria-live": {
      "type": "union",
      "values": [
        "polite",
        "assertive",
        "off"
      ],
      "optional": true,
      "description": "Live region politeness for assistive tech (an explicit value wins over the tone default)."
    },
    "focusOnMount": {
      "type": "boolean",
      "optional": true,
      "description": "Moves focus to the banner when it mounts, for form error summaries: keyboard\nand screen reader users land on the list of problems after a failed submit."
    }
  },
