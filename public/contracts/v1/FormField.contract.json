{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "FormField",
  "status": "stable",
  "description": "Fieldset/legend wrapper for a group of controls (radio sets, checkbox clusters, composite fields), with a group description and a group-level error. Individual controls own their own label, error, and helper text.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { FormField } from \"@digitaltableteur/react\";"
  },
  "props": {
    "legend": {
      "type": "string",
      "optional": false,
      "description": "Accessible name for the group of controls, rendered as a `<fieldset>`\n`<legend>`."
    },
    "children": {
      "type": "ReactNode",
      "optional": false,
      "description": "The grouped controls; each keeps its own label."
    },
    "groupDescription": {
      "type": "string",
      "optional": true,
      "description": "Helper text shown under the legend."
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Group-level error message shown after the controls."
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Appends a visual asterisk to the legend."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables every contained control via the fieldset."
    },
    "hideLegend": {
      "type": "boolean",
      "optional": true,
      "description": "Keeps the legend as the group's accessible name but hides it visually, for a group whose visible heading already names it."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Merged onto the fieldset."
    }
  },
