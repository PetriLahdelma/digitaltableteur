  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "SlideButton",
  "status": "stable",
  "description": "Pill call-to-action whose icon disc slides across the button on hover while the label shifts and the disc rolls a full turn.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { SlideButton } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Visible, i18n-resolved label. Names the destination, not the gesture."
    },
    "href": {
      "type": "string",
      "optional": false,
      "description": "Destination. Rendered as a real `<a>`, so it is focusable and keyboard-activated."
    },
    "icon": {
      "type": "string",
      "optional": true,
      "description": "Phosphor icon name for the sliding disc."
    },
    "iconSide": {
      "type": "union",
      "values": [
        "left",
        "right"
      ],
      "optional": true,
      "description": "Side the icon rests on before it slides across on hover. \"left\" starts at the\nleading edge and travels to the trailing edge; \"right\" is the mirror."
    }
  },
