  "specVersion": "1.0",
  "name": "SelectableCard",
  "status": "stable",
  "description": "A Card that is one selectable option; grouped into single (radio) or multiple (checkbox) sets via SelectableCardGroup.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { SelectableCard } from \"@digitaltableteur/react\";"
  },
  "props": {
    "value": {
      "type": "string",
      "optional": false,
      "description": "Submitted value / selection key."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Per-card disable; the choice stays visible."
    },
    "selected": {
      "type": "boolean",
      "optional": true,
      "description": "Standalone selected state when used outside a SelectableCardGroup."
    },
    "onSelectedChange": {
      "type": "(selected: boolean) => void",
      "optional": true,
      "description": "Standalone change handler when used outside a SelectableCardGroup."
    }
  },
