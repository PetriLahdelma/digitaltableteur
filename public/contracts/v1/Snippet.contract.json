{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Snippet",
  "status": "beta",
  "description": "A copyable shell command with a prompt that stays out of the copy.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Snippet } from \"@digitaltableteur/react\";"
  },
  "props": {
    "command": {
      "type": "string | readonly string[]",
      "optional": false,
      "description": "The command, or several commands shown one per line. Write the command\nonly: the prompt is chrome and never part of the text."
    },
    "prompt": {
      "type": "boolean",
      "optional": true,
      "description": "Show the `$` prompt before each command. Copy always leaves it out."
    },
    "theme": {
      "type": "union",
      "values": [
        "default",
        "inverted"
      ],
      "optional": true,
      "description": "`inverted` renders the snippet in the dark theme on any page, for\nterminal emphasis. In the high-contrast themes it follows the page so\ncontrast stays at the high-contrast level."
    },
    "copyable": {
      "type": "boolean",
      "optional": true,
      "description": "Show the copy button."
    },
    "copyLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the copy button."
    },
    "onCopy": {
      "type": "(text: string) => void",
      "optional": true,
      "description": "Called with the copied text (commands joined by newlines)."
    }
  },
