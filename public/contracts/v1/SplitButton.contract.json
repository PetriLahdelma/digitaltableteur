  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "SplitButton",
  "status": "stable",
  "description": "Primary action button paired with a dropdown toggle for related secondary actions, with collision-aware menu placement and optional nested submenus.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { SplitButton } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "React.ReactNode",
      "optional": false,
      "description": "Main label rendered on the primary segment"
    },
    "onPrimaryClick": {
      "type": "React.MouseEventHandler<HTMLButtonElement>",
      "optional": true,
      "description": "Primary action invoked when clicking the main segment"
    },
    "options": {
      "type": "SplitButtonOption[]",
      "optional": false,
      "description": "List of alternative actions shown in the dropdown"
    },
    "menuAlign": {
      "type": "union",
      "values": [
        "end",
        "start"
      ],
      "optional": true,
      "description": "Alignment of the dropdown menu along the toggle edge"
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disable both segments"
    },
    "toggleLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible label for the dropdown trigger"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional className forwarded to the outer wrapper"
    }
  },
