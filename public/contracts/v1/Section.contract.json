  "props": {
    "children": {
      "type": "ReactNode",
      "optional": false,
      "description": "Section content."
    },
    "spacing": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "none",
        "hero",
        "follow"
      ],
      "optional": true,
      "description": "Block padding scale."
    },
    "background": {
      "type": "union",
      "values": [
        "default",
        "muted",
        "accent",
        "inverse"
      ],
      "optional": true,
      "description": "Surface background token."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Section class names."
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Section id (anchor target)."
    },
    "spotlightTarget": {
      "type": "string",
      "optional": true,
      "description": "Optional stable selector target for host-app guided navigation."
    }
  },
