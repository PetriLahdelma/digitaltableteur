{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "PersonCard",
  "status": "beta",
  "description": "Profile card for a person with avatar, name, role, and links, plus a skeleton loading state for rosters.",
  "props": {
    "imageSrc": {
      "type": "string",
      "optional": false
    },
    "imageAlt": {
      "type": "string",
      "optional": false
    },
    "imageSrcSet": {
      "type": "string",
      "optional": true
    },
    "imageSizes": {
      "type": "string",
      "optional": true
    },
    "name": {
      "type": "string",
      "optional": false
    },
    "title": {
      "type": "string",
      "optional": false
    },
    "email": {
      "type": "string",
      "optional": false
    },
    "linkedinUrl": {
      "type": "string",
      "optional": true
    },
    "linkedinLabel": {
      "type": "string",
      "optional": true
    },
    "githubUrl": {
      "type": "string",
      "optional": true
    },
    "githubLabel": {
      "type": "string",
      "optional": true
    },
    "facebookUrl": {
      "type": "string",
      "optional": true
    },
    "facebookLabel": {
      "type": "string",
      "optional": true
    },
    "twitterUrl": {
      "type": "string",
      "optional": true
    },
    "twitterLabel": {
      "type": "string",
      "optional": true
    },
    "dribbbleUrl": {
      "type": "string",
      "optional": true
    },
    "dribbbleLabel": {
      "type": "string",
      "optional": true
    },
    "mediumUrl": {
      "type": "string",
      "optional": true
    },
    "mediumLabel": {
      "type": "string",
      "optional": true
    },
    "instagramUrl": {
      "type": "string",
      "optional": true
    },
    "instagramLabel": {
      "type": "string",
      "optional": true
    },
    "substackUrl": {
      "type": "string",
      "optional": true
    },
    "substackLabel": {
      "type": "string",
      "optional": true
    },
    "className": {
      "type": "string",
      "optional": true
    },
    "imageLoading": {
      "type": "union",
      "values": [
        "lazy",
        "eager"
      ],
      "optional": true
    },
    "imageDecoding": {
      "type": "union",
      "values": [
        "auto",
        "sync",
        "async"
      ],
      "optional": true
    },
    "loading": {
      "type": "boolean",
      "optional": true,
      "description": "Show skeleton placeholders while content is loading"
    }
  },
  "accessibility": {
    "criteria": [
      {
        "id": "axe-no-violations",
        "statement": "Required stories produce no axe violations at the configured severity.",
        "verification": "unverified",
        "wcag": [
          "2.5.8"
        ],
        "note": "No fresh a11y evidence for 'axe-no-violations'; run npm run test:stories:matrix:ci to capture."
      },
      {
        "id": "accessibility-tree",
        "statement": "The accessibility tree (role, name, state) matches the committed snapshot for every required story.",
        "verification": "unverified",
        "wcag": [
          "1.3.1",
          "4.1.2"
        ],
        "note": "No fresh a11y evidence for 'accessibility-tree'; run npm run test:stories:matrix:ci to capture."
      },
      {
        "id": "forced-colors-real-browser",
        "statement": "The component remains legible and operable under a real browser forced-colors: active pass.",
        "verification": "manual",
        "note": "Storybook forced-colors addon (simulated, not real browser HC).",
        "reviewedAt": "2026-05-28"
      },
      {
        "id": "human-a11y-review",
        "statement": "A human completed an end-to-end accessibility review of this component.",
        "verification": "manual",
        "note": "2026-05-28 — Promoted from alpha: Example + ForcedColors stories present; Storybook axe gate enabled.",
        "reviewedAt": "2026-05-28"
      }
    ]
  },
  "source": [
    "../../../nextjs-app/shared/components/PersonCard/PersonCard.module.css",
    "../../../nextjs-app/shared/components/PersonCard/PersonCard.tsx"
  ]
}
