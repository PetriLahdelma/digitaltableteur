{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Badge",
  "status": "stable",
  "description": "Compact status label with an orthogonal variant (visual weight) and tone (semantic colour), a size, and an optional icon.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Badge } from \"@digitaltableteur/react\";"
  },
  "props": {
    "children": {
      "type": "React.ReactNode",
      "optional": false
    },
    "variant": {
      "type": "union",
      "values": [
        "primary",
        "secondary"
      ],
      "optional": true,
      "description": "Visual weight."
    },
    "tone": {
      "type": "union",
      "values": [
        "info",
        "success",
        "warning",
        "error",
        "neutral"
      ],
      "optional": true,
      "description": "Semantic colour, orthogonal to `variant`."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xs"
      ],
      "optional": true,
      "description": "Size."
    },
    "className": {
      "type": "string",
      "optional": true
    },
    "removable": {
      "type": "boolean",
      "optional": true,
      "description": "Renders a dismiss control that removes the badge."
    },
    "onRemove": {
      "type": "() => void",
      "optional": true,
      "description": "Called after the badge is dismissed."
    },
    "icon": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Leading icon; a semantic icon is supplied automatically for non-neutral tones."
    },
    "dot": {
      "type": "boolean",
      "optional": true,
      "description": "Render a leading color-coded {@link StatusDot} (from `tone`) instead of the\nsemantic icon — e.g. lifecycle badges (alpha/beta/stable/deprecated). An\nexplicit `icon` still wins."
    },
    "square": {
      "type": "boolean",
      "optional": true,
      "description": "Square (non-pill) corners."
    },
    "role": {
      "type": "\"status\"",
      "optional": true,
      "description": "ARIA role. `\"status\"` makes dynamic updates announce via `aria-live=\"polite\"`\n(e.g. a live notification count). Omit for static decorative badges."
    }
  },
