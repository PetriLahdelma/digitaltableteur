{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ExpandableSection",
  "status": "stable",
  "description": "Collapsible content region with a trigger header. Lighter than `Accordion` (which manages a group of expandables) — used standalone for a single 'show more' or detail-disclosure section.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { ExpandableSection } from \"@digitaltableteur/react\";"
  },
  "props": {
    "collapsedLabel": {
      "type": "string",
      "optional": false,
      "description": "Trigger label when collapsed"
    },
    "expandedLabel": {
      "type": "string",
      "optional": true,
      "description": "Trigger label when expanded (optional, defaults to collapsedLabel)"
    },
    "defaultExpanded": {
      "type": "boolean",
      "optional": true,
      "description": "Whether the section is initially expanded"
    },
    "expanded": {
      "type": "boolean",
      "optional": true,
      "description": "Controlled expanded state"
    },
    "onExpandedChange": {
      "type": "(expanded: boolean) => void",
      "optional": true,
      "description": "Callback when expansion state changes"
    },
    "children": {
      "type": "ReactNode",
      "optional": false,
      "description": "Content to reveal"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional className for the container"
    }
  },
