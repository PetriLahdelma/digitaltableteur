{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "GridBlock",
  "status": "stable",
  "description": "Responsive grid of case-study content cells with column, gap, spacing, and background knobs, used across Work project pages.",
  "props": {
    "cells": {
      "type": "GridCell[]",
      "optional": false,
      "description": "Array of grid cells to render"
    },
    "columns": {
      "type": "1 | 2 | 3 | 4",
      "optional": true,
      "description": "Number of columns in the grid"
    },
    "gap": {
      "type": "union",
      "values": [
        "none",
        "small",
        "medium",
        "large"
      ],
      "optional": true,
      "description": "Gap between cells"
    },
    "backgroundColor": {
      "type": "union",
      "values": [
        "transparent",
        "light",
        "white"
      ],
      "optional": true,
      "description": "Background color variant"
    },
    "maxWidth": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "full"
      ],
      "optional": true,
      "description": "Maximum width constraint"
    },
    "spacing": {
      "type": "union",
      "values": [
        "default",
        "compact",
        "comfortable",
        "spacious"
      ],
      "optional": true,
      "description": "Spacing variant"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class"
    },
    "as": {
      "type": "union",
      "values": [
        "article",
        "div",
        "section"
      ],
      "optional": true,
      "description": "Semantic HTML element to use"
    }
  },
