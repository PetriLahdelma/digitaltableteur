{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ProjectMetaSection",
  "status": "alpha",
  "description": "Case study metadata (client, role, year).",
  "props": {
    "services": {
      "type": "string[]",
      "optional": false,
      "description": "List of services/skills"
    },
    "duration": {
      "type": "string",
      "optional": true,
      "description": "Project duration"
    },
    "tools": {
      "type": "ToolItem[]",
      "optional": true,
      "description": "Tools used"
    },
    "team": {
      "type": "TeamMember[]",
      "optional": true,
      "description": "Team members"
    },
    "client": {
      "type": "ClientInfo",
      "optional": true,
      "description": "Client info"
    },
    "overview": {
      "type": "ReactNode",
      "optional": true,
      "description": "Overview content"
    },
    "background": {
      "type": "union",
      "values": [
        "default",
        "muted",
        "accent"
      ],
      "optional": true,
      "description": "Background variant"
    },
    "maxWidth": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "full"
      ],
      "optional": true,
      "description": "Max width constraint for the section"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom className"
    },
    "donnyTarget": {
      "type": "string",
      "optional": true,
      "description": "Donny site action target id for the overview column"
    }
  },
  "accessibility": {
    "criteria": [
      {
        "id": "axe-no-violations",
        "statement": "Required stories produce no axe violations at the configured severity.",
        "verification": "unverified",
        "wcag": [
          "2.5.8"
        ],
        "note": "No fresh a11y evidence for 'axe-no-violations'; run npm run test:stories:matrix:ci to capture."
      },
      {
        "id": "accessibility-tree",
        "statement": "The accessibility tree (role, name, state) matches the committed snapshot for every required story.",
        "verification": "unverified",
        "wcag": [
          "1.3.1",
          "4.1.2"
        ],
        "note": "No fresh a11y evidence for 'accessibility-tree'; run npm run test:stories:matrix:ci to capture."
      },
      {
        "id": "forced-colors-real-browser",
        "statement": "The component remains legible and operable under a real browser forced-colors: active pass.",
        "verification": "unverified"
      }
    ]
  },
  "source": [
    "../../../nextjs-app/shared/patterns/ProjectMetaSection/ProjectMetaSection.module.css",
    "../../../nextjs-app/shared/patterns/ProjectMetaSection/ProjectMetaSection.tsx"
  ]
}
