{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "TaskList",
  "status": "alpha",
  "description": "Navigation rail for a long form done in parts, in any order and over several sessions: each part with its status, the open part with its steps.",
  "props": {
    "tasks": {
      "type": "TaskListTask[]",
      "optional": false,
      "description": "Tasks in order. Each has id, label, status, an optional hint and steps, and `unnumbered` to leave a closing task such as \"Check and submit\" without a number."
    },
    "label": {
      "type": "string",
      "optional": false,
      "description": "Accessible name of the navigation landmark, for example \"Intake parts\"."
    },
    "currentTaskId": {
      "type": "string",
      "optional": true,
      "description": "The task the person is working on; its steps are listed."
    },
    "currentStepId": {
      "type": "string",
      "optional": true,
      "description": "The step on screen, marked with aria-current=\"step\"."
    },
    "onSelect": {
      "type": "(taskId: string, stepId?: string) => void",
      "optional": true,
      "description": "Called when a task or step is chosen. Every task can be opened, so past\nsteps stay reachable (Baymard: people click step indicators to go back).\nTasks with status \"cannotStart\" are not interactive."
    },
    "statusLabels": {
      "type": "Partial<Record<TaskListStatus, string>>",
      "optional": true,
      "description": "Overrides the translated status words."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Merged onto the nav element."
    }
  },
