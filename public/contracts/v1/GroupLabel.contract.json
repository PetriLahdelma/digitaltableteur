  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "GroupLabel",
  "status": "stable",
  "description": "Fieldset/legend-shaped label used by `CheckboxGroup`, `FormGroup`, and other multi-control groupings. Provides the group's accessible name without forcing every child input to repeat it.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { GroupLabel } from \"@digitaltableteur/react\";"
  },
  "props": {
    "as": {
      "type": "union",
      "values": [
        "label",
        "legend"
      ],
      "optional": true,
      "description": "Element to render. legend (first child of a fieldset) names a group of controls; label names one control through htmlFor."
    },
    "htmlFor": {
      "type": "string",
      "optional": true,
      "description": "ID of the control the label names. Required for label; ignored for legend."
    },
    "tooltipText": {
      "type": "string",
      "optional": true,
      "description": "Optional browser tooltip; fallback when title is not set"
    },
    "required": {
      "type": "boolean",
      "optional": true,
      "description": "Shows the required asterisk."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Muted disabled styling."
    },
    "title": {
      "type": "string",
      "optional": true,
      "description": "Native title attribute override"
    }
  },
