{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Grid",
  "status": "stable",
  "description": "CSS grid layout primitive with scalar and token-breakpoint responsive columns and gaps.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Grid } from \"@digitaltableteur/react\";"
  },
  "props": {
    "children": {
      "type": "ReactNode",
      "optional": false,
      "description": "Grid cells (supports span on child props)."
    },
    "columns": {
      "type": "number | string",
      "optional": true,
      "description": "Column count or grid-template-columns string."
    },
    "tabletColumns": {
      "type": "number | string",
      "optional": true,
      "description": "Columns from the tablet breakpoint (768px) up. Numeric counts render as\n`repeat(n, minmax(0, 1fr))` so cells can shrink below content width."
    },
    "desktopColumns": {
      "type": "number | string",
      "optional": true,
      "description": "Columns from the desktop breakpoint (1024px) up. Falls back to\ntabletColumns, then columns."
    },
    "wideColumns": {
      "type": "number | string",
      "optional": true,
      "description": "Columns from the wide breakpoint (1440px) up. Falls back through\ndesktopColumns, tabletColumns, columns."
    },
    "ultraColumns": {
      "type": "number | string",
      "optional": true,
      "description": "Columns from the ultra breakpoint (1920px) up. Falls back through\nwideColumns, desktopColumns, tabletColumns, columns."
    },
    "rows": {
      "type": "number | string",
      "optional": true,
      "description": "Row count or grid-template-rows string."
    },
    "gap": {
      "type": "string",
      "optional": true,
      "description": "Grid gap."
    },
    "tabletGap": {
      "type": "string",
      "optional": true,
      "description": "Gap from the tablet breakpoint (768px) up."
    },
    "desktopGap": {
      "type": "string",
      "optional": true,
      "description": "Gap from the desktop breakpoint (1024px) up. Falls back to tabletGap,\nthen gap."
    },
    "wideGap": {
      "type": "string",
      "optional": true,
      "description": "Gap from the wide breakpoint (1440px) up. Falls back through desktopGap,\ntabletGap, gap."
    },
    "ultraGap": {
      "type": "string",
      "optional": true,
      "description": "Gap from the ultra breakpoint (1920px) up. Falls back through wideGap,\ndesktopGap, tabletGap, gap."
    },
    "rowGap": {
      "type": "string",
      "optional": true,
      "description": "Row gap override."
    },
    "colGap": {
      "type": "string",
      "optional": true,
      "description": "Column gap override."
    },
    "align": {
      "type": "union",
      "values": [
        "inherit",
        "center",
        "flex-start",
        "flex-end",
        "stretch",
        "baseline",
        "-moz-initial",
        "initial",
        "revert",
        "revert-layer",
        "unset",
        "end",
        "self-end",
        "self-start",
        "start",
        "anchor-center",
        "normal"
      ],
      "optional": true,
      "description": "align-items."
    },
    "justify": {
      "type": "union",
      "values": [
        "inherit",
        "center",
        "flex-start",
        "flex-end",
        "stretch",
        "baseline",
        "-moz-initial",
        "initial",
        "revert",
        "revert-layer",
        "unset",
        "end",
        "self-end",
        "self-start",
        "start",
        "anchor-center",
        "normal",
        "left",
        "legacy",
        "right"
      ],
      "optional": true,
      "description": "justify-items."
    },
    "style": {
      "type": "CSSProperties",
      "optional": true
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Grid class names."
    }
  },
