{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "TextInput",
  "status": "stable",
  "description": "Labeled text input with validation, helper text, and size tokens.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { TextInput } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": false,
      "description": "Visible field label; also feeds the input name"
    },
    "type": {
      "type": "union",
      "values": [
        "number",
        "search",
        "text",
        "tel",
        "email",
        "password",
        "date",
        "datetime-local",
        "time",
        "month",
        "week"
      ],
      "optional": false,
      "description": "Native HTML input type; tel formats, email validates, and date/time variants retain the browser's localized picker and ISO-compatible value"
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "S",
        "M",
        "L"
      ],
      "optional": true,
      "description": "Size variant for input"
    },
    "onValueChange": {
      "type": "(value: string | number) => void",
      "optional": true,
      "description": "Value change handler (recommended)"
    },
    "defaultValue": {
      "type": "string | number",
      "optional": true,
      "description": "Initial value for uncontrolled component"
    },
    "value": {
      "type": "string | number",
      "optional": true,
      "description": "Controlled value; an initial \"\" is treated as absent (uncontrolled), later changes always sync in"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Validation error message; renders above the helper line and sets aria-invalid"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Helper copy below the field"
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables the input. Declared explicitly (not just via the native attribute extension) so the agent-blocks prop extraction sees it."
    },
    "clearable": {
      "type": "boolean",
      "optional": true,
      "description": "Shows a labelled ×-button inside the field chrome while the field has a value; clearing returns focus to the input"
    },
    "onClear": {
      "type": "() => void",
      "optional": true,
      "description": "Called after the clear button empties the field (onValueChange also fires with \"\")"
    },
    "hideLabel": {
      "type": "boolean",
      "optional": true,
      "description": "Visually hides the label (kept in the accessibility tree); use where surrounding design carries the affordance"
    },
    "onChange": {
      "type": "(value: string | number) => void",
      "optional": true,
      "deprecated": {
        "reason": "Renamed to onValueChange; a development warning fires on use.",
        "replacement": "onValueChange"
      }
    }
  },
