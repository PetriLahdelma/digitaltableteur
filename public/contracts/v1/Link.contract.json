      "values": [
        "sm",
        "md",
        "lg",
        "inherit"
      ],
      "optional": true,
      "description": "Size."
    },
    "underline": {
      "type": "union",
      "values": [
        "always",
        "hover",
        "none"
      ],
      "optional": true,
      "description": "Wavy underline mode. \"always\" shows it permanently, \"hover\" reveals it\non hover and keyboard focus (nav lists like the site footer), \"none\"\nomits it entirely."
