{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Author",
  "status": "stable",
  "description": "Compact byline that attributes content to any author: name, avatar (URL or path), optional profile link, and a localized or custom byline prefix; the fuller biography treatment is AuthorBio.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Author } from \"@digitaltableteur/react\";"
  },
  "props": {
    "name": {
      "type": "string",
      "optional": false,
      "description": "Author name shown after the byline prefix; also names the avatar and\nfeeds its initials fallback."
    },
    "imageUrl": {
      "type": "string | { default: string } | StaticImageData",
      "optional": true,
      "description": "Avatar image source: a URL, an imported asset path, or static image data.\nWhen absent the avatar falls back to initials from `name`."
    },
    "size": {
      "type": "AvatarSize",
      "optional": true,
      "description": "Avatar size, exposed from the Avatar atom: token sizes `sm`/`md`/`lg`/`xl`\nare canonical; any CSS length is accepted."
    },
    "profileUrl": {
      "type": "string",
      "optional": true,
      "description": "Optional author profile URL; makes the byline text a link."
    },
    "bylinePrefix": {
      "type": "string",
      "optional": true,
      "description": "Byline prefix before the name. Defaults to the localized \"By\"\n(fi \"Kirjoittanut\", sv \"Av\"), matching the native dt-author element."
    }
  },
