{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "StoryBlock",
  "status": "stable",
  "description": "Narrative section for Work case studies with a subtitle and title, rich text, and images arranged by a selectable layout.",
  "props": {
    "subtitle": {
      "type": "string",
      "optional": true,
      "description": "Optional subtitle/category label"
    },
    "title": {
      "type": "string",
      "optional": false,
      "description": "Main title of the story section"
    },
    "content": {
      "type": "React.ReactNode[]",
      "optional": false,
      "description": "Body content as array of paragraphs or React nodes"
    },
    "images": {
      "type": "StoryImage | StoryImage[]",
      "optional": true,
      "description": "Optional image or images to display"
    },
    "imageLayout": {
      "type": "union",
      "values": [
        "single",
        "none",
        "grid"
      ],
      "optional": true,
      "description": "Image layout: \"single\" (1 col), \"grid\" (2 col), or \"none\""
    },
    "backgroundColor": {
      "type": "union",
      "values": [
        "transparent",
        "light",
        "white"
      ],
      "optional": true,
      "description": "Background color variant"
    },
    "maxWidth": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "xl",
        "full"
      ],
      "optional": true,
      "description": "Maximum width constraint"
    },
    "spacing": {
      "type": "union",
      "values": [
        "default",
        "compact",
        "comfortable",
        "spacious"
      ],
      "optional": true,
      "description": "Spacing variant"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Additional CSS class"
    },
    "as": {
      "type": "union",
      "values": [
        "article",
        "div",
        "section"
      ],
      "optional": true,
      "description": "Semantic HTML element to use"
    },
    "ariaLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible label for the section"
    },
    "headingLevel": {
      "type": "2 | 3 | 4",
      "optional": true,
      "description": "Heading level for the section title; visual size is unchanged. Pages whose outline places StoryBlock sections directly under the h1 should pass 2."
    }
  },
