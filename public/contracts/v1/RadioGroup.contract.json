{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "RadioGroup",
  "status": "beta",
  "description": "Accessible radio button group with legend and validation; with startLabel and endLabel it is a rating scale.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { RadioGroup } from \"@digitaltableteur/react\";"
  },
  "props": {
    "name": {
      "type": "string",
      "optional": true,
      "description": "Native form field name shared by the set; auto-generated when omitted"
    },
    "legend": {
      "type": "string",
      "optional": false,
      "description": "Group label rendered as the fieldset legend"
    },
    "options": {
      "type": "RadioGroupOption[]",
      "optional": false,
      "description": "Radio options; per-option disabled keeps the choice visible"
    },
    "value": {
      "type": "string",
      "optional": true,
      "description": "Controlled selected value; \"\" is treated as absent (uncontrolled)"
    },
    "defaultValue": {
      "type": "string",
      "optional": true,
      "description": "Initial value when uncontrolled"
    },
    "onValueChange": {
      "type": "(value: string) => void",
      "optional": true,
      "description": "Fired with the next value when selection changes"
    },
    "orientation": {
      "type": "union",
      "values": [
        "horizontal",
        "vertical"
      ],
      "optional": true,
      "description": "Stack direction."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "S",
        "M",
        "L"
      ],
      "optional": true,
      "description": "Radio control size."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables the whole set."
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message; announces via role=alert and sets aria-invalid"
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Helper copy below the group; always rendered, alongside error when both are set"
    },
    "startLabel": {
      "type": "string",
      "optional": true,
      "description": "Anchor shown before the first option, for rating scales (\"Serious\" in\nSerious 1 to 5 Playful). Announced paired with its option, not on its own."
    },
    "endLabel": {
      "type": "string",
      "optional": true,
      "description": "Anchor shown after the last option; pairs with startLabel"
    },
    "hideLegend": {
      "type": "boolean",
      "optional": true,
      "description": "Keeps the legend as the accessible name but hides it visually."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Merged onto the fieldset"
    }
  },
