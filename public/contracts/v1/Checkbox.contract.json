{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Checkbox",
  "status": "stable",
  "description": "Accessible checkbox with label, indeterminate, and size variants.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Checkbox } from \"@digitaltableteur/react\";"
  },
  "props": {
    "label": {
      "type": "string",
      "optional": true,
      "description": "Label text displayed next to the checkbox"
    },
    "showLabel": {
      "type": "boolean",
      "optional": true,
      "description": "Whether to show the label text."
    },
    "checked": {
      "type": "boolean",
      "optional": true,
      "description": "Checked state (controlled)."
    },
    "indeterminate": {
      "type": "boolean",
      "optional": true,
      "description": "Indeterminate (mixed) state."
    },
    "disabled": {
      "type": "boolean",
      "optional": true,
      "description": "Disables interaction and dims the control."
    },
    "defaultChecked": {
      "type": "boolean",
      "optional": true,
      "description": "Initial checked state for uncontrolled use."
    },
    "size": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg"
      ],
      "optional": true,
      "description": "Size."
    },
    "onCheckedChange": {
      "type": "(checked: boolean) => void",
      "optional": true,
      "description": "Called with the next checked value when toggled."
    },
    "id": {
      "type": "string",
      "optional": true,
      "description": "Custom ID for the checkbox element; auto-generated when omitted"
    },
    "error": {
      "type": "string",
      "optional": true,
      "description": "Error message under the control; sets aria-invalid and aria-describedby."
    },
    "helperText": {
      "type": "string",
      "optional": true,
      "description": "Supporting text under the control; always rendered, below `error` when both are set."
    }
  },
