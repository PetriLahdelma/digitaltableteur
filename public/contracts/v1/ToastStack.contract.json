{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ToastStack",
  "status": "stable",
  "description": "Docked stack of transient toasts: renders Toast children inline and owns the fixed placement, newest toast nearest the docked edge, so concurrent messages stay visible instead of replacing each other.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { ToastStack } from \"@digitaltableteur/react\";"
  },
  "props": {
    "toasts": {
      "type": "ToastStackItem[]",
      "optional": false,
      "description": "Toasts to display, oldest first; new toasts are appended by the caller."
    },
    "position": {
      "type": "union",
      "values": [
        "top-left",
        "top-center",
        "top-right",
        "bottom-left",
        "bottom-center",
        "bottom-right"
      ],
      "optional": true,
      "description": "Screen corner/edge the stack docks to."
    },
    "onDismiss": {
      "type": "(id: string) => void",
      "optional": true,
      "description": "Called with the toast id when its auto-dismiss timer fires."
    },
    "max": {
      "type": "number",
      "optional": true,
      "description": "Maximum toasts rendered at once; older ones wait (their timers only run\nwhile rendered), so bursts drain in order."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Optional classes on the stack wrapper."
    }
  },
