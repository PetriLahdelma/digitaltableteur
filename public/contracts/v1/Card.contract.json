{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "Card",
  "status": "stable",
  "description": "Quiet bordered card surface for discrete, self-contained content, including cards with actions composed into footer slots.",
  "package": {
    "name": "@digitaltableteur/react",
    "import": "import { Card } from \"@digitaltableteur/react\";"
  },
  "props": {
    "variant": {
      "type": "union",
      "values": [
        "default",
        "muted",
        "transparent"
      ],
      "optional": true,
      "description": "Background variant. All variants keep a transparent border so\nswitching never causes layout jitter.\n- default: surface background with a hairline border\n- muted: recessed light background, no visible border\n- transparent: no background, no border — grouping without weight"
    },
    "padding": {
      "type": "union",
      "values": [
        "sm",
        "md",
        "lg",
        "none"
      ],
      "optional": true,
      "description": "Internal padding step on the space scale (12/16/24px)"
    },
    "as": {
      "type": "union",
      "values": [
        "article",
        "div",
        "section",
        "aside",
        "li"
      ],
      "optional": true,
      "description": "Semantic element for the card surface"
    },
    "title": {
      "type": "string",
      "optional": true,
      "description": "Optional heading rendered at the top of the card"
    },
    "titleProps": {
      "type": "CardTitleProps",
      "optional": true,
      "description": "Heading configuration"
    },
    "description": {
      "type": "string",
      "optional": true,
      "description": "Optional supporting line under the title"
    },
    "descriptionProps": {
      "type": "CardDescriptionProps",
      "optional": true,
      "description": "Description configuration"
    },
    "headerStart": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Leading header region. Defaults to the `title` heading block when omitted."
    },
    "headerEnd": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Trailing header region (badge, metadata, menu). Canonical replacement for `extra`."
    },
    "extra": {
      "type": "React.ReactNode",
      "optional": true,
      "deprecated": {
        "reason": "Marked @deprecated in the TypeScript source."
      }
    },
    "footerStart": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Leading footer region — the special/destructive action, pinned left."
    },
    "footerEnd": {
      "type": "React.ReactNode",
      "optional": true,
      "description": "Trailing footer region — 1–2 action buttons, pinned right."
    },
    "link": {
      "type": "string",
      "optional": true,
      "description": "Makes the whole card one link to this href"
    },
    "linkLabel": {
      "type": "string",
      "optional": true,
      "description": "Accessible name for the link when title alone is ambiguous"
    },
    "loading": {
      "type": "boolean",
      "optional": true,
      "description": "Skeleton loading state (role=status, aria-busy)"
    },
    "children": {
      "type": "React.ReactNode",
      "optional": true
    }
  },
  "rules": [
    {
      "id": "card-link-with-footer",
      "when": {
        "link": {
          "present": true
        }
      },
      "forbid": [
        "footerStart",
        "footerEnd"
      ],
      "reason": "`link` is ignored when `footerStart`/`footerEnd` are set: a stretched anchor cannot wrap interactive footer controls. Use a plain card with buttons instead.",
      "severity": "error",
      "evidence": "Card.tsx development warning (linkSuppressed)"
    }
  ],
