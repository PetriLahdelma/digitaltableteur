{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ConfirmPopover",
  "status": "alpha",
  "description": "Asks \"are you sure?\" next to the control that triggered it: a non-modal alertdialog anchored to the trigger with a question, an optional consequence and Cancel / confirm buttons.",
  "props": {
    "children": {
      "type": "React.ReactElement",
      "optional": false,
      "description": "The control that opens the confirmation, usually a Button. It keeps its own label and styling."
    },
    "title": {
      "type": "string",
      "optional": false,
      "description": "The question, for example \"Clear the answers in this section?\". Names the dialog. With choices, it asks which one, for example \"What do you want to clear?\"."
    },
    "description": {
      "type": "string",
      "optional": true,
      "description": "What happens if the person confirms; describes the dialog."
    },
    "confirmLabel": {
      "type": "string",
      "optional": true,
      "description": "Label of the confirming button; repeat the action, for example \"Clear answers\". Not used with choices, where each choice has its own."
    },
    "choices": {
      "type": "ConfirmPopoverChoice[]",
      "optional": true,
      "description": "Several actions to pick from first; picking one asks \"are you sure?\" with that choice's question and labels."
    },
    "cancelLabel": {
      "type": "string",
      "optional": true,
      "description": "Label of the cancelling button."
    },
    "tone": {
      "type": "union",
      "values": [
        "error",
        "neutral"
      ],
      "optional": true,
      "description": "\"error\" for actions that remove or destroy something."
    },
    "onConfirm": {
      "type": "(choiceId?: string) => void",
      "optional": false,
      "description": "Called when the person confirms, with the picked choice's id when there are choices; the popover then closes."
    },
    "onOpenChange": {
      "type": "(open: boolean) => void",
      "optional": true,
      "description": "Called when the popover opens or closes, whichever way."
    },
    "side": {
      "type": "union",
      "values": [
        "top",
        "right",
        "bottom",
        "left"
      ],
      "optional": true,
      "description": "Preferred side of the trigger; flips when out of room."
    },
    "align": {
      "type": "union",
      "values": [
        "center",
        "start",
        "end"
      ],
      "optional": true,
      "description": "Alignment along that side. Not used with arrow, which always centres the popover on the trigger."
    },
    "arrow": {
      "type": "boolean",
      "optional": true,
      "description": "Draws a pointer from the middle of the popover's edge to the trigger, like a speech bubble; side picks the edge (top, right, bottom or left) and the popover centres on the trigger. Off by default."
    },
    "shortcut": {
      "type": "string[]",
      "optional": true,
      "description": "Keys that run the action without the popover, one entry per key; shown under the description as keycaps joined by plus signs."
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Extra class on the popover surface."
    }
  },
  "rules": [
    {
      "id": "confirmpopover-arrow-centres",
      "when": {
        "arrow": {
          "present": true
        },
        "align": {
          "oneOf": [
            "start",
            "end"
          ]
        }
      },
      "forbid": [
        "align"
      ],
      "reason": "A speech-bubble pointer sits in the middle of the popover's edge, so the popover centres on the trigger and align is ignored. Drop align, e.g. <ConfirmPopover side=\"left\" arrow />.",
      "severity": "warning",
      "evidence": "ConfirmPopover.tsx development warning (arrow && align !== \"center\")"
    }
  ],
