{
  "$schema": "https://www.digitaltableteur.com/schemas/contract-spec/1.0/contract.schema.json",
  "specVersion": "1.0",
  "name": "ProjectCard",
  "status": "stable",
  "description": "Basic portfolio project card for the work grid: a clickable thumbnail with title, optional category eyebrow and up to three tags.",
  "props": {
    "title": {
      "type": "string",
      "optional": false,
      "description": "Project title"
    },
    "slug": {
      "type": "string",
      "optional": false,
      "description": "URL slug for project detail page"
    },
    "thumbnail": {
      "type": "string",
      "optional": false,
      "description": "Thumbnail image URL"
    },
    "category": {
      "type": "string",
      "optional": true,
      "description": "Project category"
    },
    "tags": {
      "type": "string[]",
      "optional": true,
      "description": "Project tags"
    },
    "aspectRatio": {
      "type": "union",
      "values": [
        "video",
        "square",
        "portrait",
        "landscape"
      ],
      "optional": true,
      "description": "Image aspect ratio"
    },
    "titlePosition": {
      "type": "union",
      "values": [
        "overlay",
        "below"
      ],
      "optional": true,
      "description": "Title overlay position"
    },
    "comingSoon": {
      "type": "boolean",
      "optional": true,
      "description": "Render as a non-interactive teaser with a \"coming soon\" badge over the media"
    },
    "comingSoonLabel": {
      "type": "string",
      "optional": true,
      "description": "Visible badge label for the coming-soon overlay (pass a translated string)"
    },
    "className": {
      "type": "string",
      "optional": true,
      "description": "Custom className"
    }
  },
