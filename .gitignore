# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.js

# testing
/coverage

# production
/build
/dist
nextjs-app/shared/foundations/dist/

# misc
.DS_Store
.env
.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

npm-debug.log*
yarn-debug.log*
yarn-error.log*

*storybook.log
storybook-static

# Local agent worktrees (never commit)
.claude/worktrees/

# MCP config
mcp.json
.vercel
.env*.local

# Akaunting
akaunting/.env
akaunting/.env.local
akaunting/*.sql
akaunting/*.sql.gz
akaunting/backups/
akaunting/logs/

# Next.js build output
.next/
.next/cache/

# OMX local runtime state
.omx/

# Prevent generated static sitemap from shadowing Next.js `app/sitemap.ts`
public/sitemap.xml
nextjs-app/public/sitemap.xml

# Lighthouse CI
.lighthouseci/
lighthouse-*.html
lighthouse-*.json

# IDE Local History (VS Code)
.history/

# Backup files
*.bkup
*.tar.gz

# TypeScript build info
*.tsbuildinfo

# Ad-hoc design-system / matrix CI run logs (kept out of VCS)
.dt-*.log

# Browser/MCP scratch state and brainstorming session output
.playwright-mcp/
.superpowers/
*.pid

# Playwright test outputs (snapshots live alongside their tests, not here)
playwright-report/
test-results/

# Visual-diff transient outputs — baselines are tracked, actual/diff are not
public/visual-diff/*-actual.png
public/visual-diff/*-diff.png
public/visual-diff/report.json

# Stray top-level build/debug logs
/build.log
/vite-debug.log

# Personal / tax documents — never commit
**/Verokortti*.pdf
