{
  "homepage": "https://digitaltableteur.com",
  "name": "digitaltableteur",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@ai-sdk/gateway": "^2.0.7",
    "@ai-sdk/mcp": "^0.0.7",
    "@ai-sdk/openai": "^2.0.64",
    "@ai-sdk/react": "^2.0.89",
    "@emailjs/browser": "^4.4.1",
    "@emotion/is-prop-valid": "^1.3.1",
    "@sentry/react": "^10.23.0",
    "@sentry/vite-plugin": "^4.6.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "ai": "^5.0.86",
    "chart.js": "^4.4.9",
    "dotenv": "^16.6.1",
    "i18next": "^25.6.1",
    "jsdom": "^26.1.0",
    "leaflet": "^1.9.4",
    "mongodb": "^6.5.0",
    "motion": "^12.23.24",
    "node-fetch": "^3.3.2",
    "openai": "5.8.2",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-i18next": "^15.7.4",
    "react-icons": "^4.10.1",
    "react-leaflet": "^4.2.1",
    "react-markdown": "^9.0.3",
    "react-router-dom": "^7.9.5",
    "react-stack-grid": "^0.7.1",
    "remark-gfm": "^4.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "web-vitals": "^2.1.4",
    "xml2js": "^0.6.2"
  },
  "scripts": {
    "predeploy": "npm run build && cp CNAME dist/CNAME",
    "deploy": "gh-pages -d dist --dotfiles",
    "deploy:with-storybook": "./scripts/deploy-local.sh",
    "deploy:emergency": "./scripts/emergency-deploy.sh",
    "cache-bust": "./scripts/cache-bust.sh",
    "dev": "vite",
    "start": "vite",
    "prebuild": "npm run copy-leaflet-icons",
    "build": "vite build",
    "copy-leaflet-icons": "cp node_modules/leaflet/dist/images/marker-*.png public/",
    "test": "vitest run --config vitest.config.mts",
    "test:a11y:pages": "vitest run src/__tests__/accessibility-pages.test.tsx",
    "test:a11y:stories": "vitest run src/__tests__/accessibility-stories.test.tsx",
    "test:a11y": "npm run test:a11y:pages && npm run test:a11y:stories",
    "storybook": "NODE_ENV=development storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "visual:ci": "node scripts/run-visual-tests.mjs --ci",
    "build:test-metrics": "node scripts/build-test-metrics.mjs",
    "lint": "npx prettier \"src/**/*.{ts,tsx,css}\" --check && npx eslint -c .eslintrc.cjs \"src/**/*.{ts,tsx}\" && npx stylelint \"src/**/*.{css,tsx,html}\"",
    "fetch-figma": "node scripts/fetch-figma.js",
    "generate:sitemap": "node scripts/generate-sitemap.js",
    "generate:llms": "node scripts/generate-llms-txt.js",
    "generate:alt-text": "node scripts/generate-alt-text.js",
    "generate:sentry-summary": "node scripts/generate-sentry-summary.mjs --unresolved --environment=production",
    "sentry:summary:auto": "node scripts/sentry-automation.mjs --unresolved --environment=production",
    "sentry:summary:stub": "node scripts/sentry-automation.mjs --force-stub --unresolved",
    "ts:mcp:status": "node scripts/ts-mcp-automation.mjs",
    "ts:mcp:status:stub": "node scripts/ts-mcp-automation.mjs --force-stub",
    "postbuild": "npm run sentry:summary:auto || npm run sentry:summary:stub"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:storybook/recommended"
    ],
    "settings": {
      "react": {
        "version": "detect"
      }
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=20.19.0 <21"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.0.5",
    "@storybook/addon-docs": "^10.0.5",
    "@storybook/builder-vite": "^10.0.5",
    "@storybook/cli": "^10.0.5",
    "@storybook/react-vite": "^10.0.5",
    "@storybook/test-runner": "^0.24.1",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20.19.24",
    "@types/react-icons": "^2.2.7",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/ui": "^3.2.4",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-prettier": "^5.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^10.0.2",
    "gh-pages": "^6.3.0",
    "pixelmatch": "^5.3.0",
    "playwright": "^1.49.1",
    "pngjs": "^6.0.0",
    "postcss-html": "^1.8.0",
    "postcss-jsx": "^0.36.4",
    "prettier": "^3.6.2",
    "prop-types": "^15.8.1",
    "stylelint": "^16.20.0",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-declaration-strict-value": "^1.10.11",
    "stylelint-order": "^7.0.0",
    "typescript-language-server": "^5.1.1",
    "vite-plugin-static-copy": "^3.1.0",
    "vitest": "^3.2.4"
  }
}
