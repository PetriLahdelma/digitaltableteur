{
  "name": "nextjs-app",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-banner.mjs && next dev -p 3001",
    "dev:clean": "rm -rf .next && npm run dev",
    "dev:reset": "lsof -ti :3001 | xargs kill -9 2>/dev/null; rm -rf .next && npm run dev",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "postinstall": "node scripts/install-playwright-browsers.mjs",
    "postbuild": "node scripts/ensure-no-static-sitemap.mjs",
    "predev": "node scripts/ensure-dev-next-cache.mjs && npm run generate:blog && node scripts/generate-codeblock-fixtures.mjs && node scripts/ensure-no-static-sitemap.mjs",
    "prebuild": "npm run generate:blog && node scripts/generate-codeblock-fixtures.mjs && node scripts/ensure-no-static-sitemap.mjs",
    "generate:blog": "node scripts/generate-blog-manifest.mjs && tsx scripts/update-post-metadata.ts",
    "vercel-build": "npm run build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint-banner.mjs",
    "lint:css": "stylelint \"**/*.css\" \"**/*.module.css\"",
    "lint:all": "npm run lint && npm run lint:css",
    "test": "vitest run",
    "test:ci": "SKIP_STORYBOOK_TESTS=1 vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:test-metrics": "npm --prefix vite-app run build:test-metrics",
    "test:visual": "node scripts/run-visual-tests.mjs",
    "test:visual:update": "npm run test:visual -- --updateSnapshot",
    "test:a11y": "npm test",
    "test:a11y:pages": "playwright test --project=a11y",
    "test:a11y:pages:report": "playwright test --project=a11y --reporter=html && npx playwright show-report",
    "lighthouse:a11y": "lighthouse http://localhost:3000 --only-categories=accessibility --output html --output-path ./lighthouse-a11y-report.html --view",
    "lighthouse:full": "lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html --view",
    "lighthouse:a11y:ci": "lighthouse http://localhost:3000 --only-categories=accessibility --output json --output-path ./lighthouse-a11y-report.json",
    "lighthouse:ci": "lhci autorun",
    "lighthouse:ci:collect": "lhci collect",
    "lighthouse:ci:assert": "lhci assert",
    "storybook": "BROWSER=none storybook dev -p 6010",
    "storybook:build": "storybook build -o storybook-static",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit:fix": "npm audit fix",
    "security:scan": "echo 'Run full security scan in GitHub Actions: .github/workflows/security-scanning.yml'",
    "security:test-auth": "curl -X POST http://localhost:3000/api/download-cv -H 'Content-Type: application/json' -d '{\"password\":\"test\"}'",
    "gdpr:cleanup": "npx tsx scripts/cleanup-old-data.ts",
    "gdpr:cleanup:dry": "DRY_RUN=true npx tsx scripts/cleanup-old-data.ts",
    "gdpr:test-deletion": "curl -X POST http://localhost:3000/api/gdpr/delete-data -H 'Content-Type: application/json' -d '{\"email\":\"test@example.com\"}'",
    "gdpr:check-data": "curl 'http://localhost:3000/api/gdpr/delete-data?email=test@example.com'",
    "sanity:dev": "cd digitaltableteur-blog && npm run dev",
    "sanity:backup": "bash scripts/sanity-migration/backup-production.sh",
    "sanity:backup-blog": "bash scripts/sanity-migration/backup-blog-dataset.sh",
    "sanity:parse-posts": "node scripts/sanity-migration/parsePosts.js",
    "sanity:convert": "node scripts/sanity-migration/convertToSanityFormat.js",
    "sanity:cleanup-legacy": "node scripts/sanity-migration/cleanupLegacyDocuments.js",
    "sanity:upload": "node scripts/sanity-migration/batchUpload.js",
    "sanity:sync-from-remote": "node scripts/sanity-migration/syncFromSanity.js",
    "sanity:publish": "bash scripts/publish-from-sanity.sh",
    "sanity:publish-single": "bash scripts/publish-from-sanity.sh",
    "validate:mdx": "node scripts/validate-mdx-html.cjs",
    "validate:translations": "node scripts/validate-translations.mjs",
    "verify:pages": "node scripts/verify-pages-render.mjs",
    "akaunting:install": "cd akaunting && ./setup.sh",
    "akaunting:start": "cd akaunting && docker compose up -d",
    "akaunting:stop": "cd akaunting && docker compose stop",
    "akaunting:restart": "cd akaunting && docker compose restart",
    "akaunting:logs": "cd akaunting && docker compose logs -f",
    "akaunting:mcp:setup": "node scripts/akaunting-mcp-setup.mjs",
    "akaunting:mcp:test": "node scripts/test-akaunting-mcp.mjs",
    "akaunting:tools:test": "node lib/akaunting-tools.mjs test",
    "akaunting:dashboard": "node lib/akaunting-tools.mjs dashboard",
    "akaunting:finnish-setup": "node scripts/akaunting-finnish-setup.mjs",
    "docker:mcp:test": "node scripts/test-docker-mcp.mjs",
    "test:security": "node tests/security/run-security-tests.mjs",
    "test:security:verbose": "node tests/security/run-security-tests.mjs --verbose",
    "test:security:category": "node tests/security/run-security-tests.mjs --category",
    "precommit:guard": "bash scripts/precommit-guard.sh",
    "pseo:generate": "npx tsx scripts/pseo/generate-pseo-copy.ts --only-missing",
    "validate:components": "tsx scripts/design-system/validate-components.ts",
    "audit:catalog": "node scripts/design-system/audit-catalog-coverage.mjs",
    "new-component": "node scripts/design-system/scaffold-component.mjs",
    "bootstrap:contracts": "node scripts/design-system/bootstrap-contracts.mjs",
    "elevate:storybook": "python3 scripts/design-system/elevate_storybook_beta.py",
    "bootstrap:breadth": "node scripts/design-system/bootstrap-breadth.mjs",
    "migrate:contracts:v2": "node scripts/design-system/migrate-contracts-v2.mjs",
    "build:tokens": "node scripts/design-system/extract-variables-catalog.mjs && node scripts/design-system/export-dtcg-from-css.mjs && node scripts/design-system/build-tokens.mjs && node scripts/design-system/sync-tailwind-theme.mjs && node scripts/design-system/generate-agent-manifest.mjs",
