    "test:stories:i18n": "node scripts/design-system/run-i18n-visual-matrix.mjs",
    "parity:audit": "node scripts/design-system/parity-audit.mjs",
    "parity:verify": "npm run parity:audit && npm run check:contrast && npm run build:tokens && npm run validate:components && npm run typecheck",
    "storybook:wait": "node scripts/wait-for-storybook.mjs",
    "apply:storybook-tiers": "node scripts/design-system/apply-storybook-tiers.mjs",
    "test:stories:smoke": "node scripts/design-system/smoke-stories.mjs",
    "build:zod-catalog": "tsx scripts/design-system/build-zod-catalog.ts",
    "agent:eval": "node scripts/design-system/agent-eval/run.mjs",
    "check:generated": "node scripts/design-system/check-generated.mjs",
    "check:figma": "node scripts/design-system/figma-link.mjs",
    "sync:figma-contracts": "node scripts/design-system/sync-figma-contract-urls.mjs",
    "audit:consumers": "node scripts/design-system/audit-consumers.mjs",
    "promote:stable-atoms": "node scripts/design-system/promote-stable-atoms.mjs",
    "check:bundle-budgets": "node scripts/design-system/check-bundle-budgets.mjs"
