    "test:visual:ci": "node scripts/run-visual-tests.mjs",
    "test:stories:ci:runner": "concurrently -k -s first -n SB,TEST \"npm run storybook -- --ci --no-open --quiet\" \"npm run storybook:wait && DT_REQUIRE_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --maxWorkers=2 --testTimeout=60000\"",
    "test:stories:matrix:ci": "node scripts/design-system/tag-beta-matrix-stories.mjs && concurrently -k -s first -n SB,TEST \"npm run storybook -- --ci --no-open --quiet\" \"npm run storybook:wait && DT_THEME=light DT_REQUIRE_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --includeTags beta-matrix --maxWorkers=2 --testTimeout=60000 && DT_THEME=dark DT_REQUIRE_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --includeTags beta-matrix --maxWorkers=2 --testTimeout=60000\"",
    "test:stories:hc": "npm run test:stories:hc:ci",
    "test:stories:hc:ci": "node scripts/design-system/tag-beta-matrix-stories.mjs && concurrently -k -s first -n SB,TEST \"npm run storybook -- --ci --no-open --quiet\" \"npm run storybook:wait && DT_FORCED_COLORS=active DT_REQUIRE_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --includeTags beta-matrix --maxWorkers=2 --testTimeout=60000\"",
    "a11y-snapshot:bootstrap:hc:attached": "node scripts/design-system/tag-beta-matrix-stories.mjs && npm run storybook:wait && DT_FORCED_COLORS=active DT_BOOTSTRAP_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --includeTags beta-matrix --maxWorkers=1 --testTimeout=120000",
    "a11y-snapshot:update:hc": "node scripts/design-system/tag-beta-matrix-stories.mjs && concurrently -k -s first -n SB,TEST \"npm run storybook -- --ci --no-open --quiet\" \"npm run storybook:wait && DT_FORCED_COLORS=active DT_UPDATE_A11Y_SNAPSHOTS=1 DT_REQUIRE_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --includeTags beta-matrix --maxWorkers=2 --testTimeout=60000\"",
    "test:stories:hc:attached": "node scripts/design-system/tag-beta-matrix-stories.mjs && npm run storybook:wait && DT_FORCED_COLORS=active DT_REQUIRE_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --includeTags beta-matrix --maxWorkers=2 --testTimeout=60000",
    "a11y-snapshot:update": "node scripts/design-system/tag-beta-matrix-stories.mjs && concurrently -k -s first -n SB,TEST \"npm run storybook -- --ci --no-open --quiet\" \"npm run storybook:wait && DT_UPDATE_A11Y_SNAPSHOTS=1 DT_REQUIRE_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --includeTags beta-matrix --maxWorkers=2 --testTimeout=60000\"",
    "a11y-snapshot:bootstrap": "node scripts/design-system/tag-beta-stories.mjs && node scripts/design-system/tag-beta-matrix-stories.mjs && node scripts/design-system/relocate-a11y-snapshots.mjs && concurrently -k -s first -n SB,TEST \"npm run storybook -- --ci --no-open --quiet\" \"npm run storybook:wait && DT_BOOTSTRAP_A11Y_SNAPSHOTS=1 test-storybook --url http://127.0.0.1:6010 --includeTags beta-matrix --maxWorkers=1 --testTimeout=120000\"",
