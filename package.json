    "storybook:reset": "PORT=6010 node scripts/ensure-stale-dev-killed.mjs; lsof -ti :6010 | xargs kill -9 2>/dev/null; rm -rf node_modules/.cache/storybook node_modules/.vite && npm run storybook",
