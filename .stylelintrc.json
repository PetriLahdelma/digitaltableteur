{
  "extends": [
    "stylelint-config-standard"
  ],
  "plugins": [
    "stylelint-order",
    "stylelint-declaration-strict-value"
  ],
  "ignoreFiles": [
    ".claude/**",
    "src-legacy-vite-DO-NOT-USE/**/*.css",
    "vite-app/**/*.css",
    "nextjs-app/src/**/*.css",
    "nextjs-app/shared/foundations/dist/**/*.css",
    "coverage/**/*.css",
    "node_modules/**",
    "dist/**",
    "build/**",
    "storybook-static/**",
    "app/tailwind.css"
  ],
  "overrides": [
    {
      "files": [
        "**/*.html"
      ],
      "customSyntax": "postcss-html"
    },
    {
      "files": [
        "**/*.tsx"
      ],
      "customSyntax": "postcss-jsx",
      "rules": {
        "declaration-property-value-no-unknown": null,
        "color-function-notation": null
      }
    },
    {
      "files": [
        "**/PhoneInput/*.css"
      ],
      "rules": {
        "selector-class-pattern": null,
        "selector-pseudo-class-no-unknown": null,
        "property-disallowed-list": null
      }
    },
    {
      "files": [
        "**/globals.css",
        "**/tailwind.css"
      ],
      "rules": {
        "selector-class-pattern": null,
        "at-rule-no-unknown": [
          true,
          {
            "ignoreAtRules": [
              "theme",
              "custom-variant",
              "layer",
              "apply",
              "tailwind",
              "config",
              "plugin",
              "utility",
              "variant",
              "source"
            ]
          }
        ],
        "import-notation": null,
        "property-no-deprecated": null,
        "property-disallowed-list": null,
        "media-feature-range-notation": null
      }
    },
    {
      "files": [
        "**/*.module.css"
      ],
      "rules": {
        "selector-pseudo-class-no-unknown": [
          true,
          {
            "ignorePseudoClasses": [
              "global",
              "local",
              "export"
            ]
          }
        ],
        "property-no-unknown": [
          true,
          {
            "ignoreProperties": [
              "composes"
            ]
          }
        ],
        "selector-class-pattern": null
      }
    },
    {
      "files": [
        "nextjs-app/shared/components/**/*.module.css"
      ],
      "rules": {
        "scale-unlimited/declaration-strict-value": [
          [
            "/color/",
            "fill",
            "stroke"
          ],
          {
            "ignoreKeywords": [
              "currentColor",
              "currentcolor",
              "inherit",
              "transparent",
              "initial",
              "unset",
              "none",
              "Canvas",
              "CanvasText",
              "Highlight",
              "HighlightText",
              "ButtonText",
              "ButtonFace",
              "LinkText",
              "GrayText"
            ],
            "ignoreValues": [
              "/^rgb/",
              "/^linear-gradient/",
              "/^radial-gradient/",
              "/^color-mix/"
            ],
            "severity": "error",
            "message": "Color values in shared components must come from design tokens (variables.css) or component-local custom properties. Shorthand props (background, border) are gated by scripts/design-system/semantic-token-codemod.mjs --check."
          }
        ]
      }
    },
    {
      "files": [
        "nextjs-app/shared/components/pages/**/*.module.css"
      ],
      "rules": {
        "scale-unlimited/declaration-strict-value": [
          [
            "/color/",
            "fill",
            "stroke"
          ],
          {
            "ignoreKeywords": [
              "currentColor",
              "inherit",
              "transparent"
            ],
            "severity": "warning",
            "message": "Work case studies may use deliberate per-project palettes; tokens still preferred."
          }
        ]
      }
    }
  ],
  "rules": {
    "declaration-property-value-no-unknown": null,
    "selector-class-pattern": [
      "^[a-zA-Z][a-zA-Z0-9-]*$",
      {
        "severity": "warning",
        "message": "Prefer camelCase. Pre-existing kebab-case utility classes are allowed pending refactor."
      }
    ],
    "keyframes-name-pattern": [
      "^[a-zA-Z][a-zA-Z0-9-]*$",
      {
        "severity": "warning",
        "message": "Prefer camelCase. Pre-existing kebab-case keyframes are allowed pending refactor."
      }
    ],
    "no-descending-specificity": [
      true,
      {
        "severity": "warning"
      }
    ],
    "order/properties-order": [
      [
        "composes",
        "display",
        "position",
        "inset",
        "inset-block",
        "inset-inline",
        "top",
        "right",
        "bottom",
        "left",
        "z-index",
        "margin",
        "margin-block",
        "margin-block-start",
        "margin-block-end",
        "margin-inline",
        "margin-inline-start",
        "margin-inline-end",
        "padding",
        "padding-block",
        "padding-block-start",
        "padding-block-end",
        "padding-inline",
        "padding-inline-start",
        "padding-inline-end",
        "box-sizing",
        "block-size",
        "inline-size",
        "min-block-size",
        "max-block-size",
        "min-inline-size",
        "max-inline-size",
        "width",
        "min-width",
        "max-width",
        "height",
        "min-height",
        "max-height",
        "flex",
        "flex-grow",
        "flex-shrink",
        "flex-basis",
        "flex-direction",
        "flex-wrap",
        "grid-template-columns",
        "grid-template-rows",
        "grid-auto-flow",
        "order",
        "justify-content",
        "justify-items",
        "align-content",
        "align-items",
        "align-self",
        "place-items",
        "gap",
        "border",
        "border-width",
        "border-style",
        "border-color",
        "border-block",
        "border-block-start",
        "border-block-end",
        "border-inline",
        "border-inline-start",
        "border-inline-end",
        "border-radius",
        "outline",
        "outline-offset",
        "background",
        "background-color",
        "background-image",
        "background-position",
        "background-size",
        "background-repeat",
        "backdrop-filter",
        "box-shadow",
        "font",
        "font-family",
        "font-size",
        "font-weight",
        "line-height",
        "letter-spacing",
        "text-align",
        "text-transform",
        "text-decoration",
        "text-overflow",
        "white-space",
        "overflow-wrap",
        "word-break",
        "hyphens",
        "color",
        "cursor",
        "pointer-events",
        "transition",
        "transition-property",
        "transition-duration",
        "transition-timing-function",
        "animation",
        "animation-name",
        "animation-duration",
        "animation-timing-function",
        "transform",
        "opacity"
      ],
      {
        "unspecified": "bottomAlphabetical",
        "severity": "warning"
      }
    ],
    "scale-unlimited/declaration-strict-value": [
      [
        "/color/",
        "fill",
        "stroke"
      ],
      {
        "ignoreKeywords": [
          "currentColor",
          "inherit",
          "transparent"
        ],
        "severity": "warning"
      }
    ],
    "declaration-block-no-duplicate-properties": [
      true,
      {
        "severity": "error"
      }
    ],
    "declaration-block-no-shorthand-property-overrides": [
      true,
      {
        "severity": "error"
      }
    ],
    "max-nesting-depth": [
      3,
      {
        "severity": "warning"
      }
    ],
    "selector-max-id": [
      0,
      {
        "severity": "error"
      }
    ],
    "selector-max-universal": [
      1,
      {
        "severity": "warning"
      }
    ],
    "selector-max-specificity": [
      "0,4,0",
      {
        "severity": "warning"
      }
    ],
    "no-unknown-animations": [
      true,
      {
        "severity": "error"
      }
    ],
    "declaration-no-important": [
      true,
      {
        "severity": "warning"
      }
    ],
    "property-disallowed-list": [
      [
        "margin-left",
        "margin-right",
        "padding-left",
        "padding-right",
        "border-left",
        "border-right"
      ],
      {
        "severity": "warning"
      }
    ],
    "rule-empty-line-before": [
      "always-multi-line",
      {
        "ignore": [
          "first-nested"
        ],
        "severity": "warning"
      }
    ]
  }
}
